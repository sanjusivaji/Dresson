<%- include('../partial/user/header') %>

<div class="flex flex-col md:flex-row gap-6 w-full">
    <%- include('userSidebar') %>
    <div class="flex-grow flex flex-col lg:flex-row gap-8 bg-white p-6 md:p-8 rounded-sm border border-gray-200 shadow-sm">
        <div class="space-y-8 flex-grow max-w-2xl">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900">Profile</h2>

            <div class="space-y-4">
                <h3 class="text-base font-bold text-gray-400">Change Email</h3>
                
                <div class="space-y-3 max-w-md">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Name</label>
                        <input type="text" readonly value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50 border-none text-xs font-semibold px-3 py-2.5 rounded-sm text-gray-500 focus:outline-none cursor-not-allowed">
                    </div>
                    
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Email Address</label>
                        <input type="email" readonly value="<%= user.email %>" class="w-full bg-gray-50 border-none text-xs font-semibold px-3 py-2.5 rounded-sm text-gray-500 focus:outline-none cursor-not-allowed">
                    </div>
                </div>

                <button type="button" id="openModalBtn" class="bg-[#d2b4b4] hover:bg-[#c4a0a0] text-gray-800 text-[10px] font-bold px-4 py-1.5 rounded-sm transition shadow-sm uppercase tracking-wider">
                    Edit
                </button>
            </div>

           <form action="/profile/update-password" method="POST" id="passwordForm" class="space-y-4 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-400">
                <%= user.password ? "Change Password" : "Set Local Password Account" %>
            </h3>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 text-red-600 text-xs font-semibold p-3 rounded-sm border border-red-100 max-w-md">
                    <%= error %>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-green-50 text-green-600 text-xs font-semibold p-3 rounded-sm border border-green-100 max-w-md">
                    <%= success %>
                </div>
            <% } %>

            <div id="passwordFormError" class="hidden bg-red-50 text-red-600 text-xs font-semibold p-3 rounded-sm border border-red-100 max-w-md"></div>

            <div class="space-y-3 max-w-md">
                <% if (user.password) { %>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Current Password</label>
                        <div class="relative">
                            <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter current password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                            <button type="button" class="eye-toggle-btn absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>
                <% } %>
                
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">New Password</label>
                    <div class="relative">
                        <input type="password" name="newPassword" id="newPassword" placeholder="Enter new password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                        <button type="button" class="eye-toggle-btn absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <p class="text-[10px] text-gray-400 mt-1 font-normal leading-tight">Must be at least 8 characters, with 1 uppercase letter, 1 lowercase letter, 1 number, and 1 special symbol.</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Confirm Password</label>
                    <div class="relative">
                        <input type="password" name="confirmNewPassword" id="confirmNewPassword" placeholder="Confirm new password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                        <button type="button" class="eye-toggle-btn absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="bg-[#a87a7a] hover:bg-[#966868] text-white text-xs font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition shadow-md">
                    Save Changes
                </button>
            </div>
        </form>
        </div>

        <div class="w-full lg:w-44 shrink-0 flex flex-col items-center text-center space-y-3 pt-4 lg:pt-14">
            <div class="w-24 h-24 rounded-none border border-gray-200 flex items-center justify-center text-gray-300 bg-gray-50 relative overflow-hidden">
                <% if (user.profileImage) { %>
                    <img id="avatarImg" src="<%= user.profileImage %>" class="w-full h-full object-cover">
                <% } else { %>
                    <i id="avatarPlaceholder" class="fa-regular fa-user text-4xl text-[#a87a7a]"></i>
                    <img id="avatarImg" class="w-full h-full object-cover hidden">
                <% } %>
            </div>
            <div>
                <h4 class="text-sm font-bold text-gray-800"><%= user.firstName %> <%= user.lastName %></h4>
                <input type="file" name="avatar" id="profileImageInput" accept="image/*" class="hidden">          
                <button type="button" id="editProfilePicBtn" class="text-[11px] font-semibold text-gray-400 hover:text-gray-600 transition underline mt-1">
                    Edit Profile Picture
                </button>
            </div>
        </div>
    </div>
</div>

<div id="emailModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 px-4">
    <div class="bg-white rounded-sm shadow-2xl w-full max-w-md overflow-hidden relative border border-gray-100 animate-fade-in">
        
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-700">Update Profile Details</h3>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition text-lg">&times;</button>
        </div>

        <div class="p-6">
            <div id="modalError" class="hidden mb-4 bg-red-50 text-red-600 text-xs font-semibold p-3 rounded-sm border border-red-100"></div>

            <div id="stepEmail" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Full Name</label>
                    <input type="text" id="newNameInput" value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50 border border-gray-200 text-xs font-semibold px-3 py-2.5 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">New Email Address</label>
                    <input type="email" id="newEmailInput" value="<%= user.email %>" class="w-full bg-gray-50 border border-gray-200 text-xs font-semibold px-3 py-2.5 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                </div>

                <% if (user.password) { %>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Confirm Current Password</label>
                        <div class="relative">
                            <input type="password" id="confirmPasswordInput" placeholder="••••••••" class="w-full bg-gray-50 border border-gray-200 text-xs px-3 py-2.5 pr-10 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                            <button type="button" id="passwordToggleBtn" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i id="eyeIcon" class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <input type="hidden" id="confirmPasswordInput" value="google-user">
                <% } %>

                <button type="button" id="sendOtpBtn" class="w-full bg-[#a87a7a] hover:bg-[#966868] text-white text-xs font-bold uppercase tracking-widest py-3 rounded-sm transition shadow-md">
                    Send Verification Code
                </button>
            </div>

            <div id="stepOtp" class="hidden space-y-6 text-center">
                <p class="text-xs text-gray-500 font-medium">A secure 6-digit code was sent to your new email address. Please enter it below.</p>
                
                <div class="flex justify-center gap-2" id="otpInputsContainer">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                </div>

                <div class="text-xs font-bold text-red-500 tracking-wider">
                    Resend OTP in: <span id="timerText">05:00</span>
                </div>

                <button type="button" id="verifyOtpBtn" class="w-full bg-[#1e8436] hover:bg-green-700 text-white text-xs font-bold uppercase tracking-widest py-3 rounded-sm transition shadow-md">
                    Confirm & Update
                </button>
            </div>
        </div>

    </div>
</div>

<%- include('../partial/user/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const emailModal = document.getElementById('emailModal');
    const openModalBtn = document.getElementById('openModalBtn');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const stepEmail = document.getElementById('stepEmail');
    const stepOtp = document.getElementById('stepOtp');
    const modalError = document.getElementById('modalError');
    const passwordInput = document.getElementById('confirmPasswordInput');
    const passwordToggleBtn = document.getElementById('passwordToggleBtn');
    const eyeIcon = document.getElementById('eyeIcon');
    let countdownInterval;

    //  For 'eye toggle' in 'password'
    if (passwordToggleBtn && passwordInput && eyeIcon) {
        passwordToggleBtn.addEventListener('click', () => {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.className = 'fa-solid fa-eye-slash';
            } else {
                passwordInput.type = 'password';
                eyeIcon.className = 'fa-regular fa-eye';
            }
        });
    }

    //  Profile Picture Upload Interceptor logic
    const editProfilePicBtn = document.getElementById('editProfilePicBtn');
    const profileImageInput = document.getElementById('profileImageInput');
    const avatarImg = document.getElementById('avatarImg');
    const avatarPlaceholder = document.getElementById('avatarPlaceholder');

    if (editProfilePicBtn && profileImageInput) {
        editProfilePicBtn.addEventListener('click', () => profileImageInput.click());
        profileImageInput.addEventListener('change', async (e) => {
            const imageFile = e.target.files[0];
            if (!imageFile) return;
            const packetData = new FormData();
            packetData.append('profileImage', imageFile);
            try {
                const uploadRequest = await fetch('/profile/update-avatar', {
                    method: 'POST',
                    body: packetData
                });
                const result = await uploadRequest.json();
                if (result.success) {
                    if (avatarImg) {
                        avatarImg.src = result.imageUrl;
                        avatarImg.classList.remove('hidden');
                    }
                    if (avatarPlaceholder) avatarPlaceholder.classList.add('hidden');
                    window.location.reload();
                } else {
                    alert(result.message || "Error updating image.");
                }
            } catch (err) {
                console.error("Image upload exception sequence:", err);
                alert("Server image parsing fail loop.");
            }
        });
    }

    // Modal Visibility Triggers
    openModalBtn.addEventListener('click', () => {
        emailModal.classList.remove('hidden');
        emailModal.classList.add('flex');
    });
    
    closeModalBtn.addEventListener('click', () => {
        emailModal.classList.add('hidden');
        emailModal.classList.remove('flex');
        clearInterval(countdownInterval);
    });

    // Auto Focus Navigation Loop for 6 OTP Boxes
    const otpBoxes = document.querySelectorAll('.otp-box');
    otpBoxes.forEach((box, index) => {
        box.addEventListener('input', (e) => {
            if (e.target.value.length === 1 && index < otpBoxes.length - 1) {
                otpBoxes[index + 1].focus();
            }
        });
        box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                otpBoxes[index - 1].focus();
            }
        });
    });

    function startCountdown() {
        let duration = 5 * 60;
        clearInterval(countdownInterval);
        countdownInterval = setInterval(() => {
            let minutes = Math.floor(duration / 60);
            let seconds = duration % 60;
            document.getElementById('timerText').innerText = `${minutes < 10 ? '0' + minutes : minutes}:${seconds < 10 ? '0' + seconds : seconds}`;
            if (--duration < 0) {
                clearInterval(countdownInterval);
                document.getElementById('timerText').innerText = "EXPIRED";
            }
        }, 1000);
    }

    // Step 1 Payload Dispatch via Fetch API
    document.getElementById('sendOtpBtn').addEventListener('click', async () => {
        const newName = document.getElementById('newNameInput').value;
        const newEmail = document.getElementById('newEmailInput').value;
        const password = passwordInput ? passwordInput.value : '';
        modalError.classList.add('hidden');

        const response = await fetch('/profile/change-email-request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newName, newEmail, password })
        });

        const data = await response.json();

        if (data.success) {
            stepEmail.classList.add('hidden');
            stepOtp.classList.remove('hidden');
            startCountdown();
        } else {
            modalError.innerText = data.message;
            modalError.classList.remove('hidden');
        }
    });

    // Authentication Token Verification Loop
    document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
        let combinedOtp = "";
        otpBoxes.forEach(box => combinedOtp += box.value);
        modalError.classList.add('hidden');

        const response = await fetch('/profile/change-email-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ otp: combinedOtp })
        });

        const data = await response.json();

        if (data.success) {
            window.location.reload(); 
        } else {
            modalError.innerText = data.message;
            modalError.classList.remove('hidden');
        }
    });
});


// Add this inside your DOMContentLoaded event listener loop in profile.ejs
const eyeToggleButtons = document.querySelectorAll('.eye-toggle-btn');

eyeToggleButtons.forEach(button => {
    button.addEventListener('click', () => {
        // Find the specific sibling input field relative to the clicked button
        const passwordInput = button.parentElement.querySelector('.password-toggle-input');
        const eyeIcon = button.querySelector('i');

        if (passwordInput && eyeIcon) {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.className = 'fa-solid fa-eye-slash';
            } else {
                passwordInput.type = 'password';
                eyeIcon.className = 'fa-regular fa-eye';
            }
        }
    });
});


const passwordForm = document.getElementById('passwordForm');
const passwordFormError = document.getElementById('passwordFormError');

if (passwordForm) {
    passwordForm.addEventListener('submit', function(e) {
        const newPasswordValue = document.getElementById('newPassword').value;
        const confirmPasswordValue = document.getElementById('confirmNewPassword').value;
        
        // Clear any previous errors
        passwordFormError.classList.add('hidden');
        passwordFormError.innerText = "";

        // Structural Strength Pattern Validation Checking (Matches your signup regex exactly!)
        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&_'])[A-Za-z\d@$!%*?&_']{8,}$/;
        if (!passwordRegex.test(newPasswordValue)) {
            e.preventDefault(); // Stop form submission execution paths
            passwordFormError.innerText = "Weak Password: Must be at least 8 characters and include uppercase, lowercase, a number, and a special character.";
            passwordFormError.classList.remove('hidden');
            return;
        }

        // Matching Confirmation Checking
        if (newPasswordValue !== confirmPasswordValue) {
            e.preventDefault();
            passwordFormError.innerText = "Passwords do not match!";
            passwordFormError.classList.remove('hidden');
            return;
        }
    });
}

</script>

