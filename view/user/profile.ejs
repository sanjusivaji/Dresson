<%- contentFor('body') %>

<div class="w-full max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row gap-8"> 
    <aside class="w-full md:w-64 flex-shrink-0 lg:col-span-3">
        <%- include('../partial/user/userSidebar') %>
    </aside>
    <main class="w-full flex-1">
           <!-- Referral Code Display -->
            <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">Your Referral Code</label>
                <div class="flex gap-2">
                    <input type="text" readonly id="myReferralCode" value="<%= user.referralCode || 'N/A' %>" class="w-full bg-[#f8fcf8] border border-[#208b59]/30 text-xs font-bold px-3 py-2.5 rounded-sm text-[#208b59] focus:outline-none cursor-text">
                    <button type="button" id="copyReferralBtn" onclick="copyReferralCode()" class="w-20 bg-[#208b59] hover:bg-[#1a734a] text-white text-[10px] font-bold py-1.5 rounded-sm transition-colors duration-300 shadow-sm uppercase tracking-wider text-center">
                        Copy
                    </button>
                </div>
                <p class="text-[10px] text-gray-400 mt-1 font-normal leading-tight">Share this code! You and your friend both get an amount to wallet balance when they sign up.</p>
            </div>
        
        <%- include('../partial/shared/alertSuccess') %>
        <%- include('../partial/shared/alertError') %>
        <%- include('../partial/shared/warning') %> 

        <div class="flex-grow flex flex-col lg:flex-row gap-8 bg-white p-6 md:p-8 rounded-sm border border-gray-200 shadow-sm min-h-[500px]">

             <!-- For change 'email' and 'name' -->
            <div class="space-y-8 flex-grow max-w-2xl">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900">Profile</h2>
                <div class="space-y-4">
                    <h3 class="text-base font-bold text-gray-400">Change Email</h3>                
                    <div class="space-y-3 max-w-md">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">Name</label>
                            <input type="text" readonly value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50 border-none text-xs font-semibold px-3 py-2.5 rounded-sm text-gray-500 focus:outline-none cursor-not-allowed">
                        </div>                    
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">Email Address</label>
                            <input type="email" readonly value="<%= user.email %>" class="w-full bg-gray-50 border-none text-xs font-semibold px-3 py-2.5 rounded-sm text-gray-500 focus:outline-none cursor-not-allowed">
                        </div>
                                               
                    </div>
                    
                  <!--   Check for googleId instead of password -->
                    <% if (!user.googleId) { %>
                        <button type="button" id="openModalBtn" class="bg-[#d2b4b4] hover:bg-[#c4a0a0] text-gray-800 text-[10px] font-bold px-4 py-1.5 rounded-sm transition shadow-sm uppercase tracking-wider">
                            Edit
                        </button>
                    <% } else { %>
                        <div class="pt-2">
                            <!-- This triggers the alert instead of opening the modal -->
                            <button type="button" onclick="showGoogleAuthAlert()" class="bg-[#d2b4b4] hover:bg-[#c4a0a0] text-gray-800 text-[10px] font-bold px-4 py-1.5 rounded-sm transition shadow-sm uppercase tracking-wider">
                                Edit
                            </button>
                            <p class="text-[11px] text-gray-500 mt-2 font-medium">
                                <i class="fab fa-google text-gray-400 mr-1"></i> Account created via Google.
                            </p>
                        </div>
                    <% } %>
                </div>

                 <!-- For change password -->
                <form action="/profile/update-password" method="POST" id="passwordForm" class="space-y-4 border-t border-gray-100 pt-6" novalidate>
                <h3 class="text-base font-bold text-gray-400">
                    <%= user.password ? "Change Password" : "Set Local Password Account" %>
                </h3>            
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="bg-red-50 text-red-600 text-xs font-semibold p-3 rounded-sm border border-red-100 max-w-md">
                        <%= error %>
                    </div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="bg-green-50 text-green-600 text-xs font-semibold p-3 rounded-sm border border-green-100 max-w-md">
                        <%= success %>
                    </div>
                <% } %>
                <%- include('../partial/user/errorMessage', { errorId: 'passwordFormError' }) %>
                <div class="space-y-3 max-w-md">
                    <% if (user.password) { %>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">Current Password</label>
                            <div class="relative password-toggle-wrapper">
                                <input type="password" name="currentPassword" id="passwordInput" placeholder="Enter current password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                                <button type="button" class="forToggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <!-- Inline Error for Current Password -->
                            <p id="currentPasswordError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                        </div>
                    <% } %>                
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">New Password</label>
                        <div class="relative password-toggle-wrapper">
                            <input type="password" name="newPassword" id="newPassword" placeholder="Enter new password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                            <button type="button" class="forToggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <p class="text-[10px] text-gray-400 mt-1 font-normal leading-tight">Must be at least 8 characters, with 1 uppercase letter, 1 lowercase letter, 1 number, and 1 special symbol.</p>
                        <!-- Inline Error for New Password -->
                        <p id="newPasswordError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Confirm Password</label>
                        <div class="relative password-toggle-wrapper">
                            <input type="password" name="confirmNewPassword" id="confirmNewPassword" placeholder="Confirm new password" class="password-toggle-input w-full bg-gray-100 border-none text-xs px-3 py-2.5 pr-10 rounded-sm text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-400" required>
                            <button type="button" class="forToggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <!-- Inline Error for Confirm Password -->
                        <p id="confirmNewPasswordError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                    </div>
                </div>
                   <div class="pt-4">
                        <% if (!user.googleId) { %>
                            <button type="submit" class="bg-[#a87a7a] hover:bg-[#966868] text-white text-xs font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition shadow-md">
                                Save Changes
                            </button>
                        <% } else { %>
                            <!-- This triggers the alert instead of submitting the form -->
                            <button type="button" onclick="showGoogleAuthAlert()" class="bg-[#a87a7a] hover:bg-[#966868] text-white text-xs font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition shadow-md">
                                Save Changes
                            </button>
                        <% } %>
                    </div>
            </form>
            </div>

             <!-- For change profile image -->
            <div class="w-full lg:w-44 shrink-0 flex flex-col items-center text-center space-y-3 pt-4 lg:pt-14 border-t lg:border-t-0 lg:border-l border-gray-100">
                <div class="w-24 h-24 rounded-none border border-gray-200 flex items-center justify-center text-gray-300 bg-gray-50 relative overflow-hidden">
                    <% if (user.profileImage) { %>
                        <img id="avatarImg" src="<%= user.profileImage %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <i id="avatarPlaceholder" class="fa-regular fa-user text-4xl text-[#a87a7a]"></i>
                        <img id="avatarImg" class="w-full h-full object-cover hidden">
                    <% } %>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-gray-800"><%= user.firstName %> <%= user.lastName %></h4>
                    <input type="file" name="avatar" id="profileImageInput" accept="image/*" class="hidden">          
                    <button type="button" id="editProfilePicBtn" class="text-[12px] font-semibold text-gray-400 hover:text-gray-600 transition underline mt-1 cursor-pointer">
                        Edit Profile Picture
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- 'Container' for both popup modal to 'Change name or email' and 'OTP' box -->
<div id="emailModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 px-4">
    <div class="bg-white rounded-sm shadow-2xl w-full max-w-md overflow-hidden relative border border-gray-100 animate-fade-in">        
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-700">Update Profile Details</h3>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition text-lg">&times;</button>
        </div>
        <div class="p-6">
            <!-- <div id="modalError" class="hidden mb-4 bg-red-50 text-red-600 text-xs font-semibold p-3 rounded-sm border border-red-100"></div> -->
            <%- include('../partial/user/errorMessage', { errorId: 'modalError' }) %>

             <!-- For pop up modal to 'Change name or email' -->
            <div id="stepEmail" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Full Name</label>
                    <input type="text" id="newNameInput" value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50 border border-gray-200 text-xs font-semibold px-3 py-2.5 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                    <!-- Inline Error for Name -->
                    <p id="newNameError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">New Email Address</label>
                    <input type="email" id="newEmailInput" value="<%= user.email %>" class="w-full bg-gray-50 border border-gray-200 text-xs font-semibold px-3 py-2.5 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                    <!-- Inline Error for Email -->
                    <p id="newEmailError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                </div>
                <% if (user.password) { %>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Confirm Current Password</label>
                        <div class="relative password-toggle-wrapper">
                            <input type="password" id="confirmPasswordInput" placeholder="••••••••" class="password-toggle-input w-full bg-gray-50 border border-gray-200 text-xs px-3 py-2.5 pr-10 rounded-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
                            <button type="button" class="forToggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <!-- Inline Error for Confirm Password Modal -->
                        <p id="confirmPassModalError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                    </div>
                <% } else { %>
                    <input type="hidden" id="confirmPasswordInput" value="google-user">
                <% } %>

                <button type="button" id="sendOtpBtn" class="w-full bg-[#a87a7a] hover:bg-[#966868] text-white text-xs font-bold uppercase tracking-widest py-3 rounded-sm transition shadow-md">
                    Send Verification Code
                </button>
            </div>

             <!-- For pop up modal to otp-->
            <div id="stepOtp" class="hidden space-y-6 text-center">
                <p class="text-xs text-gray-500 font-medium">A secure 6-digit code was sent to your new email address. Please enter it below.</p>
                <div class="flex justify-center gap-2" id="otpInputsContainer">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
                </div>
                <div class="text-xs font-bold text-red-500 tracking-wider">
                    Resend OTP in: <span id="timerText">05:00</span>
                </div>
                <button type="button" id="verifyOtpBtn" class="w-full bg-[#1e8436] hover:bg-green-700 text-white text-xs font-bold uppercase tracking-widest py-3 rounded-sm transition shadow-md">
                    Confirm & Update
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/shared/togglePassword.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const emailModal = document.getElementById('emailModal');
    const openModalBtn = document.getElementById('openModalBtn');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const stepEmail = document.getElementById('stepEmail');
    const stepOtp = document.getElementById('stepOtp');
    const modalError = document.getElementById('modalError');
    const passwordInput = document.getElementById('confirmPasswordInput');
    let countdownInterval;

    // It is the 'helper function' we call below
    function clearInlineErrors() {
        document.querySelectorAll('.inline-error').forEach(el => {
            el.classList.add('hidden');
            el.innerText = '';
        });
    }

    function showInlineError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        if (errorElement) {
            errorElement.innerText = message;
            errorElement.classList.remove('hidden');
        }
    }

   // For 'copy Referral' code
    window.copyReferralCode = function() {
        const codeInput = document.getElementById('myReferralCode');
        const copyBtn = document.getElementById('copyReferralBtn');        
        if (codeInput.value && codeInput.value !== 'N/A') {
            navigator.clipboard.writeText(codeInput.value).then(() => {
                copyBtn.innerText = "COPIED!";                                 // Changed '<button>' text 'COPY' into 'COPIED' for '2' seconds
                copyBtn.classList.replace('bg-[#208b59]', 'bg-gray-800');
                copyBtn.classList.replace('hover:bg-[#1a734a]', 'hover:bg-gray-900');
                setTimeout(() => {
                    copyBtn.innerText = "COPY";
                    copyBtn.classList.replace('bg-gray-800', 'bg-[#208b59]');
                    copyBtn.classList.replace('hover:bg-gray-900', 'hover:bg-[#1a734a]');
                }, 2000);
            }).catch(err => {
                console.error("Failed to copy", err);
            });
        }
    };

    // For 'change password'
    const passwordForm = document.getElementById('passwordForm');
    const passwordFormError = document.getElementById('passwordFormError');
    if (passwordForm) {
        passwordForm.addEventListener('submit', function(e) {
            clearInlineErrors(); // Clear existing custom validation text
            let isValid = true;
            
            const currentPassEl = document.getElementById('passwordInput');
            const newPasswordValue = document.getElementById('newPassword').value;
            const confirmPasswordValue = document.getElementById('confirmNewPassword').value;
            
            if (passwordFormError) {
                passwordFormError.classList.add('hidden');
                passwordFormError.innerText = "";
            }

            if (currentPassEl && !currentPassEl.value.trim()) {
                showInlineError('currentPasswordError', 'Current password is required.');
                isValid = false;
            }
            
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&_'])[A-Za-z\d@$!%*?&_']{8,}$/;
            if (!passwordRegex.test(newPasswordValue)) {                               // If it is 'true' ie 'test' is built-in 'regular expression' method and it checks if it matches strict security pattern(ie 'passwordRegex').
                showInlineError('newPasswordError', 'Weak Password: Must be at least 8 characters and include uppercase, lowercase, a number, and a special character.');                          // For display the error below input
                isValid = false;
            }
            if (newPasswordValue !== confirmPasswordValue) {
                showInlineError('confirmNewPasswordError', 'Passwords do not match!');
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
                return;
            }
        });
    }

    // For make 'visible' and 'hidden' the modal
    if (openModalBtn) {
        openModalBtn.addEventListener('click', () => {
            emailModal.classList.remove('hidden');
            emailModal.classList.add('flex');                                   // If we put 'flex' directly into your 'ejs' file, would conflict with 'hidden' class, so we 
        });
    }
    
    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', () => {
            emailModal.classList.add('hidden');
            emailModal.classList.remove('flex');
            clearInterval(countdownInterval);                                 // Here 'setInterval()' starts the infinite 'clock loop' and assigns its 'tracking ID' to variable 'countdownInterval' and 'clearInterval()' used for 'stop' this 'timer' and here we use it for 'close' the timer when close the 'modal'(ie when we close the 'modal' there is no need for timer).
            clearInlineErrors(); // Clear validation on close
        });
    }

    // For display otp
    const otpBoxes = document.querySelectorAll('.otp-box');                   // It return 'node list'(ie 'array' like data structure).
    otpBoxes.forEach((item, index) => {                                      
        item.addEventListener('input', (e) => {                               // 'input' event 'triggers' the exact millisecond a user 'types', 'pastes', or 'changes' a character inside the input box.
            if (e.target.value.length === 1 && index < otpBoxes.length - 1) { // It checks 'event' triggering 'target' value 'length' is 'exactly' '1' or value 'index' is less than 'otp box' is both condition are 'true' then we can 'focus' 'next' 'otp box'(ie 'otpBoxes[index + 1].focus') 
                otpBoxes[index + 1].focus();
            }
        });
        item.addEventListener('keydown', (e) => {                             // 'keydown' 'event' triggers when press any key in 'keyboard' and it used for 'Backsapce' key for 'delete' the character.
            if (e.key === 'Backspace' && !e.target.value && index > 0) {      // In 'e.key', 'key' is the 'built-in' property of 'keyboard'(ie it indicates which keyboard is it)and also check it is 'not' target value and 'index > 0' and when we press 'Backspace' keyword,the 'browser' automatically 'delete' the character(ie 'no' need of 'js' operation)
                otpBoxes[index - 1].focus();                                  // For 'cursor' movement
            }
        });
    });

    // For 'otp' count down
    function startCountdown() {
        let duration = 5 * 60;
        clearInterval(countdownInterval);
        countdownInterval = setInterval(() => {
            let minutes = Math.floor(duration / 60);
            let seconds = duration % 60;
            document.getElementById('timerText').innerText = `${minutes < 10 ? '0' + minutes : minutes}:${seconds < 10 ? '0' + seconds : seconds}`;
            if (--duration < 0) {
                clearInterval(countdownInterval);
                document.getElementById('timerText').innerText = "EXPIRED";
            }
        }, 1000);
    }

    // For email change
    const sendOtpBtn = document.getElementById('sendOtpBtn');
    if (sendOtpBtn) {
        sendOtpBtn.addEventListener('click', async () => {
            clearInlineErrors(); 
            let isValid = true;
            
            const newName = document.getElementById('newNameInput').value;       // It extract 'string' value that put inside '<input>'(ie we 'donot' retrieve entire element)
            const newEmail = document.getElementById('newEmailInput').value;
            const password = passwordInput ? passwordInput.value : '';
            if (!newName.trim() || newName.trim().length < 3) {
                showInlineError('newNameError', 'Name must be at least 3 characters.');
                isValid = false;
            }
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(newEmail.trim())) {
                showInlineError('newEmailError', 'Please enter a valid email address.');
                isValid = false;
            }
            if (passwordInput && passwordInput.value !== 'google-user' && !password.trim()) {
                showInlineError('confirmPassModalError', 'Current password is required to save changes.');
                isValid = false;
            }          
            if (!isValid) return;             
            if (modalError) modalError.classList.add('hidden');            
            const response = await fetch('/profile/change-email-request', {    // Uploading all data
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },               // We should put this 'header' except when we send 'formData'
                body: JSON.stringify({ newName, newEmail, password })
            });
            const data = await response.json();
            if (data.success) {
                stepEmail.classList.add('hidden');                             // 'stepEmail' is the 'continer' for 'email'
                stepOtp.classList.remove('hidden');
                startCountdown();                                              // This function created just above for 'count down'
            } else {
                if (modalError) {
                    modalError.innerText = data.message;
                    modalError.classList.remove('hidden');
                }
            }
        });
    }

    // For send 'otp'
    const verifyOtpBtn = document.getElementById('verifyOtpBtn');
    if (verifyOtpBtn) {
        verifyOtpBtn.addEventListener('click', async () => {
            let combinedOtp = "";
            otpBoxes.forEach(item => combinedOtp += item.value);              // Combine all 'otp' into single string
            if (modalError) modalError.classList.add('hidden');

            const response = await fetch('/profile/change-email-verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp: combinedOtp })
            });
            const data = await response.json();
            if (data.success) {
                window.location.reload(); 
            } else {
                if (modalError) {
                    modalError.innerText = data.message;
                    modalError.classList.remove('hidden');
                }
            }
        });
    }

    //  For upload profile picture
    const profilePicBtn = document.getElementById('editProfilePicBtn');     // For '<button>' for 'edit profile image'
    const profileImageInput = document.getElementById('profileImageInput'); // For '<input>' image
    const avatarImg = document.getElementById('avatarImg');                 // For display 'image', by using '<img>' with 'src'
    const avatarPlaceholder = document.getElementById('avatarPlaceholder'); // For display 'place holder' user image, when 'not' actual image
    if (profilePicBtn && profileImageInput) {
        profilePicBtn.addEventListener('click', () => profileImageInput.click()); // Here 'profileImageInput' represents '<input type="file">' element and we make it 'hidden'(ie 'without' 'hidden' 'tailwind' class, it display a 'box' with name 'choose file') and when user click the '<button>'(ie 'edit profile picture' text), it triggers the 'input' and display 'our' own computer 'file inputs'.        
        profileImageInput.addEventListener('change', async (e) => {               // 'change' event triggers when user 'select' the file and we interact with internet and it may be make 'slow' so we should use 'async/await',
            const imageFile = e.target.files[0];
            if (!imageFile) return;        
            const packetData = new FormData();
            packetData.append('profileImage', imageFile);
            
            try {
                const uploadRequest = await fetch('/profile/update-avatar', {
                    method: 'POST',
                    body: packetData
                });
                
                const result = await uploadRequest.json();
                if (result.success) {
                    if (avatarImg) {
                        avatarImg.src = result.imageUrl;
                        avatarImg.classList.remove('hidden');
                    }
                    if (avatarPlaceholder) avatarPlaceholder.classList.add('hidden');
                    window.location.reload();
                } else {
                    alert(result.message || "Error updating image.");
                }
            } catch (err) {
                console.error("Image upload exception sequence:", err);
                alert("Server image parsing fail loop.");
            }
        });
    }
});

