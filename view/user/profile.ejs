<%- contentFor('body') %>

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col md:flex-row gap-8"> 
    <aside class="w-full md:w-64 flex-shrink-0 lg:col-span-3">
        <%- include('../partial/user/userSidebar') %>
    </aside>
    
    <main class="w-full flex-1 space-y-6">
        <!-- Referral Code Banner -->
        <div class="bg-gradient-to-r from-emerald-50/80 via-white to-emerald-50/30 p-5 rounded-xl border border-[#208b59]/20 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-0.5">
                <label class="block text-[11px] font-bold text-[#208b59] uppercase tracking-wider">Your Exclusive Referral Code</label>
                <p class="text-xs text-gray-500 font-medium leading-relaxed">Share this code with friends! You both receive wallet bonus credits upon sign-up.</p>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <input type="text" readonly id="myReferralCode" value="<%= user.referralCode || 'N/A' %>" class="w-full sm:w-36 bg-white border border-[#208b59]/30 text-xs font-bold px-3 py-2 rounded-lg text-[#208b59] focus:outline-none cursor-text text-center shadow-2xs">
                <button type="button" id="copyReferralBtn" onclick="copyReferralCode()" class="px-5 bg-[#208b59] hover:bg-[#1a734a] text-white text-xs font-bold py-2 rounded-lg transition-all duration-300 shadow-sm uppercase tracking-wider text-center shrink-0">
                    Copy
                </button>
            </div>
        </div>
        
        <%- include('../partial/shared/alertSuccess') %>
        <%- include('../partial/shared/alertError') %>
        <%- include('../partial/shared/warning') %> 

        <div class="flex-grow flex flex-col lg:flex-row gap-8 bg-white p-6 md:p-10 rounded-2xl border border-gray-100 shadow-sm min-h-[500px]">

             <!-- For change 'email' and 'name' -->
            <div class="space-y-8 flex-grow max-w-2xl">
                <div class="border-b border-gray-100 pb-4">
                    <h2 class="text-2xl font-extrabold tracking-tight text-gray-900">Profile Settings</h2>
                    <p class="text-xs text-gray-400 mt-1">Manage your account information, security credentials, and profile image.</p>
                </div>

                <div class="space-y-5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400">Account Details</h3>                
                    <div class="space-y-4 max-w-md">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1.5">Full Name</label>
                            <input type="text" readonly value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50/80 border border-gray-200/60 text-xs font-semibold px-3.5 py-3 rounded-lg text-gray-600 focus:outline-none cursor-not-allowed">
                        </div>                    
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1.5">Email Address</label>
                            <input type="email" readonly value="<%= user.email %>" class="w-full bg-gray-50/80 border border-gray-200/60 text-xs font-semibold px-3.5 py-3 rounded-lg text-gray-600 focus:outline-none cursor-not-allowed">
                        </div>
                    </div>
                    
                    <!-- Check for googleId to hide edit buttons -->
                    <% if (!user.googleId) { %>
                        <button type="button" id="openModalBtn" class="bg-gray-900 hover:bg-black text-white text-xs font-bold px-5 py-2.5 rounded-lg transition shadow-sm uppercase tracking-wider cursor-pointer">
                            Edit Profile & Email
                        </button>
                    <% } else { %>
                        <div class="pt-2 bg-blue-50/50 p-3.5 rounded-lg border border-blue-100/60 flex items-center gap-2.5">
                            <i class="fab fa-google text-blue-500 text-sm"></i>
                            <p class="text-xs text-blue-900 font-medium">
                                Connected via Google. Name and Email are managed automatically by Google.
                            </p>
                        </div>
                    <% } %>
                </div>

                <!-- ONLY render the password form if NOT a Google user -->
                <% if (!user.googleId) { %>
                    <!-- For change password -->
                    <form action="/profile/update-password" method="POST" id="passwordForm" class="space-y-5 border-t border-gray-100 pt-8" novalidate>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400">
                            <%= user.password ? "Change Password" : "Set Local Password Account" %>
                        </h3>            
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="bg-red-50 text-red-600 text-xs font-semibold p-3.5 rounded-lg border border-red-100 max-w-md">
                                <%= error %>
                            </div>
                        <% } %>
                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="bg-green-50 text-green-600 text-xs font-semibold p-3.5 rounded-lg border border-green-100 max-w-md">
                                <%= success %>
                            </div>
                        <% } %>
                        <%- include('../partial/user/errorMessage', { errorId: 'passwordFormError' }) %>
                        <div class="space-y-4 max-w-md">
                            <% if (user.password) { %>
                                <div>
                                    <label class="block text-xs font-bold text-gray-500 mb-1.5">Current Password</label>
                                    <div class="relative password-toggle-wrapper">
                                        <input type="password" name="currentPassword" id="passwordInput" placeholder="Enter current password" class="password-toggle-input w-full bg-gray-50/50 border border-gray-200 text-xs px-3.5 py-3 pr-10 rounded-lg text-gray-800 focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition" required>
                                        <button type="button" class="forToggle absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>
                                    <!-- Inline Error for Current Password -->
                                    <p id="currentPasswordError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                                </div>
                            <% } %>                
                            <div>
                                <label class="block text-xs font-bold text-gray-500 mb-1.5">New Password</label>
                                <div class="relative password-toggle-wrapper">
                                    <input type="password" name="newPassword" id="newPassword" placeholder="Enter new password" class="password-toggle-input w-full bg-gray-50/50 border border-gray-200 text-xs px-3.5 py-3 pr-10 rounded-lg text-gray-800 focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition" required>
                                    <button type="button" class="forToggle absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <p class="text-[11px] text-gray-400 mt-1.5 font-normal leading-relaxed">Must be at least 8 characters, with 1 uppercase letter, 1 lowercase letter, 1 number, and 1 special symbol.</p>
                                <!-- Inline Error for New Password -->
                                <p id="newPasswordError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 mb-1.5">Confirm Password</label>
                                <div class="relative password-toggle-wrapper">
                                    <input type="password" name="confirmNewPassword" id="confirmNewPassword" placeholder="Confirm new password" class="password-toggle-input w-full bg-gray-50/50 border border-gray-200 text-xs px-3.5 py-3 pr-10 rounded-lg text-gray-800 focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition" required>
                                    <button type="button" class="forToggle absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <!-- Inline Error for Confirm Password -->
                                <p id="confirmNewPasswordError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                            </div>
                        </div>
                        <div class="pt-2">
                            <button type="submit" class="bg-gray-900 hover:bg-black text-white text-xs font-bold uppercase tracking-widest px-8 py-3 rounded-lg transition shadow-md cursor-pointer">
                                Save Changes
                            </button>
                        </div>
                    </form>
                <% } %>
            </div>

             <!-- For change profile image -->
            <div class="w-full lg:w-52 shrink-0 flex flex-col items-center text-center space-y-4 pt-6 lg:pt-14 border-t lg:border-t-0 lg:border-l border-gray-100 lg:pl-8">
                <div class="w-28 h-28 rounded-full border-2 border-gray-100 shadow-inner flex items-center justify-center text-gray-300 bg-gray-50 relative overflow-hidden">
                    <% if (user.profileImage) { %>
                        <img id="avatarImg" src="<%= user.profileImage %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <i id="avatarPlaceholder" class="fa-regular fa-user text-4xl text-gray-400"></i>
                        <img id="avatarImg" class="w-full h-full object-cover hidden">
                    <% } %>
                </div>
                <div class="space-y-1">
                    <h4 class="text-sm font-extrabold text-gray-900"><%= user.firstName %> <%= user.lastName %></h4>
                    
                    <!-- ONLY show image upload button for non-Google users -->
                    <% if (!user.googleId) { %>
                        <input type="file" name="avatar" id="profileImageInput" accept="image/*" class="hidden">          
                        <button type="button" id="editProfilePicBtn" class="inline-block text-xs font-bold text-indigo-600 hover:text-indigo-800 transition underline mt-2 cursor-pointer">
                            Edit Profile Picture
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- 'Container' for both popup modal to 'Change name or email' and 'OTP' box -->
<div id="emailModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs hidden items-center justify-center z-50 px-4 transition-all">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden relative border border-gray-100 animate-fade-in">        
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Update Profile Details</h3>
            <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition text-xl cursor-pointer">&times;</button>
        </div>
        <div class="p-6 sm:p-8">
            <%- include('../partial/user/errorMessage', { errorId: 'modalError' }) %>

             <!-- For pop up modal to 'Change name or email' -->
            <div id="stepEmail" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Full Name</label>
                    <input type="text" id="newNameInput" value="<%= user.firstName %> <%= user.lastName %>" class="w-full bg-gray-50/50 border border-gray-200 text-xs font-semibold px-3.5 py-3 rounded-lg focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition">
                    <!-- Inline Error for Name -->
                    <p id="newNameError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1.5">New Email Address</label>
                    <input type="email" id="newEmailInput" value="<%= user.email %>" class="w-full bg-gray-50/50 border border-gray-200 text-xs font-semibold px-3.5 py-3 rounded-lg focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition">
                    <!-- Inline Error for Email -->
                    <p id="newEmailError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                </div>
                <% if (user.password) { %>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1.5">Confirm Current Password</label>
                        <div class="relative password-toggle-wrapper">
                            <input type="password" id="confirmPasswordInput" placeholder="••••••••" class="password-toggle-input w-full bg-gray-50/50 border border-gray-200 text-xs px-3.5 py-3 pr-10 rounded-lg focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-400 transition">
                            <button type="button" class="forToggle absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none text-sm">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <!-- Inline Error for Confirm Password Modal -->
                        <p id="confirmPassModalError" class="inline-error text-red-500 text-[11px] font-bold mt-1.5 hidden"></p>
                    </div>
                <% } else { %>
                    <input type="hidden" id="confirmPasswordInput" value="google-user">
                <% } %>

                <button type="button" id="sendOtpBtn" class="w-full bg-gray-900 hover:bg-black text-white text-xs font-bold uppercase tracking-widest py-3 rounded-lg transition shadow-md cursor-pointer mt-2">
                    Send Verification Code
                </button>
            </div>

             <!-- For pop up modal to otp-->
            <div id="stepOtp" class="hidden space-y-6 text-center">
                <p class="text-xs text-gray-500 font-medium leading-relaxed">A secure 6-digit code was sent to your new email address. Please enter it below.</p>
                <div class="flex justify-center gap-2 sm:gap-3" id="otpInputsContainer">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50/50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                    <input type="text" maxlength="1" class="otp-box w-11 h-13 text-center text-lg font-bold bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-gray-900 focus:ring-1 focus:ring-gray-900 transition">
                </div>
                <div class="text-xs font-bold text-red-500 tracking-wider bg-red-50 py-2 rounded-lg">
                    Resend OTP in: <span id="timerText">05:00</span>
                </div>
                <button type="button" id="verifyOtpBtn" class="w-full bg-[#1e8436] hover:bg-green-700 text-white text-xs font-bold uppercase tracking-widest py-3 rounded-lg transition shadow-md cursor-pointer">
                    Confirm & Update
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/shared/togglePassword.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const emailModal = document.getElementById('emailModal');
    const openModalBtn = document.getElementById('openModalBtn');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const stepEmail = document.getElementById('stepEmail');
    const stepOtp = document.getElementById('stepOtp');
    const modalError = document.getElementById('modalError');
    const passwordInput = document.getElementById('confirmPasswordInput');
    let countdownInterval;

    // It is the 'helper function' we call below
    function clearInlineErrors() {
        document.querySelectorAll('.inline-error').forEach(el => {
            el.classList.add('hidden');
            el.innerText = '';
        });
    }

    function showInlineError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        if (errorElement) {
            errorElement.innerText = message;
            errorElement.classList.remove('hidden');
        }
    }

   // For 'copy Referral' code
    window.copyReferralCode = function() {
        const codeInput = document.getElementById('myReferralCode');
        const copyBtn = document.getElementById('copyReferralBtn');        
        if (codeInput.value && codeInput.value !== 'N/A') {
            navigator.clipboard.writeText(codeInput.value).then(() => {
                copyBtn.innerText = "COPIED!";                                                    
                copyBtn.classList.replace('bg-[#208b59]', 'bg-gray-800');
                copyBtn.classList.replace('hover:bg-[#1a734a]', 'hover:bg-gray-900');
                setTimeout(() => {
                    copyBtn.innerText = "COPY";
                    copyBtn.classList.replace('bg-gray-800', 'bg-[#208b59]');
                    copyBtn.classList.replace('hover:bg-gray-900', 'hover:bg-[#1a734a]');
                }, 2000);
            }).catch(err => {
                console.error("Failed to copy", err);
            });
        }
    };

    // For 'change password' (Only executes if the form actually exists in the DOM)
    const passwordForm = document.getElementById('passwordForm');
    const passwordFormError = document.getElementById('passwordFormError');
    if (passwordForm) {
        passwordForm.addEventListener('submit', function(e) {
            clearInlineErrors(); 
            let isValid = true;
            
            const currentPassEl = document.getElementById('passwordInput');
            const newPasswordValue = document.getElementById('newPassword').value;
            const confirmPasswordValue = document.getElementById('confirmNewPassword').value;
            
            if (passwordFormError) {
                passwordFormError.classList.add('hidden');
                passwordFormError.innerText = "";
            }

            if (currentPassEl && !currentPassEl.value.trim()) {
                showInlineError('currentPasswordError', 'Current password is required.');
                isValid = false;
            }
            
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&_'])[A-Za-z\d@$!%*?&_']{8,}$/;
            if (!passwordRegex.test(newPasswordValue)) {                               
                showInlineError('newPasswordError', 'Weak Password: Must be at least 8 characters and include uppercase, lowercase, a number, and a special character.');                          
                isValid = false;
            }
            if (newPasswordValue !== confirmPasswordValue) {
                showInlineError('confirmNewPasswordError', 'Passwords do not match!');
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
                return;
            }
        });
    }

    // For make 'visible' and 'hidden' the modal
    if (openModalBtn) {
        openModalBtn.addEventListener('click', () => {
            emailModal.classList.remove('hidden');
            emailModal.classList.add('flex');                                   
        });
    }
    
    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', () => {
            emailModal.classList.add('hidden');
            emailModal.classList.remove('flex');
            clearInterval(countdownInterval);                                 
            clearInlineErrors(); 
        });
    }

    // For display otp
    const otpBoxes = document.querySelectorAll('.otp-box');                   
    otpBoxes.forEach((item, index) => {                                      
        item.addEventListener('input', (e) => {                               
            if (e.target.value.length === 1 && index < otpBoxes.length - 1) { 
                otpBoxes[index + 1].focus();
            }
        });
        item.addEventListener('keydown', (e) => {                             
            if (e.key === 'Backspace' && !e.target.value && index > 0) {      
                otpBoxes[index - 1].focus();                                  
            }
        });
    });

    // For 'otp' count down
    function startCountdown() {
        let duration = 5 * 60;
        clearInterval(countdownInterval);
        countdownInterval = setInterval(() => {
            let minutes = Math.floor(duration / 60);
            let seconds = duration % 60;
            document.getElementById('timerText').innerText = `${minutes < 10 ? '0' + minutes : minutes}:${seconds < 10 ? '0' + seconds : seconds}`;
            if (--duration < 0) {
                clearInterval(countdownInterval);
                document.getElementById('timerText').innerText = "EXPIRED";
            }
        }, 1000);
    }

    // For email change
    const sendOtpBtn = document.getElementById('sendOtpBtn');
    if (sendOtpBtn) {
        sendOtpBtn.addEventListener('click', async () => {
            clearInlineErrors(); 
            let isValid = true;
            
            const newName = document.getElementById('newNameInput').value;       
            const newEmail = document.getElementById('newEmailInput').value;
            const password = passwordInput ? passwordInput.value : '';
            if (!newName.trim() || newName.trim().length < 3) {
                showInlineError('newNameError', 'Name must be at least 3 characters.');
                isValid = false;
            }
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(newEmail.trim())) {
                showInlineError('newEmailError', 'Please enter a valid email address.');
                isValid = false;
            }
            if (passwordInput && passwordInput.value !== 'google-user' && !password.trim()) {
                showInlineError('confirmPassModalError', 'Current password is required to save changes.');
                isValid = false;
            }          
            if (!isValid) return;             
            if (modalError) modalError.classList.add('hidden');            
            const response = await fetch('/profile/change-email-request', {    
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },               
                body: JSON.stringify({ newName, newEmail, password })
            });
            const data = await response.json();
            if (data.success) {
                stepEmail.classList.add('hidden');                             
                stepOtp.classList.remove('hidden');
                startCountdown();                                              
            } else {
                if (modalError) {
                    modalError.innerText = data.message;
                    modalError.classList.remove('hidden');
                }
            }
        });
    }

    // For send 'otp'
    const verifyOtpBtn = document.getElementById('verifyOtpBtn');
    if (verifyOtpBtn) {
        verifyOtpBtn.addEventListener('click', async () => {
            let combinedOtp = "";
            otpBoxes.forEach(item => combinedOtp += item.value);              
            if (modalError) modalError.classList.add('hidden');

            const response = await fetch('/profile/change-email-verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp: combinedOtp })
            });
            const data = await response.json();
            if (data.success) {
                window.location.reload(); 
            } else {
                if (modalError) {
                    modalError.innerText = data.message;
                    modalError.classList.remove('hidden');
                }
            }
        });
    }

    //  For upload profile picture
    const profilePicBtn = document.getElementById('editProfilePicBtn');     
    const profileImageInput = document.getElementById('profileImageInput'); 
    const avatarImg = document.getElementById('avatarImg');                 
    const avatarPlaceholder = document.getElementById('avatarPlaceholder'); 
    
    if (profilePicBtn && profileImageInput) {
        profilePicBtn.addEventListener('click', () => profileImageInput.click());         
        profileImageInput.addEventListener('change', async (e) => {               
            const imageFile = e.target.files[0];
            if (!imageFile) return;        
            const packetData = new FormData();
            packetData.append('profileImage', imageFile);
            
            try {
                const uploadRequest = await fetch('/profile/update-avatar', {
                    method: 'POST',
                    body: packetData
                });
                
                const result = await uploadRequest.json();
                if (result.success) {
                    if (avatarImg) {
                        avatarImg.src = result.imageUrl;
                        avatarImg.classList.remove('hidden');
                    }
                    if (avatarPlaceholder) avatarPlaceholder.classList.add('hidden');
                    window.location.reload();
                } else {
                    alert(result.message || "Error updating image.");
                }
            } catch (err) {
                console.error("Image upload exception sequence:", err);
                alert("Server image parsing fail loop.");
            }
        });
    }
});
</script>