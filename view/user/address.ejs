<div class="bg-yellow-500 text-white p-4 rounded mb-6"> Test: Should be yellow with white text  </div>  -->
<!-- Above both code are used for 'testing purpose' of tailwind css -->

<div class="w-full max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row gap-8">  <!-- 'w-full' means 'width full' and 'max-w-7xl' means 'maximum width is '7' 'extra large'(ie '1280 px') and 'mx-auto' means 'margin' in 'x' axis automatically ie 'automatically equalize the left and right margins' ie the 'tailwind' is 'mobile first' so if we 'not' mention 'prefix'(ie just 'flex flex-col' 'not' use 'md' for medium etc)it is for 'mobile' and if we specifically mention 'prefix'(Eg, 'md:flex-row') and 'px-4 py-10' , 'p - padding','x- axis','y-axis' and '4,8' are its scale and 'gap-8' means 'gap' between 'column' -->

    <%- include('userSidebar') %>                   <!-- '<%- include()' is the 'built-in' 'ejs' method(ie if we put '<%= %>' it display entire 'text' what we put inside it, but we write '<%- %>' it 'rendering' 'html'/ 'userSidebar.ejs' ie 'not' display entire code as it is) -->
  
    <main class="w-full flex-1">                    <!-- '<main>' is 'html' element and 'w-full' means 'width full' and 'flex-1' means remaining things(ie in left side we already put 'userSidebar') uses by 'one' if we use 'two' 'flex-1' it shares remaining space '50-50'-->
        <h1 class="text-3xl font-bold text-black mb-8">My Address</h1>

        <div class="bg-red-50 rounded-3xl p-6 md:p-8 shadow-sm border border-red-100">
            
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-800">
                    
                    <thead>
                        <tr class="border-b border-gray-300">
                            <th class="pb-4 font-bold w-[20%]">Full Name</th>
                            <th class="pb-4 font-bold w-[20%]">Phone</th>
                            <th class="pb-4 font-bold w-[30%]">Address</th>
                            <th class="pb-4 font-bold w-[10%]">Type</th>
                            <th class="pb-4 font-bold text-center w-[20%]">Actions</th>
                        </tr>
                    </thead>
                       
                    <tbody>
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach(address => { %>
                                <tr class="border-b border-gray-200 hover:bg-red-100 transition">
                                    
                                    <td class="py-5 pr-4 align-middle"><%= address.fullName %></td>
                                    
                                    <td class="py-5 pr-4 align-middle"><%= address.phone %></td>
                                    
                                    <td class="py-5 pr-4 align-middle max-w-[200px] text-gray-600">
                                        <%= address.addressLine %><br>
                                        <%= address.city %>, <%= address.state %> <%= address.pincode %>
                                    </td>

                                    <td class="py-5 pr-4 align-middle font-bold text-gray-800 uppercase tracking-wide">
                                        <%= address.type || 'OTHER' %>
                                    </td> 
                                    
                                    <td class="py-5 align-middle">
                                        <div class="flex items-center justify-center gap-2">
                                            
                                            <% if (address.isDefault) { %>
                                                <span class="bg-gray-400 text-white text-[10px] font-bold px-4 py-1.5 rounded-full cursor-not-allowed shadow-sm">Default</span>
                                            <% } else { %>
                                                <form action="/profile/address/default/<%= address._id %>" method="POST" class="inline">
                                                    <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition cursor-pointer shadow-sm">Set as Default</button>
                                                </form>
                                            <% } %>

                                            <a href="/profile/address/edit/<%= address._id %>" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition shadow-sm">Edit</a>
                                            
                                            <form action="/profile/address/delete/<%= address._id %>" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this address?');">
                                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition cursor-pointer shadow-sm">Delete</button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="py-12 text-center text-gray-500 font-medium">
                                    No addresses found. Click the button below to add your first address!
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-8 flex justify-center">
                <a href="/profile/address/add" class="bg-red-900 text-white hover:text-white hover:bg-red-950 font-bold py-2.5 px-8 rounded-full transition text-sm shadow-md inline-block">
                    Add New Address
                </a>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="mt-8 flex justify-center items-center gap-4 text-xs font-bold text-gray-600">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>" class="hover:text-black">&lt;</a>
                    <% } %>
                    
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>" class="<%= currentPage === i ? 'text-black text-sm' : 'hover:text-black' %>"><%= i %></a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>" class="hover:text-black">&gt;</a>
                    <% } %>
                </div>
            <% } %>

        </div>
    </main>
</div>