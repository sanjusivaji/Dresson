<div class="w-full max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row gap-8"> 
        <aside class="lg:col-span-3">
            <%- include('../partial/user/userSidebar') %>
        </aside>
    <main class="w-full flex-1">
        
        <%- include('../partial/shared/alertSuccess') %>
        <%- include('../partial/shared/alertError') %>
        <%- include('../partial/shared/warning') %>

        <div class="bg-red-50 rounded-3xl p-6 md:p-8 shadow-sm border border-red-100">            
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-800">                    
                    <thead>
                        <tr class="border-b border-gray-300">
                            <th class="pb-4 font-bold w-[20%]">Full Name</th>
                            <th class="pb-4 font-bold w-[20%]">Phone</th>
                            <th class="pb-4 font-bold w-[30%]">Address</th>
                            <th class="pb-4 font-bold w-[10%]">Type</th>
                            <th class="pb-4 font-bold text-center w-[20%]">Actions</th>
                        </tr>
                    </thead>                       
                    <tbody>
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach(item => { %>
                                <tr class="border-b border-gray-200 hover:bg-red-100 transition">                                    
                                    <td class="py-5 pr-4 align-middle"><%= item.fullName %></td>                                    
                                    <td class="py-5 pr-4 align-middle"><%= item.phone %></td>                                    
                                    <td class="py-5 pr-4 align-middle max-w-[200px] text-gray-600">
                                        <%= item.addressLine %><br>
                                        <%= item.city %>, <%= item.state %> <%= item.pincode %>
                                    </td>
                                    <td class="py-5 pr-4 align-middle font-bold text-gray-800 uppercase tracking-wide">
                                        <%= item.type || 'OTHER' %>
                                    </td>                                     
                                    <td class="py-5 align-middle">
                                        <div class="flex items-center justify-center gap-2">
                                            <% if (item.isDefault) { %>
                                                <span class="bg-gray-400 text-white text-[10px] font-bold px-4 py-1.5 rounded-full cursor-not-allowed shadow-sm">Default</span>
                                            <% } else { %>
                                                <form action="/profile/address/<%= item._id %>/set-default" method="POST" class="inline">
                                                    <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition cursor-pointer shadow-sm">
                                                        Set as Default
                                                    </button>
                                                </form>
                                            <% } %>

                                            <a href="/profile/address/edit/<%= item._id %>" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition shadow-sm">Edit</a>                                                                                
                                            <form action="/profile/address/delete/<%= item._id %>" method="POST" class="inline" onsubmit="handleDeleteConfirm(event, this);">
                                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold px-4 py-1.5 rounded-full transition cursor-pointer shadow-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="py-12 text-center text-gray-500 font-medium">
                                    No addresses found. Click the button below to add your first address!
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="mt-8 flex justify-center">
                <a href="/profile/address/add" class="bg-red-900 text-white hover:text-white hover:bg-red-950 font-bold py-2.5 px-8 rounded-full transition text-sm shadow-md inline-block">
                    Add New Address
                </a>
            </div>
            <div class="mt-8 flex justify-center">
                <%- include('../partial/admin/pagination', { 
                    currentPage: currentPage, 
                    totalPages: totalPages,
                    baseUrl: ''
                }) %>
            </div>
        </div>
    </main>
</div>


<script>
function handleDeleteConfirm(event, formElement) {
    event.preventDefault();
    showCustomConfirm(                                                     // This function created in 'view/partial/shared/warning.ejs' file
        'Are you sure you want to delete this address? This action cannot be undone.', 
        function() {
            formElement.submit();
        }, 
        'Delete Address?'
    );
}
</script>