<%- contentFor('body') %>
<!-- Shared Alerts Partial -->
<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<!-- Quick URL Error Catching Script -->
<% if (typeof query !== 'undefined' && query.error) { %>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof showCustomAlert === 'function') {
                showCustomAlert("<%= decodeURIComponent(query.error) %>", "Cart Action Blocked", "error");
            } else {
                alert("<%= decodeURIComponent(query.error) %>");
            }
        });
    </script>
<% } %>

<!-- Main Wrapper with Soft Background -->
<main class="min-h-[80vh] bg-[#fdfcfb] py-14 px-4 sm:px-6 lg:px-8 flex items-start justify-center font-sans selection:bg-gray-200">
    
    <!-- Premium Card Container -->
    <div class="w-full max-w-4xl bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 p-8 sm:p-12 transition-all">
        
        <!-- Heading -->
        <div class="flex items-end justify-between mb-10 pb-6 border-b border-gray-100">
            <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
                Shopping Cart
            </h1>
            <span class="text-sm font-bold text-gray-400 uppercase tracking-widest"><%= cart && cart.items ? cart.items.length : 0 %> Items</span>
        </div>

        <% if (cart && cart.items && cart.items.length > 0) { %>
            
            <!--  Banner Warning if Cart Contains Invalid/Sold-Out Items -->
            <% if (cart.hasInvalidItems) { %>
                <div class="mb-8 p-5 rounded-2xl bg-red-50 border border-red-100 flex items-start space-x-4 text-red-800 animate-fade-in shadow-sm">
                    <div class="bg-white p-2 rounded-full shadow-sm shrink-0">
                        <i class="fas fa-exclamation-triangle text-red-500 text-lg"></i>
                    </div>
                    <div class="text-sm font-medium pt-1 leading-relaxed">
                        <span class="font-bold text-red-900">Action Required:</span>
                        One or more items in your cart are currently out of stock or no longer available. Please remove them or adjust quantities to proceed to checkout.
                    </div>
                </div>
            <% } %>

            <!-- Cart Items List -->
            <div class="divide-y divide-gray-100/80" id="cartItemsContainer">
                <% cart.items.forEach(item => { %>
                    <!-- data-price and data-stock attributes for JS calculation -->
                    <div class="py-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6 group transition duration-300 hover:bg-gray-50/50 rounded-2xl -mx-4 px-4 <%= !item.isValid ? 'bg-red-50/40 border-x border-red-50' : '' %>" 
                         id="cart-row-<%= item._id %>"
                         data-price="<%= item.livePrice %>"
                         data-stock="<%= item.liveStock %>">
                       
                        <!--  Thumbnail & Product Specifications -->
                        <div class="flex items-center space-x-6 flex-1 min-w-0">
                            <!-- Thumbnail -->
                            <a href="/product/<%= item.product._id %>" class="w-24 h-32 rounded-2xl overflow-hidden bg-gray-50 border border-gray-200/60 shrink-0 block relative shadow-sm">
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-500 ease-out">
                                <% if (!item.isValid) { %>
                                    <div class="absolute inset-0 bg-white/60 backdrop-blur-[2px] flex items-center justify-center">
                                        <i class="fas fa-ban text-red-500 text-2xl drop-shadow-md"></i>
                                    </div>
                                <% } %>
                            </a>

                            <!-- Details -->
                            <div class="flex-1 min-w-0 py-2">
                                <a href="/product/<%= item.product._id %>" class="text-lg font-bold text-gray-900 truncate block hover:text-gray-600 transition duration-200">
                                    <%= item.name %>
                                </a>
                                
                                <!-- Variant Attributes Below Title -->
                                <p class="text-[11px] text-gray-500 font-bold mt-1.5 uppercase tracking-widest truncate">
                                    <%= item.variantName.replace(/\//g, '•') %>
                                </p>
                                
                                <!-- Price Display -->
                                <div class="mt-4 flex items-end space-x-3">
                                    <span class="text-lg font-black text-gray-900 tracking-tight" id="item-total-<%= item._id %>">
                                        ₹ <%= (item.livePrice * item.quantity).toLocaleString('en-IN') %>
                                    </span>
                                    <span class="text-xs font-semibold text-gray-400 mb-0.5" id="item-each-<%= item._id %>" style="display: <%= item.quantity > 1 ? 'inline' : 'none' %>;">
                                        (₹ <%= item.livePrice.toLocaleString('en-IN') %> each)
                                    </span>
                                </div>

                                <!-- Dynamic Status Badges for Invalid Items -->
                                <% if (item.isUnlisted) { %>
                                    <span class="inline-block mt-3 px-3 py-1 bg-red-50 border border-red-100 text-red-600 text-[10px] font-extrabold rounded-md uppercase tracking-widest shadow-sm">Unlisted by Admin</span>
                                <% } else if (item.isOutOfStock) { %>
                                    <span class="inline-block mt-3 px-3 py-1 bg-red-50 border border-red-100 text-red-600 text-[10px] font-extrabold rounded-md uppercase tracking-widest shadow-sm">Sold Out</span>
                                <% } else if (item.isExceedingStock) { %>
                                    <span class="inline-block mt-3 px-3 py-1 bg-amber-50 border border-amber-200 text-amber-700 text-[10px] font-extrabold rounded-md uppercase tracking-widest shadow-sm">Only <%= item.liveStock %> units available</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Right Side: Quantity Pill & Trash Icon -->
                        <div class="flex flex-col sm:flex-row items-end sm:items-center gap-4 sm:gap-8 shrink-0">
                            
                            <!-- Quantity Pill Selector -->
                            <% if (item.isValid) { %>
                                <div class="flex items-center bg-white border border-gray-200 rounded-xl overflow-hidden h-10 shadow-sm">
                                    
                                    <!-- Button for decrease quantity -->
                                    <button type="button" 
                                            id="btn-minus-<%= item._id %>"
                                            onclick="updateCartQty('<%= item._id %>', <%= item.quantity - 1 %>)" 
                                            class="w-10 h-full text-gray-500 hover:text-gray-900 hover:bg-gray-50 font-bold transition flex items-center justify-center text-sm cursor-pointer <%= item.quantity <= 1 ? 'opacity-30 cursor-not-allowed hover:bg-white' : '' %>">
                                        <i class="fas fa-minus text-[10px]"></i>
                                    </button>
                                    
                                    <span class="w-10 text-center font-bold text-sm text-gray-900 select-none border-x border-gray-100 py-2 flex items-center justify-center bg-gray-50/50" id="qty-val-<%= item._id %>">
                                        <%= item.quantity %>
                                    </span>
                                    
                                    <!-- Button for update quantity-->
                                    <button type="button" 
                                            id="btn-plus-<%= item._id %>"
                                            onclick="updateCartQty('<%= item._id %>', <%= item.quantity + 1 %>)" 
                                            class="w-10 h-full text-gray-500 hover:text-gray-900 hover:bg-gray-50 font-bold transition flex items-center justify-center text-sm cursor-pointer <%= item.quantity >= Math.min(10, item.liveStock) ? 'opacity-30 cursor-not-allowed hover:bg-white' : '' %>">
                                        <i class="fas fa-plus text-[10px]"></i>
                                    </button>
                                </div>
                            <% } else { %>
                                <span class="text-[11px] font-black text-red-500 uppercase tracking-widest bg-red-50 px-3 py-1.5 rounded-lg border border-red-100">Unavailable</span>
                            <% } %>

                            <!-- Trash / Delete Icon -->
                            <button type="button" 
                                    onclick="removeCartItem('<%= item._id %>', '<%= item.name.replace(/'/g, "\\'") %>')" 
                                    class="w-10 h-10 rounded-full bg-white border border-gray-200 text-gray-400 hover:text-red-500 hover:border-red-200 hover:bg-red-50 hover:shadow-sm transition-all duration-200 flex items-center justify-center cursor-pointer"
                                    title="Remove Item">
                                <i class="far fa-trash-can text-sm"></i>
                            </button>

                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Footer / Total Section -->
            <div class="mt-10 pt-8 border-t-2 border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-8">
                
                <!-- Total Display -->
                <div class="flex items-center space-x-6 w-full sm:w-auto justify-between sm:justify-start">
                    <span class="text-sm font-bold text-gray-400 uppercase tracking-widest">Subtotal</span>
                    <span id="cartTotalDisplay" class="text-3xl font-black text-gray-900 tracking-tight">
                        ₹ <%= cart.cartTotal.toLocaleString('en-IN') %>
                    </span>
                </div>

                <!-- Checkout Button -->
                <div class="w-full sm:w-auto flex flex-col items-center">
                    <a href="<%= !cart.hasInvalidItems ? '/checkout' : '#' %>" 
                       id="checkoutBtnCTA"
                       class="w-full sm:w-auto py-4 px-12 rounded-full font-black text-sm text-white text-center transition-all duration-300 shadow-lg flex items-center justify-center space-x-3 uppercase tracking-widest <%= cart.hasInvalidItems ? 'bg-gray-300 opacity-70 cursor-not-allowed pointer-events-none' : 'bg-gray-900 hover:bg-black hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 cursor-pointer' %>">
                        <span>Secure Checkout</span>
                        <i class="fas fa-arrow-right text-[11px]"></i>
                    </a>

                    <% if (cart.hasInvalidItems) { %>
                        <span class="text-[11px] font-bold text-red-500 mt-3 text-center uppercase tracking-wider">
                            Remove unavailable items to proceed
                        </span>
                    <% } %>
                </div>

            </div>

        <% } else { %>
            
            <!-- Empty cart state (Sleek update) -->
            <div class="py-20 text-center flex flex-col items-center justify-center">
                <div class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mb-6 text-gray-300 border border-gray-100 shadow-inner">
                    <i class="fas fa-shopping-bag text-3xl"></i>
                </div>
                <h3 class="text-2xl font-black text-gray-900 mb-2 tracking-tight">Your cart is empty</h3>
                <p class="text-sm text-gray-500 max-w-sm mx-auto mb-8 leading-relaxed">Looks like you haven't added anything yet. Discover our latest premium collections.</p>
                
                <a href="/shop" class="inline-flex items-center px-8 py-3.5 rounded-full bg-gray-900 hover:bg-black text-white text-xs font-black uppercase tracking-widest transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5">
                    <span>Explore Collection</span>
                </a>
            </div>

        <% } %>

    </div>
</main>


<!-- Logic remains 100% untouched to preserve functionality -->
<script>
    // Asynchronous Quantity Update WITHOUT page reload
    async function updateCartQty(itemId, newQty) {
        const rowElement = document.getElementById(`cart-row-${itemId}`);
        const maxStock = parseInt(rowElement.getAttribute('data-stock'), 10);
        const maxAllowed = Math.min(10, maxStock); 

        if (newQty < 1) {
            return;
        }       
        
        if (newQty > maxAllowed) {
            if (typeof showCustomAlert === 'function') {
                showCustomAlert(`You can only purchase up to ${maxAllowed} units of this item.`, "Stock Limit Reached", "warning");
            } else {
                alert(`You can only purchase up to ${maxAllowed} units of this item.`);
            }
            return; 
        }

        try {
            const response = await fetch('/cart/update-quantity', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemId, quantity: newQty })
            });

            const data = await response.json();

            if (data.success) {
                document.getElementById(`qty-val-${itemId}`).innerText = newQty;

                const pricePerItem = parseFloat(rowElement.getAttribute('data-price'));
                const newItemTotal = pricePerItem * newQty;
                document.getElementById(`item-total-${itemId}`).innerText = `₹ ${newItemTotal.toLocaleString('en-IN')}`;

                const eachLabel = document.getElementById(`item-each-${itemId}`);
                if (eachLabel) eachLabel.style.display = newQty > 1 ? 'inline' : 'none';

                let newCartTotal = 0;
                document.querySelectorAll('[id^="cart-row-"]').forEach(row => {
                    const rPrice = parseFloat(row.getAttribute('data-price'));
                    const rQtyText = row.querySelector('[id^="qty-val-"]');
                    if (rQtyText && !isNaN(rPrice)) {
                        const rQty = parseInt(rQtyText.innerText, 10);
                        newCartTotal += (rPrice * rQty);
                    }
                });
                
                document.getElementById('cartTotalDisplay').innerText = `₹ ${newCartTotal.toLocaleString('en-IN')}`;

                const btnMinus = document.getElementById(`btn-minus-${itemId}`);
                const btnPlus = document.getElementById(`btn-plus-${itemId}`);

                if (newQty <= 1) {
                    btnMinus.classList.add('opacity-30', 'cursor-not-allowed', 'hover:bg-white');
                } else {
                    btnMinus.classList.remove('opacity-30', 'cursor-not-allowed', 'hover:bg-white');
                }

                if (newQty >= maxAllowed) {
                    btnPlus.classList.add('opacity-30', 'cursor-not-allowed', 'hover:bg-white');
                } else {
                    btnPlus.classList.remove('opacity-30', 'cursor-not-allowed', 'hover:bg-white');
                }

                btnMinus.setAttribute('onclick', `updateCartQty('${itemId}', ${newQty - 1})`);
                btnPlus.setAttribute('onclick', `updateCartQty('${itemId}', ${newQty + 1})`);

            } else {
                if (typeof showCustomAlert === 'function') {
                    showCustomAlert(data.message || "Could not update quantity.", "Stock Restriction", "warning");
                } else {
                    alert(data.message);
                }
            }
        } catch (error) {
            console.error("Failed to sync quantity:", error);
            if (typeof showCustomAlert === 'function') {
                showCustomAlert("Network error while updating cart. Please try again.", "Connection Error", "error");
            } else {
                alert("Network error while updating cart.");
            }
        }
    }

    function removeCartItem(itemId, itemName) {
        const confirmMsg = `Are you sure you want to remove "${itemName}" from your shopping cart?`;

        const executeDelete = async () => {
            try {
                const response = await fetch(`/cart/remove/${itemId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.success) {
                    const rowEl = document.getElementById(`cart-row-${itemId}`);
                    if (rowEl) {
                        rowEl.style.transition = 'all 0.3s ease';
                        rowEl.style.opacity = '0';
                        rowEl.style.transform = 'translateX(20px)';
                    }
                    setTimeout(() => window.location.reload(), 250);
                } else {
                    if (typeof showCustomAlert === 'function') {
                        showCustomAlert(data.message || "Could not remove item.", "Error", "error");
                    } else {
                        alert(data.message || "Could not remove item.");
                    }
                }
            } catch (error) {
                console.error("Delete request error:", error);
                alert("Network error while removing item.");
            }
        };

        if (typeof showCustomConfirm === 'function') {
            showCustomConfirm(confirmMsg, executeDelete, "Remove Item?");
        } else if (confirm(confirmMsg)) {
            executeDelete();
        }
    }
</script>