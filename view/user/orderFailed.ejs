<%- contentFor('body') %>

<!-- Razorpay Script for Retry -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<!-- Custom Toast Container (Reused for consistency) -->
<div id="toast-container" class="fixed top-20 right-5 z-[100] flex flex-col gap-2"></div>

<main class="max-w-3xl mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-10 flex flex-col items-center">
        
        <!-- Failure Icon -->
        <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mb-6">
            <i class="fas fa-times text-5xl text-red-500"></i>
        </div>

        <h1 class="text-3xl font-black text-gray-900 mb-2 tracking-tight">Payment Failed</h1>
        <p class="text-sm font-semibold text-gray-500 mb-8 max-w-md">
            Don't worry! Your order has been saved, but we couldn't process the payment. You can retry your payment below to secure your items.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 w-full max-w-sm">
            <button type="button" id="retryPaymentBtn" class="flex-1 py-3.5 bg-[#3da436] hover:bg-green-700 text-white text-sm font-black uppercase tracking-wider rounded-lg shadow-md transition">
                <i class="fas fa-redo-alt mr-2"></i> Retry Payment
            </button>
            <a href="/profile/orders" class="flex-1 py-3.5 bg-gray-900 hover:bg-gray-800 text-white text-sm font-black uppercase tracking-wider rounded-lg shadow-md transition text-center">
                View Orders
            </a>
        </div>
    </div>
</main>

<script>
    // Custom Toast function
    function showCustomAlert(message, type = 'error') {
        const toastContainer = document.getElementById('toast-container');
        const toast = document.createElement('div');        
        toast.className = `min-w-[280px] p-4 rounded-lg shadow-xl transform transition-all duration-300 translate-x-full flex items-center gap-3 text-sm font-bold text-white border-l-4`;        
        if (type === 'error') {
            toast.classList.add('bg-gray-900', 'border-red-500');
            toast.innerHTML = `<i class="fas fa-exclamation-circle text-red-400 text-lg"></i> <span>${message}</span>`;
        } else {
            toast.classList.add('bg-gray-900', 'border-green-500');
            toast.innerHTML = `<i class="fas fa-check-circle text-green-400 text-lg"></i> <span>${message}</span>`;
        }
        toastContainer.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-x-full'), 10);
        setTimeout(() => {
            toast.classList.add('translate-x-full');
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    document.getElementById('retryPaymentBtn').addEventListener('click', async function() {
        const orderId = "<%= orderId %>"; // Passed from controller
        this.disabled = true;
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Loading...';

        try {
            const response = await fetch('/checkout/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId })
            });
            const data = await response.json();

            if (!data.success) {
                showCustomAlert(data.message || "Could not initiate retry.", "error");
                this.disabled = false;
                this.innerHTML = originalText;
                return;
            }

            const options = {
                "key": data.key, 
                "amount": data.razorpayOrder.amount, 
                "currency": "INR",
                "name": "Dresson",
                "description": "Order Payment Retry",
                "order_id": data.razorpayOrder.id,
                "handler": async function (response) {
                    try {
                        const verifyRes = await fetch('/checkout/verify-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_signature: response.razorpay_signature,
                                orderId: data.orderId
                            })
                        });
                        const verifyData = await verifyRes.json();                            
                        if (verifyData.success) {
                            window.location.href = `/order-success?id=${data.orderId}`;
                        } else {
                            showCustomAlert("Verification failed: " + verifyData.message, "error");
                            document.getElementById('retryPaymentBtn').disabled = false;
                            document.getElementById('retryPaymentBtn').innerHTML = originalText;
                        }
                    } catch (err) {
                        showCustomAlert("Error verifying payment!", "error");
                        document.getElementById('retryPaymentBtn').disabled = false;
                        document.getElementById('retryPaymentBtn').innerHTML = originalText;
                    }
                },
                "modal": {
                    "ondismiss": function() {
                        showCustomAlert("Payment cancelled.", "error");
                        document.getElementById('retryPaymentBtn').disabled = false;
                        document.getElementById('retryPaymentBtn').innerHTML = originalText;
                    }
                },
                "theme": { "color": "#fc6c6c" }
            };                    
            
            const rzp1 = new Razorpay(options);
            rzp1.on('payment.failed', function (response){
                showCustomAlert("Payment Failed: " + response.error.description, "error");
                document.getElementById('retryPaymentBtn').disabled = false;
                document.getElementById('retryPaymentBtn').innerHTML = originalText;
            });
            rzp1.open();

        } catch (error) {
            console.error(error);
            showCustomAlert("Network error occurred.", "error");
            this.disabled = false;
            this.innerHTML = originalText;
        }
    });
</script>