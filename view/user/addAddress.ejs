<div class="w-full max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row gap-8">

    <%- include('userSidebar') %>
  
    <main class="w-full flex-1">
        
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-black">Add New Address</h1>
            <a href="/profile/address" class="bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold py-2 px-4 rounded-md transition shadow-sm border border-gray-300">
                Back to Address
            </a>
        </div>

        <div class="bg-white rounded-xl max-w-2xl">
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 shadow-sm">
                    <p class="font-bold">Error</p>
                    <p><%= error %></p>
                </div>
            <% } %>

            <form action="/profile/address/add" method="POST" class="space-y-6">
                
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" name="fullName" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                    <input type="text" name="phone" required pattern="[0-9]{10,15}" title="Please enter a valid phone number" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">Street Address</label>
                    <input type="text" name="streetAddress" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">City</label>
                    <input type="text" name="city" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">State</label>
                    <input type="text" name="state" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">Pin Codes</label>
                    <input type="text" name="pinCode" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1">Country</label>
                    <input type="text" name="country" required value="India" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                </div>

                <div class="flex justify-start gap-4 pt-2">
                    <label class="cursor-pointer">
                        <input type="radio" name="type" value="HOME" class="peer sr-only" checked required>
                        <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">HOME</div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="type" value="WORK" class="peer sr-only">
                        <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">WORK</div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="type" value="OTHER" class="peer sr-only">
                        <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">OTHERS</div>
                    </label>
                </div>

                <div class="flex items-center gap-2 pt-2 pb-4">
                    <input type="checkbox" name="isDefault" id="isDefault" class="w-4 h-4 text-red-900 focus:ring-red-900 border-gray-300 rounded cursor-pointer">
                    <label for="isDefault" class="text-sm font-medium text-gray-700 cursor-pointer">Make this Default</label>
                </div>

                <div class="flex justify-center gap-4 pt-4">
                    <div class="flex justify-center gap-4 pt-4">
                    
                    <button type="submit" class="bg-red-900 text-white hover:text-white hover:bg-red-950 font-bold py-3 px-8 rounded-full transition text-sm shadow-md cursor-pointer uppercase tracking-wider">
                        Save Address
                    </button>
                    
                    <a href="/profile/address" class="bg-black text-white hover:text-white hover:bg-gray-800 font-bold py-3 px-8 rounded-full transition text-sm shadow-md cursor-pointer uppercase tracking-wider flex items-center">
                        Cancel
                    </a>
                    
                </div>
            

            </form>
        </div>
    </main>
</div>