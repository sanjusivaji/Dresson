<div class="w-full flex-1 flex items-center justify-center bg-white p-4">
    
    <div class="w-full max-w-md p-8">
        <h1 class="text-3xl font-bold text-center text-black mb-10">Create Account</h1>

        <form action="/signup" method="POST" class="space-y-5">
            
            <div class="flex flex-col">
                <label class="text-xs font-bold text-gray-700 mb-1">Name</label>
                <input type="text" name="name" required minlength="3" pattern="[A-Za-z\s]+" title="Name must be at least 3 characters and contain only letters." class="bg-gray-200 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-gray-400">
            </div>

            <div class="flex flex-col">
                <label class="text-xs font-bold text-gray-700 mb-1">Email Address</label>
                <input type="email" name="email" required pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" title="Please enter a valid email address." class="bg-gray-200 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-gray-400">
            </div>

            <div class="flex flex-col">
                <label class="text-xs font-bold text-gray-700 mb-1">Password</label>
                <div class="relative w-full">
                   <input type="password" name="password" id="password" required pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}" title="Password must be at least 8 characters long, include an uppercase letter, a lowercase letter, a number, and a special character." class="bg-gray-200 rounded-md px-4 py-3 w-full pr-10 focus:outline-none focus:ring-2 focus:ring-gray-400">
                    
                    <i class="fas fa-eye absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer text-gray-500 hover:text-gray-800 transition" onclick="togglePassword('password', this)"></i>
                </div>
            </div>

            <div class="flex flex-col">
                <label class="text-xs font-bold text-gray-700 mb-1">Confirm Password</label>
                <div class="relative w-full">
                    <input type="password" name="confirmPassword" id="confirmPassword" required class="bg-gray-200 rounded-md px-4 py-3 w-full pr-10 focus:outline-none focus:ring-2 focus:ring-gray-400">
                    
                    <i class="fas fa-eye absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer text-gray-500 hover:text-gray-800 transition" onclick="togglePassword('confirmPassword', this)"></i>
                </div>
            </div>

            <div class="flex flex-col mb-4">
                <label class="text-xs font-bold text-gray-700 mb-1">Referral Code(Optional)</label>
                <input type="text" name="referralCode" class="bg-gray-200 rounded-md px-4 py-3 focus:outline-none focus:ring-2 focus:ring-gray-400">
            </div>

            <button type="submit" class="w-full bg-[#208b59] hover:bg-[#1a734a] text-white font-bold py-3 rounded-lg mt-6 transition shadow-sm cursor-pointer">
                Sign Up
            </button>
        </form>

        <div class="mt-8 mb-4">
            <a href="/auth/google" class="block w-full">
                <button type="button" class="w-full bg-[#e0e0e0] hover:bg-gray-300 text-gray-800 font-bold py-3 rounded-xl transition shadow-sm mt-4 text-sm flex justify-center items-center gap-2 cursor-pointer">
                    <i class="fab fa-google text-red-500"></i> Continue with Google
                </button>
            </a>
        </div>
        
        <div class="mt-6 text-center text-xs font-bold text-gray-600">
            Already have an account? <a href="/login" class="text-[#208b59] hover:underline">Log in</a>
        </div>
    </div>

</div>

<script>
    function togglePassword(inputId, icon) {
        const input = document.getElementById(inputId);
        
        if (input.type === 'password') {
            // Show the password
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash'); // Changes to the crossed-out eye
        } else {
            // Hide the password
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye'); // Changes back to the normal eye
        }
    }
</script>