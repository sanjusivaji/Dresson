<%- contentFor('body') %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white font-sans">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-8 border-b border-gray-200 pb-4">
        <h1 class="text-2xl font-bold text-gray-900 tracking-wide">Return Details</h1>
        <a href="/profile/orders/<%= order._id %>" class="px-5 py-2 text-xs font-semibold text-gray-600 bg-white hover:bg-gray-50 border border-gray-300 rounded-md transition shadow-sm">
            Back to Order
        </a>
    </div>

    <!-- Return Meta Info -->
    <div class="mb-10 text-sm space-y-3 text-gray-700 font-medium">
        <div class="flex">
            <span class="w-32 text-gray-500">Status</span>
            <span>: <span class="text-orange-400 font-bold">Pending</span></span>
        </div>
        <div class="flex">
            <span class="w-32 text-gray-500">Pick up date</span>
            <span>: <%= pickUpDate %></span>
        </div>
        <div class="flex">
            <span class="w-32 text-gray-500">Order ID</span>
            <span>: <%= order.orderId %></span>
        </div>
    </div>

    <!-- Returned Items Section -->
    <div class="mb-12 space-y-6">
        <% order.items.forEach(item => { %>
            <% 
                const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                const variantDisplay = variantParts.join(' '); 
                const productName = item.product.productName || item.product.name || 'Dresson Product';
            %>
            <div class="flex items-start space-x-6">
                <img src="<%= item.product.images[0]?.url || '/images/default-product.jpg' %>" alt="Product Image" class="w-16 h-24 object-cover rounded shadow-sm border border-gray-100">
                <div class="text-xs space-y-1 text-gray-600 font-medium mt-1">
                    <h3 class="text-sm font-bold text-gray-800 mb-1"><%= productName %></h3>
                    <p>Quantity: <%= item.quantity %></p>
                    <p><%= variantDisplay %></p>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Selected Address Box -->
    <div class="border border-gray-300 rounded-lg p-5 max-w-sm">
        <h2 class="text-xs font-bold text-gray-800 mb-2">Selected Address</h2>
        <div class="text-xs text-gray-500 font-medium space-y-1 leading-relaxed">
            <p><%= order.shippingAddress.fullName %></p>
            <p><%= order.shippingAddress.addressLine %></p>
            <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %></p>
            <p>Pin: <%= order.shippingAddress.pincode %></p>
            <p class="mt-2">Mobile: <%= order.shippingAddress.phone %></p>
        </div>
    </div>

</main>