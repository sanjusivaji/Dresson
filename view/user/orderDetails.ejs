<%- contentFor('body') %>

<!-- Shared Alerts -->
<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-10">
        <h1 class="text-2xl font-bold text-gray-900 tracking-wide">Order Details</h1>
        <a href="/profile/orders" class="px-5 py-2 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-md transition shadow-sm">
            Back to Order
        </a>
    </div>

    <!-- Order Meta Info -->
    <div class="mb-10 text-sm space-y-1.5 text-gray-700 font-medium">
        <div class="flex">
            <span class="w-28 text-gray-500">Order ID</span>
            <span>: <%= order.orderId %></span>
        </div>
        <div class="flex">
            <span class="w-28 text-gray-500">Order Status</span>
            <span>: <span class="font-bold text-gray-900"><%= order.deliveryStatus %></span></span>
        </div>
        <div class="flex">
            <span class="w-28 text-gray-500">Order Date</span>
            <span>: <%= formattedDate %></span>
        </div>
    </div>

    <!-- Order Items Section -->
    <div class="mb-10">
        <h2 class="text-sm font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2">Order Item</h2>
        
        <div class="space-y-6">
            <% order.items.forEach(item => { %>
                <% 
                    // Split variant string "S / Black / 100% Cotton" for display
                    const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                    const size = variantParts[0] || 'N/A';
                    const color = variantParts[1] || 'N/A';
                    const fabric = variantParts[2] || 'N/A';
                %>
                <div class="flex items-start justify-between">
                    <div class="flex space-x-6">
                        <img src="<%= item.product.images && item.product.images[0] ? item.product.images[0].url : '/images/default-product.jpg' %>" alt="Product Image" class="w-20 h-28 object-cover rounded-md shadow-sm border border-gray-100">
                        <div class="text-xs space-y-1 text-gray-600 font-medium">
                            <!-- Fixed Product Name Check -->
                            <h3 class="text-sm font-bold text-gray-900 mb-1"><%= item.product.productName || item.product.name || 'Dresson Product' %></h3>
                            <p>Quantity: <%= item.quantity %></p>
                            <p>Size: <%= size %></p>
                            <p>Color: <%= color %></p>
                            <p>Fabric: <%= fabric %></p>
                        </div>
                    </div>
                    
                    <% if (order.deliveryStatus === 'Delivered') { %>
                        <a href="/product/rate/<%= item.product._id %>" class="bg-black text-white px-6 py-2 rounded-full font-bold text-sm hover:bg-gray-800 transition">
                            Rate Your Product
                        </a>
                        <!-- <button class="px-4 py-1.5 bg-yellow-400 hover:bg-yellow-500 text-[10px] font-bold text-gray-900 rounded-full shadow-sm transition">
                            Rate Your Product
                        </button> -->
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Shipping Address -->
    <div class="mb-10">
        <h2 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-200 pb-2">Shipping Address</h2>
        <div class="text-xs text-gray-600 font-medium space-y-1 leading-relaxed">
            <p class="font-bold text-gray-800 text-sm"><%= order.shippingAddress.fullName %></p>
            <p><%= order.shippingAddress.addressLine %></p>
            <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %></p>
            <p>Pin: <%= order.shippingAddress.pincode %></p>
            <p class="mt-1">Mobile: <%= order.shippingAddress.phone %></p>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="mb-12">
        <h2 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-200 pb-2">Order Summary</h2>
        <div class="w-full max-w-sm text-xs font-medium text-gray-600 space-y-2">
            <div class="flex justify-between">
                <span>Total</span>
                <span>: ₹<%= summary.subTotal.toFixed(2) %></span>
            </div>
            <div class="flex justify-between">
                <span>TAX</span>
                <span>: ₹<%= summary.tax.toFixed(2) %></span>
            </div>
            <div class="flex justify-between">
                <span>Shipping</span>
                <span>: ₹<%= summary.shipping.toFixed(2) %></span>
            </div>
            <% if (summary.discount > 0) { %>
            <div class="flex justify-between text-red-500">
                <span>Discount</span>
                <span>: -₹<%= summary.discount.toFixed(2) %></span>
            </div>
            <% } %>
            <div class="flex justify-between font-bold text-sm text-gray-900 pt-2 border-t border-gray-100 mt-2">
                <span>Grand Total</span>
                <span>: ₹<%= summary.grandTotal.toFixed(2) %></span>
            </div>
        </div>
    </div>

    <!-- Unified Action Buttons -->
    <!-- Only show this whole button section if the order is Active or Delivered -->
    <% if (order.deliveryStatus !== 'Returned' && order.deliveryStatus !== 'Cancelled') { %>
        
        <div class="flex flex-wrap justify-center items-center gap-4 border-t border-gray-200 pt-8 mb-8">
            
            <!-- Cancel Button (Only if not delivered yet) -->
            <% if (order.deliveryStatus !== 'Delivered') { %>
                <form action="/profile/orders/<%= order._id %>/cancel" method="POST" onsubmit="confirmOrderCancellation(event, this)">
                    <button type="submit" class="px-6 py-2 bg-[#4a2e35] hover:bg-[#3a2329] text-white text-xs font-semibold rounded-full shadow-md transition">
                        Cancel Order
                    </button>
                </form>
            <% } %>

            <!-- Return Button & Invoice (Only if Delivered) -->
            <% if (order.deliveryStatus === 'Delivered') { %>
                
                <!-- Return Button Logic -->
                <% if (!order.returnRequest || !order.returnRequest.isRequested) { %>
                    <button onclick="document.getElementById('returnModal').classList.remove('hidden')" class="px-6 py-2 bg-[#b68c96] hover:bg-[#9c757f] text-white text-xs font-semibold rounded-full shadow-md transition">
                        Return Product
                    </button>
                <% } else if (order.returnRequest && order.returnRequest.status === 'Pending') { %>
                    <!-- Show pending status pill -->
                    <span class="px-6 py-2 bg-gray-200 text-gray-700 text-xs font-bold rounded-full cursor-not-allowed">
                        Return Pending
                    </span>
                <% } %>

                <!-- Invoice Button -->
                <a href="/profile/orders/<%= order._id %>/invoice" target="_blank" class="px-6 py-2 bg-[#a35e6c] hover:bg-[#8b4e5a] text-white text-xs font-semibold rounded-full shadow-md transition text-center">
                    View / Download Invoice
                </a>

            <% } %>
        </div>

        <!-- The Tailwind Return Modal (Hidden by default) -->
        <div id="returnModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex justify-center items-center px-4 transition-opacity">
            <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-xl transform scale-100 transition-transform">
                <div class="flex justify-between items-center border-b border-gray-100 pb-4 mb-4">
                    <h3 class="text-lg font-bold text-gray-900">Return Product</h3>
                    <button type="button" onclick="document.getElementById('returnModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 transition">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
                
                <form action="/profile/orders/<%= order._id %>/return" method="POST">
                    <p class="text-sm text-gray-600 mb-4">Please let us know why you are returning this order. This action cannot be undone.</p>
                    <div class="mb-6">
                        <label for="reason" class="block text-xs font-bold text-gray-700 mb-2">Reason for return <span class="text-red-500">*</span></label>
                        <select name="reason" id="reason" required class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#b68c96]">
                            <option value="" disabled selected>Select a reason...</option>
                            <option value="Wrong size">Wrong size</option>
                            <option value="Product damaged or defective">Product damaged or defective</option>
                            <option value="Item not as described">Item not as described</option>
                            <option value="Changed my mind">Changed my mind</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="flex justify-end gap-3">
                        <button type="button" onclick="document.getElementById('returnModal').classList.add('hidden')" class="px-5 py-2 text-xs font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-md transition">
                            Cancel
                        </button>
                        <button type="submit" class="px-5 py-2 text-xs font-bold text-white bg-[#b68c96] hover:bg-[#9c757f] rounded-md transition shadow-sm">
                            Confirm Return
                        </button>
                    </div>
                </form>
            </div>
        </div>
    <% } %>

    <!-- Return Status Notification Banner -->
    <% if (order.returnRequest && order.returnRequest.status === 'Refunded') { %>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-8 flex items-start gap-4 shadow-sm mt-8">
            <!-- Info Icon -->
            <div class="text-blue-500 mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
                </svg>
            </div>
            
            <!-- Message Content -->
            <div class="flex-1">
                <h4 class="text-sm font-bold text-blue-900 mb-1">Return Approved & Refund Initiated</h4>
                <p class="text-[13px] text-blue-800 leading-relaxed font-medium">
                    Your return request has been processed successfully. A refund of <strong>₹<%= order.totalAmount %></strong> will reflect in your original payment method within <strong>5 to 7 working days</strong>.
                </p>
                
                <!-- Display the Admin's Custom Message if it exists -->
                <% if (order.returnRequest.adminMessage) { %>
                    <div class="mt-3 p-3 border-l-4 border-blue-400 bg-blue-100/50 rounded-r-md">
                        <p class="text-xs text-blue-900 font-semibold mb-1">Note from Dresson Support:</p>
                        <p class="text-[13px] text-blue-800 italic">"<%= order.returnRequest.adminMessage %>"</p>
                    </div>
                <% } %>
            </div>
        </div>
    <% } else if (order.returnRequest && order.returnRequest.status === 'Rejected') { %>
        <!-- Red banner if the return was rejected -->
        <div class="bg-red-50 border border-red-200 rounded-xl p-5 mb-8 flex items-start gap-4 shadow-sm mt-8">
            <div class="text-red-500 mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="flex-1">
                <h4 class="text-sm font-bold text-red-900 mb-1">Return Request Declined</h4>
                <% if (order.returnRequest.adminMessage) { %>
                    <p class="text-[13px] text-red-800 leading-relaxed font-medium">
                        <%= order.returnRequest.adminMessage %>
                    </p>
                <% } else { %>
                    <p class="text-[13px] text-red-800 leading-relaxed font-medium">
                        Unfortunately, your return request could not be approved at this time.
                    </p>
                <% } %>
            </div>
        </div>
    <% } %>

</main>


<script>
    function confirmOrderCancellation(event, formElement) {
        // 1. Stop the form from submitting instantly
        event.preventDefault(); 
        
        // 2. Call your custom confirmation modal from warning.ejs
        showCustomConfirm(
            'Are you sure you want to cancel this order? This action cannot be undone.', 
            function() {
                // 3. If they clicked Yes, submit the form to the backend
                formElement.submit();
            }, 
            'Cancel Order?'
        );
    }
</script>