<%- contentFor('body') %>

<!-- Shared Alerts -->
<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-10">
        <h1 class="text-2xl font-bold text-gray-900 tracking-wide">Order Details</h1>
        <a href="/profile/orders" class="px-5 py-2 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-md transition shadow-sm">
            Back to Order
        </a>
    </div>

    <!-- Order Meta Info -->
    <div class="mb-10 text-sm space-y-1.5 text-gray-700 font-medium">
        <div class="flex">
            <span class="w-28 text-gray-500">Order ID</span>
            <span>: <%= order.orderId %></span>
        </div>
        <div class="flex">
            <span class="w-28 text-gray-500">Order Status</span>
            <span>: <span class="font-bold text-gray-900"><%= order.deliveryStatus %></span></span>
        </div>
        <div class="flex">
            <span class="w-28 text-gray-500">Order Date</span>
            <span>: <%= formattedDate %></span>
        </div>
    </div>

    <!-- Order Items Section -->
    <div class="mb-10">
        <h2 class="text-sm font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2">Order Items</h2>
        
        <div class="space-y-6">
            <% order.items.forEach(item => { %>
                <% 
                    const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                    const size = variantParts[0] || 'N/A';
                    const color = variantParts[1] || 'N/A';
                    const fabric = variantParts[2] || 'N/A';
                    const status = item.itemStatus || 'Active'; 
                    const lineTotal = item.price * item.quantity;
                %>
                <div class="flex items-start justify-between border-b border-gray-100 pb-6 last:border-0">
                    <div class="flex space-x-6">
                        <img src="<%= item.product.images && item.product.images[0] ? item.product.images[0].url : '/images/default-product.jpg' %>" alt="Product Image" class="w-20 h-28 object-cover rounded-md shadow-sm border border-gray-100">
                        <div class="text-xs space-y-1 text-gray-600 font-medium">
                            <h3 class="text-sm font-bold text-gray-900 mb-1"><%= item.product.productName || item.product.name || 'Dresson Product' %></h3>
                            <p>Quantity: <%= item.quantity %></p>
                            <p>Size: <%= size %></p>
                            <p>Color: <%= color %></p>
                            
                            <!-- Price Display with Cancelled Strikethrough Logic -->
                            <p class="text-sm font-black mt-1 <%= status === 'Cancelled' ? 'line-through text-gray-400' : 'text-gray-900' %>">
                                ₹ <%= lineTotal.toLocaleString('en-IN') %>
                                <% if (item.quantity > 1) { %>
                                    <span class="text-[10px] font-medium text-gray-500 ml-1" style="text-decoration: none !important;">
                                        (₹ <%= item.price.toLocaleString('en-IN') %> x <%= item.quantity %>)
                                    </span>
                                <% } %>
                            </p>

                            <!-- Item Status Badge -->
                            <div class="mt-2 inline-block px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider
                                <%= status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
                                    status === 'Returned' ? 'bg-blue-100 text-blue-700' : 
                                    status === 'Return Pending' ? 'bg-yellow-100 text-yellow-700' : 
                                    status === 'Return Rejected' ? 'bg-orange-100 text-orange-800' :
                                    'bg-green-100 text-green-700' %>">
                                <%= status === 'Return Rejected' ? 'Rejected' : status %>
                            </div>

                            <!-- ✨ NEW: Per-Item Return Messaging & Admin Notes (Inline Style) -->
                            <% if (status === 'Return Pending') { %>
                                <div class="mt-3 p-2.5 bg-yellow-50 border border-yellow-200 rounded text-[11px] text-yellow-800 w-full max-w-sm">
                                    <span class="font-bold"><i class="fas fa-clock mr-1"></i> Pending Review</span><br>
                                    We are reviewing your request. Please allow 24-48 hours.
                                </div>
                            <% } else if (status === 'Returned') { %>
                                <div class="mt-3 p-2.5 bg-blue-50 border border-blue-200 rounded text-[11px] text-blue-800 w-full max-w-sm">
                                    <div class="font-bold flex flex-wrap items-center gap-1">
                                        <span><i class="fas fa-check-circle mr-1"></i> Return Approved</span>
                                        <% if (item.adminMessage) { %>
                                            <span class="font-normal text-blue-600 italic">| "<%= item.adminMessage %>"</span>
                                        <% } %>
                                    </div>
                                    <div class="mt-1">
                                        <% if (order.paymentMethod === 'Wallet') { %>
                                            Amount has been instantly credited to your Wallet.
                                        <% } else { %>
                                            Amount will be credited in 5-7 business days.
                                        <% } %>
                                    </div>
                                </div>
                            <% } else if (status === 'Return Rejected') { %>
                                <div class="mt-3 p-2.5 bg-red-50 border border-red-200 rounded text-[11px] text-red-800 w-full max-w-sm">
                                    <div class="font-bold flex flex-wrap items-center gap-1">
                                        <span><i class="fas fa-times-circle mr-1"></i> Return Declined</span>
                                        <% if (item.adminMessage) { %>
                                            <span class="font-normal text-red-600 italic">| "<%= item.adminMessage %>"</span>
                                        <% } %>
                                    </div>
                                    <% if (!item.adminMessage) { %>
                                        <div class="mt-1">Your item did not meet the return policy criteria.</div>
                                    <% } %>
                                </div>
                            <% } %>
                            
                        </div>
                    </div>
                    
                    <div class="flex flex-col items-end space-y-2">
                        <% if (order.deliveryStatus === 'Delivered' && status === 'Active') { %>
                            <a href="/product/rate/<%= item.product._id %>" class="bg-black text-white px-5 py-1.5 rounded-full font-bold text-xs hover:bg-gray-800 transition">
                                Rate Product
                            </a>
                        <% } %>

                        <!-- Item Level Actions -->
                        <% if (status === 'Active' && order.deliveryStatus !== 'Cancelled' && order.deliveryStatus !== 'Returned') { %>
                            <button type="button" 
                                onclick="openUnifiedModal('<%= order._id %>', '<%= item._id || item.product._id || item.product %>', '<%= order.deliveryStatus === 'Delivered' ? 'Return' : 'Cancel' %>')" 
                                class="px-5 py-1.5 text-xs font-bold text-white bg-[#b68c96] hover:bg-[#9c757f] rounded-full shadow-sm transition">
                                <%= order.deliveryStatus === 'Delivered' ? 'Return Item' : 'Cancel Item' %>
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Shipping Address -->
    <div class="mb-10">
        <h2 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-200 pb-2">Shipping Address</h2>
        <div class="text-xs text-gray-600 font-medium space-y-1 leading-relaxed">
            <p class="font-bold text-gray-800 text-sm"><%= order.shippingAddress.fullName %></p>
            <p><%= order.shippingAddress.addressLine %></p>
            <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %></p>
            <p>Pin: <%= order.shippingAddress.pincode %></p>
            <p class="mt-1">Mobile: <%= order.shippingAddress.phone %></p>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="mb-12">
        <h2 class="text-sm font-bold text-gray-800 mb-3 border-b border-gray-200 pb-2">Order Summary</h2>
        <div class="w-full max-w-sm text-xs font-medium text-gray-600 space-y-2">
            <div class="flex justify-between">
                <span>Subtotal</span>
                <span>₹ <%= summary.subTotal.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between">
                <span>Estimated Tax</span>
                <span>₹ <%= summary.tax.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between">
                <span>Shipping</span>
                <span>₹ <%= summary.shipping.toLocaleString('en-IN') %></span>
            </div>
            <% if (summary.discount > 0) { %>
            <div class="flex justify-between text-red-500">
                <span>Discount</span>
                <span>- ₹ <%= summary.discount.toLocaleString('en-IN') %></span>
            </div>
            <% } %>
            <div class="flex justify-between font-bold text-sm text-gray-900 pt-2 border-t border-gray-100 mt-2">
                <span>Grand Total</span>
                <span>₹ <%= summary.grandTotal.toLocaleString('en-IN') %></span>
            </div>
        </div>
    </div>
    
    <% if (order.deliveryStatus === 'Delivered') { %>
        <!-- Invoice Button -->
        <div class="flex justify-center border-t border-gray-200 pt-8 mb-8">
            <a href="/profile/orders/<%= order._id %>/invoice" target="_blank" class="px-6 py-2 bg-[#a35e6c] hover:bg-[#8b4e5a] text-white text-xs font-semibold rounded-full shadow-md transition text-center">
                View / Download Invoice
            </a>
        </div>
    <% } %>

    <!-- Unified Item Action Modal -->
    <div id="unifiedActionModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex justify-center items-center px-4 transition-opacity">
        <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-xl transform scale-100 transition-transform">
            <div class="flex justify-between items-center border-b border-gray-100 pb-4 mb-4">
                <h3 id="modalTitle" class="text-lg font-bold text-gray-900">Modify Item</h3>
                <button type="button" onclick="closeUnifiedModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            
            <form action="/profile/orders/item-action" method="POST">
                <input type="hidden" name="orderId" id="modalOrderId">
                <input type="hidden" name="itemId" id="modalItemId">
                <input type="hidden" name="actionType" id="modalActionType">

                <p id="modalDescription" class="text-sm text-gray-600 mb-4">Please let us know your reason. This action cannot be undone.</p>
                
                <div class="mb-6">
                    <label for="reason" class="block text-xs font-bold text-gray-700 mb-2">Reason <span class="text-red-500">*</span></label>
                    <select name="reason" id="reason" required class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#b68c96]">
                        <option value="" disabled selected>Select a reason...</option>
                        <option value="Changed my mind">Changed my mind</option>
                        <option value="Found a better price">Found a better price</option>
                        <option value="Wrong size ordered">Wrong size ordered</option>
                        <option value="Product damaged or defective">Product damaged or defective</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="closeUnifiedModal()" class="px-5 py-2 text-xs font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-md transition">
                        Close
                    </button>
                    <button type="submit" id="modalSubmitBtn" class="px-5 py-2 text-xs font-bold text-white bg-[#b68c96] hover:bg-[#9c757f] rounded-md transition shadow-sm">
                        Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Legacy Return Status Notification Banner -->
    <% if (order.returnRequest && order.returnRequest.status === 'Refunded') { %>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-8 flex items-start gap-4 shadow-sm mt-8">
            <div class="text-blue-500 mt-0.5 shrink-0">
                <i class="fas fa-info-circle text-xl"></i>
            </div>
            <div class="flex-1">
                <h4 class="text-sm font-bold text-blue-900 mb-1">Return Approved & Refund Initiated</h4>
                <p class="text-[13px] text-blue-800 leading-relaxed font-medium">
                    Your return request has been processed successfully. A refund will reflect in your original payment method within <strong>5 to 7 working days</strong>.
                </p>
                <% if (order.returnRequest.adminMessage) { %>
                    <div class="mt-3 p-3 border-l-4 border-blue-400 bg-blue-100/50 rounded-r-md">
                        <p class="text-xs text-blue-900 font-semibold mb-1">Note from Dresson Support:</p>
                        <p class="text-[13px] text-blue-800 italic">"<%= order.returnRequest.adminMessage %>"</p>
                    </div>
                <% } %>
            </div>
        </div>
    <% } else if (order.returnRequest && order.returnRequest.status === 'Rejected') { %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-5 mb-8 flex items-start gap-4 shadow-sm mt-8">
            <div class="text-red-500 mt-0.5 shrink-0">
                <i class="fas fa-exclamation-circle text-xl"></i>
            </div>
            <div class="flex-1">
                <h4 class="text-sm font-bold text-red-900 mb-1">Return Request Declined</h4>
                <% if (order.returnRequest.adminMessage) { %>
                    <p class="text-[13px] text-red-800 leading-relaxed font-medium">
                        <%= order.returnRequest.adminMessage %>
                    </p>
                <% } else { %>
                    <p class="text-[13px] text-red-800 leading-relaxed font-medium">
                        Unfortunately, your return request could not be approved at this time.
                    </p>
                <% } %>
            </div>
        </div>
    <% } %>

</main>

<script>
    function openUnifiedModal(orderId, itemId, action) {
        document.getElementById('modalOrderId').value = orderId;
        document.getElementById('modalItemId').value = itemId;
        document.getElementById('modalActionType').value = action;
        
        document.getElementById('modalTitle').innerText = action + ' Item';
        document.getElementById('modalSubmitBtn').innerText = 'Confirm ' + action;
        
        document.getElementById('unifiedActionModal').classList.remove('hidden');
    }

    function closeUnifiedModal() {
        document.getElementById('unifiedActionModal').classList.add('hidden');
    }
</script>