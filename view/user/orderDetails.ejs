<%- contentFor('body') %>

<!-- Shared Alerts -->
<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<!-- Adjusted main background to off-white to make the white box pop -->
<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-gray-50/50 min-h-screen">
    
    <!-- Beautiful Wrapper Box -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 md:p-12 mb-10">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 gap-4">
            <h1 class="text-3xl font-black text-gray-800 tracking-tight">Order Details</h1>
            <a href="/profile/orders" class="px-5 py-2.5 text-xs font-bold text-gray-700 bg-white hover:bg-gray-50 border border-gray-200 rounded-lg transition shadow-sm flex items-center">
                <i class="fas fa-arrow-left mr-2"></i> Back to Orders
            </a>
        </div>

        <!-- Order Meta Info -->
        <div class="mb-10 p-5 bg-gray-50 rounded-xl border border-gray-100 text-sm space-y-2 text-gray-700 font-medium">
            <div class="flex">
                <span class="w-32 text-gray-500 font-bold uppercase tracking-wider text-xs">Order ID</span>
                <span class="font-bold text-gray-900">: <%= order.orderId %></span>
            </div>
            <div class="flex">
                <span class="w-32 text-gray-500 font-bold uppercase tracking-wider text-xs">Order Status</span>
                <span>: <span class="font-black text-[#a35e6c]"><%= order.deliveryStatus %></span></span>
            </div>
            <div class="flex">
                <span class="w-32 text-gray-500 font-bold uppercase tracking-wider text-xs">Order Date</span>
                <span class="font-bold text-gray-900">: <%= formattedDate %></span>
            </div>
        </div>

        <!-- Order Items Section -->
        <div class="mb-12">
            <h2 class="text-lg font-extrabold text-gray-900 mb-6 border-b border-gray-100 pb-3">Order Items</h2>
            
            <div class="space-y-6">
                <% order.items.forEach(item => { %>
                    <% 
                        const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                        const size = variantParts[0] || 'N/A';
                        const color = variantParts[1] || 'N/A';
                        const fabric = variantParts[2] || 'N/A';
                        const status = item.itemStatus || 'Active'; 
                        
                        // 1. Get the actual paid price (saved in the order document)
                        const effectiveItemPrice = item.effectivePrice || item.price; 
                        
                        // 2. Extract original MRP directly from the populated product variant
                        let originalItemPrice = item.originalPrice || item.livePrice;
                        if (!originalItemPrice && item.product && item.product.variants) {
                            const matchedVariant = item.product.variants.find(v => 
                                v.sku === item.variantSku || 
                                (item.variantId && v._id && v._id.toString() === item.variantId.toString()) ||
                                (v.size === size && v.color === color)
                            );
                            if (matchedVariant && matchedVariant.price) {
                                originalItemPrice = matchedVariant.price;
                            }
                        }
                        originalItemPrice = originalItemPrice || effectiveItemPrice;

                        const isDiscounted = item.hasDiscount || item.isComboItem || (originalItemPrice > effectiveItemPrice);
                        
                        const lineEffectiveTotal = effectiveItemPrice * item.quantity;
                        const lineOriginalTotal = originalItemPrice * item.quantity;
                    %>
                    <div class="flex flex-col sm:flex-row items-start justify-between border border-gray-100 rounded-xl p-5 hover:shadow-md transition duration-200">
                        <div class="flex space-x-6 w-full sm:w-auto mb-4 sm:mb-0">
                            <img src="<%= item.product.images && item.product.images[0] ? item.product.images[0].url : '/images/default-product.jpg' %>" alt="Product Image" class="w-24 h-32 object-cover rounded-lg shadow-sm border border-gray-100">
                            <div class="text-xs space-y-1.5 text-gray-600 font-medium flex-1">
                                <h3 class="text-base font-bold text-gray-900 mb-2"><%= item.product.productName || item.product.name || 'Dresson Product' %></h3>
                                <p class="bg-gray-100 inline-block px-2 py-0.5 rounded-sm">Qty: <%= item.quantity %></p>
                                <p>Size: <span class="font-bold text-gray-800"><%= size %></span></p>
                                <p>Color: <span class="font-bold text-gray-800"><%= color %></span></p>
                                
                                <!-- Price Display with Cancelled and Discount Strikethrough Logic -->
                                <div class="mt-2">
                                    <% if (status === 'Cancelled') { %>
                                        <!-- Fully Cancelled State -->
                                        <p class="text-sm font-black line-through text-gray-400">
                                            ₹ <%= lineEffectiveTotal.toLocaleString('en-IN') %>
                                            <% if (item.quantity > 1) { %>
                                                <span class="text-[10px] font-medium ml-1" style="text-decoration: none !important;">
                                                    (₹ <%= effectiveItemPrice.toLocaleString('en-IN') %> x <%= item.quantity %>)
                                                </span>
                                            <% } %>
                                        </p>
                                    <% } else { %>
                                        <!-- Active/Delivered/Returned State with Discount Logic -->
                                        <div class="flex flex-col">
                                            <% if (isDiscounted) { %>
                                                <span class="text-xs font-semibold text-gray-400 line-through mb-0.5">
                                                    ₹ <%= lineOriginalTotal.toLocaleString('en-IN') %>
                                                </span>
                                            <% } %>
                                            <p class="text-sm font-black text-[#fc6c6c]">
                                                ₹ <%= lineEffectiveTotal.toLocaleString('en-IN') %>
                                                <% if (item.quantity > 1) { %>
                                                    <span class="text-[10px] font-medium text-gray-500 ml-1">
                                                        (₹ <%= effectiveItemPrice.toLocaleString('en-IN') %> x <%= item.quantity %>)
                                                    </span>
                                                <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Item Status Badge -->
                                <div class="mt-3 inline-block px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-wider
                                    <%= status === 'Cancelled' ? 'bg-red-50 text-red-700 border border-red-100' : 
                                        status === 'Returned' ? 'bg-blue-50 text-blue-700 border border-blue-100' : 
                                        status === 'Return Pending' ? 'bg-yellow-50 text-yellow-700 border border-yellow-100' : 
                                        status === 'Return Rejected' ? 'bg-orange-50 text-orange-800 border border-orange-100' :
                                        'bg-green-50 text-green-700 border border-green-100' %>">
                                    <%= status === 'Return Rejected' ? 'Rejected' : status %>
                                </div>

                                <!-- Per-Item Return Messaging & Admin Notes -->
                                <% if (status === 'Return Pending') { %>
                                    <div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg text-[11px] text-yellow-800 w-full max-w-sm">
                                        <span class="font-bold"><i class="fas fa-clock mr-1"></i> Pending Review</span><br>
                                        We are reviewing your request. Please allow 24-48 hours.
                                    </div>
                                <% } else if (status === 'Returned') { %>
                                    <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg text-[11px] text-blue-800 w-full max-w-sm">
                                        <div class="font-bold flex flex-wrap items-center gap-1">
                                            <span><i class="fas fa-check-circle mr-1"></i> Return Approved</span>
                                            <% if (item.adminMessage) { %>
                                                <span class="font-normal text-blue-600 italic">| "<%= item.adminMessage %>"</span>
                                            <% } %>
                                        </div>
                                        <div class="mt-1">
                                            <% if (order.paymentMethod === 'Wallet') { %>
                                                Amount has been instantly credited to your Wallet.
                                            <% } else { %>
                                                Amount will be credited in 5-7 business days.
                                            <% } %>
                                        </div>
                                    </div>
                                <% } else if (status === 'Return Rejected') { %>
                                    <div class="mt-3 p-3 bg-red-50 border border-red-200 rounded-lg text-[11px] text-red-800 w-full max-w-sm">
                                        <div class="font-bold flex flex-wrap items-center gap-1">
                                            <span><i class="fas fa-times-circle mr-1"></i> Return Declined</span>
                                            <% if (item.adminMessage) { %>
                                                <span class="font-normal text-red-600 italic">| "<%= item.adminMessage %>"</span>
                                            <% } %>
                                        </div>
                                        <% if (!item.adminMessage) { %>
                                            <div class="mt-1">Your item did not meet the return policy criteria.</div>
                                        <% } %>
                                    </div>
                                <% } %>
                                
                            </div>
                        </div>
                        
                        <div class="flex flex-col items-start sm:items-end space-y-3 w-full sm:w-auto">
                            <% if (order.deliveryStatus === 'Delivered' && status === 'Active') { %>
                                <a href="/product/rate/<%= item.product._id %>" class="w-full sm:w-auto text-center bg-gray-900 text-white px-5 py-2.5 rounded-lg font-bold text-xs hover:bg-gray-800 transition shadow-sm">
                                    Rate Product
                                </a>
                            <% } %>

                            <!-- Item Level Actions -->
                            <% if (status === 'Active' && order.deliveryStatus !== 'Cancelled' && order.deliveryStatus !== 'Returned') { %>
                                <button type="button" 
                                    onclick="openUnifiedModal('<%= order._id %>', '<%= item._id || item.product._id || item.product %>', '<%= order.deliveryStatus === 'Delivered' ? 'Return' : 'Cancel' %>')" 
                                    class="w-full sm:w-auto text-center px-5 py-2.5 text-xs font-bold text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg shadow-sm transition">
                                    <%= order.deliveryStatus === 'Delivered' ? 'Return Item' : 'Cancel Item' %>
                                </button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <!-- Shipping Address -->
            <div>
                <h2 class="text-sm font-extrabold text-gray-900 mb-4 border-b border-gray-100 pb-2">Shipping Address</h2>
                <div class="text-xs text-gray-600 font-medium space-y-1.5 leading-relaxed bg-gray-50 p-5 rounded-xl border border-gray-100">
                    <p class="font-black text-gray-900 text-sm mb-2"><%= order.shippingAddress.fullName %></p>
                    <p><%= order.shippingAddress.addressLine %></p>
                    <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %></p>
                    <p>Pin: <span class="font-bold text-gray-800"><%= order.shippingAddress.pincode %></span></p>
                    <p class="mt-2 pt-2 border-t border-gray-200">Mobile: <span class="font-bold text-gray-800"><%= order.shippingAddress.phone %></span></p>
                </div>
            </div>

           <!-- Order Summary -->
            <div>
                <h2 class="text-sm font-extrabold text-gray-900 mb-4 border-b border-gray-100 pb-2">Order Summary</h2>
                <div class="w-full text-xs font-medium text-gray-600 space-y-3 bg-gray-50 p-5 rounded-xl border border-gray-100">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span class="font-bold text-gray-800">₹ <%= summary.subTotal.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Estimated Tax</span>
                        <span class="font-bold text-gray-800">₹ <%= summary.tax.toLocaleString('en-IN') %></span>
                    </div>
                    
                    <% 
    
                        const isFreeShipping = (summary.subTotal + summary.tax) >= 1500;
                        
                        let displayedShipping = summary.shipping;
                        if (isFreeShipping) {
                            displayedShipping = 0;
                        }
                        let trueCouponDiscount = (summary.subTotal + summary.tax + displayedShipping) - summary.grandTotal;
                        trueCouponDiscount = Math.round(trueCouponDiscount * 100) / 100; 
                        if (trueCouponDiscount < 0) trueCouponDiscount = 0;
                    %>

                    <!-- FREE shipping display -->
                    <div class="flex justify-between">
                        <span>Shipping</span>
                        <span class="font-bold text-gray-800">
                            <% if (displayedShipping === 0) { %>
                                <span class="text-green-600 font-black">FREE</span>
                            <% } else { %>
                                ₹ <%= displayedShipping.toLocaleString('en-IN') %>
                            <% } %>
                        </span>
                    </div>
                    
                    <!-- Display ONLY true Coupon Discount -->
                    <% if (trueCouponDiscount > 0) { %>
                    <div class="flex justify-between text-green-600">
                        <span>Coupon Discount</span>
                        <span class="font-bold">- ₹ <%= trueCouponDiscount.toLocaleString('en-IN') %></span>
                    </div>
                    <% } %>
                    
                    <div class="flex justify-between font-black text-base text-gray-900 pt-3 border-t border-gray-200 mt-2">
                        <span>Grand Total</span>
                        <span class="text-[#fc6c6c]">₹ <%= summary.grandTotal.toLocaleString('en-IN') %></span>
                    </div>
                </div>
            </div>
        
        <% if (order.deliveryStatus === 'Delivered') { %>
            <!-- Invoice Button -->
            <div class="flex justify-center sm:justify-end border-t border-gray-100 pt-8 mt-10">
                <a href="/profile/orders/<%= order._id %>/invoice" target="_blank" class="px-8 py-3 bg-[#a35e6c] hover:bg-[#8b4e5a] text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-md transition flex items-center justify-center">
                    <i class="fas fa-file-invoice mr-2"></i> View / Download Invoice
                </a>
            </div>
        <% } %>

    </div> 

    <!-- Legacy Return Status Notification Banner -->
    <% if (order.returnRequest && order.returnRequest.status === 'Refunded') { %>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 mb-8 flex items-start gap-4 shadow-md">
            <div class="text-blue-500 mt-0.5 shrink-0">
                <i class="fas fa-info-circle text-2xl"></i>
            </div>
            <div class="flex-1">
                <h4 class="text-base font-bold text-blue-900 mb-1">Return Approved & Refund Initiated</h4>
                <p class="text-sm text-blue-800 leading-relaxed font-medium">
                    Your return request has been processed successfully. A refund will reflect in your original payment method within <strong>5 to 7 working days</strong>.
                </p>
                <% if (order.returnRequest.adminMessage) { %>
                    <div class="mt-4 p-4 border-l-4 border-blue-400 bg-blue-100/50 rounded-r-lg shadow-sm">
                        <p class="text-xs text-blue-900 font-bold uppercase tracking-wider mb-1">Note from Dresson Support:</p>
                        <p class="text-sm text-blue-800 italic">"<%= order.returnRequest.adminMessage %>"</p>
                    </div>
                <% } %>
            </div>
        </div>
    <% } else if (order.returnRequest && order.returnRequest.status === 'Rejected') { %>
        <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 flex items-start gap-4 shadow-md">
            <div class="text-red-500 mt-0.5 shrink-0">
                <i class="fas fa-exclamation-circle text-2xl"></i>
            </div>
            <div class="flex-1">
                <h4 class="text-base font-bold text-red-900 mb-1">Return Request Declined</h4>
                <% if (order.returnRequest.adminMessage) { %>
                    <p class="text-sm text-red-800 leading-relaxed font-medium">
                        <%= order.returnRequest.adminMessage %>
                    </p>
                <% } else { %>
                    <p class="text-sm text-red-800 leading-relaxed font-medium">
                        Unfortunately, your return request could not be approved at this time.
                    </p>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- Unified Item Action Modal -->
    <div id="unifiedActionModal" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-50 flex justify-center items-center px-4 transition-opacity duration-300">
        <div class="bg-white rounded-2xl w-full max-w-md p-8 shadow-2xl transform transition-transform">
            <div class="flex justify-between items-center border-b border-gray-100 pb-4 mb-5">
                <h3 id="modalTitle" class="text-xl font-black text-gray-900">Modify Item</h3>
                <button type="button" onclick="closeUnifiedModal()" class="text-gray-400 hover:text-red-500 transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <form action="/profile/orders/item-action" method="POST">
                <input type="hidden" name="orderId" id="modalOrderId">
                <input type="hidden" name="itemId" id="modalItemId">
                <input type="hidden" name="actionType" id="modalActionType">

                <p id="modalDescription" class="text-sm text-gray-600 mb-6 font-medium">Please let us know your reason. This action cannot be undone.</p>
                
                <div class="mb-8">
                    <label for="reason" class="block text-xs font-bold text-gray-800 uppercase tracking-wide mb-2">Reason <span class="text-red-500">*</span></label>
                    <select name="reason" id="reason" required class="w-full px-4 py-3 text-sm font-medium text-gray-700 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#b68c96] focus:bg-white transition">
                        <option value="" disabled selected>Select a reason...</option>
                        <option value="Changed my mind">Changed my mind</option>
                        <option value="Found a better price">Found a better price</option>
                        <option value="Wrong size ordered">Wrong size ordered</option>
                        <option value="Product damaged or defective">Product damaged or defective</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                
                <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
                    <button type="button" onclick="closeUnifiedModal()" class="w-full sm:w-auto px-6 py-2.5 text-xs font-bold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
                        Close
                    </button>
                    <button type="submit" id="modalSubmitBtn" class="w-full sm:w-auto px-6 py-2.5 text-xs font-bold text-white bg-[#b68c96] hover:bg-[#9c757f] rounded-lg transition shadow-md">
                        Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>

</main>
<script>
    function openUnifiedModal(orderId, itemId, action) {
        document.getElementById('modalOrderId').value = orderId;
        document.getElementById('modalItemId').value = itemId;
        document.getElementById('modalActionType').value = action;
        
        document.getElementById('modalTitle').innerText = action + ' Item';
        document.getElementById('modalSubmitBtn').innerText = 'Confirm ' + action;
        
        document.getElementById('unifiedActionModal').classList.remove('hidden');
    }

    function closeUnifiedModal() {
        document.getElementById('unifiedActionModal').classList.add('hidden');
    }
</script>