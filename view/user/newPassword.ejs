<div class="bg-[#1e1e1e] w-full flex-1 flex items-center justify-center p-4 py-20">
    
    <div class="bg-[#f5f5f5] p-10 rounded-sm shadow-xl w-full max-w-md">
        
        <h2 class="text-center text-gray-900 text-2xl font-bold mb-8">Set New Password</h2>

        <form action="/reset-password" method="POST" class="space-y-5">
            
            <div class="flex flex-col">
                <label for="password" class="block text-sm font-bold text-gray-700 mb-1">Enter new Password</label>
                <input type="password" id="password" name="password" required
                    class="w-full px-4 py-2.5 bg-[#e4e4e4] text-gray-800 border border-transparent rounded-sm focus:outline-none focus:ring-2 focus:ring-[#1e8436] font-medium shadow-inner transition">
            </div>

            <div class="flex flex-col">
                <label for="confirmPassword" class="block text-sm font-bold text-gray-700 mb-1">Confirm new Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required
                    class="w-full px-4 py-2.5 bg-[#e4e4e4] text-gray-800 border border-transparent rounded-sm focus:outline-none focus:ring-2 focus:ring-[#1e8436] font-medium shadow-inner transition">
            </div>

            <button type="submit"
                class="w-full bg-[#1e8436] hover:bg-[#156327] text-white font-semibold py-3 rounded-full transition duration-200 mt-6 shadow-sm cursor-pointer">
                Reset Password
            </button>
        </form>

    </div>

</div>