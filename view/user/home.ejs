





<div class="flex flex-row gap-6 max-w-7xl mx-auto w-full px-4 py-6">
    
    <aside class="w-64 flex-shrink-0">
        <%- include('../partial/user/sidebar') %>
    </aside>

    <section class="flex-grow space-y-6">
        <div class="bg-[#f0e6e6] rounded-sm h-40 relative flex items-center px-8 border border-gray-200 shadow-sm">
            <div class="z-10">
                <h2 class="text-2xl font-black text-gray-900">UP TO <span class="text-red-600">50% OFF</span></h2>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <%- include('../partial/user/productCard', { product: product }) %>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center py-12 text-gray-400">No products found.</div>
            <% } %>
        </div>
    </section>
</div>