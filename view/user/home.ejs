<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<div class="flex flex-col md:flex-row gap-8 max-w-7xl mx-auto w-full px-4 py-8">
    
    <!--  For sidebar -->
    <aside class="w-full md:w-64 shrink-0">
        <%- include('../partial/user/shopSidebar', { 
            categories: typeof categories !== 'undefined' ? categories : [], 
            query: typeof query !== 'undefined' ? query : {},
            currentGender: typeof currentGender !== 'undefined' ? currentGender : '' 
        }) %>
    </aside>

    <!-- For Promotions, Grid & Pagination -->
    <section class="flex-grow space-y-6 min-w-0">
        
        <!-- For  Banner -->
        <!-- Dynamic Banner Slider -->
        <% if (typeof heroBanners !== 'undefined' && heroBanners.length > 0) { %>
            <div class="swiper myHeroSwiper rounded-xl h-44 sm:h-64 mb-6 shadow-xs overflow-hidden w-full group">
                <div class="swiper-wrapper">
                    <% heroBanners.forEach(banner => { %>
                        <div class="swiper-slide relative w-full h-full">
                            <!-- Make the banner clickable if a target URL exists -->
                            <% if (banner.targetUrl) { %>
                                <a href="<%= banner.targetUrl %>" class="block w-full h-full">
                            <% } %>
                                
                            <img src="<%= banner.imageUrl %>" alt="<%= banner.title %>" class="w-full h-full object-cover">
                            
                            <% if (banner.targetUrl) { %>
                                </a>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
                
                <!-- Swiper Controls -->
                <div class="swiper-pagination"></div>
                <!-- Hidden by default, appears on hover using Tailwind 'group-hover' -->
                <div class="swiper-button-next text-white opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="swiper-button-prev text-white opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
        <% } %>

        <!-- For 'combo offer' section -->
       <% if (typeof comboOffers !== 'undefined' && comboOffers.length > 0) { %>
            <div class="mb-8 p-6 bg-gradient-to-br from-yellow-50 via-white to-orange-50 rounded-2xl border border-yellow-200 shadow-sm">
                <div class="flex items-center gap-3 mb-6">
                    <div class="p-2 bg-yellow-100 rounded-full">
                        <i class="fas fa-bolt text-yellow-600 text-xl"></i>
                    </div>
                    <h2 class="text-2xl font-black text-gray-900 tracking-tight">Special Combo Offers</h2>
                </div>
                
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                    <% comboOffers.forEach(combo => { %>
                        <% 
                            let totalOriginalPrice = 0;
                            combo.products.forEach(p => {
                                if (p.variants && p.variants.length > 0) {
                                    totalOriginalPrice += p.variants[0].price;
                                }
                            });
                            let savings = totalOriginalPrice - combo.discountValue;
                        %>
                        <div class="bg-white p-5 rounded-xl shadow-md border border-yellow-100 flex flex-col justify-between hover:shadow-lg transition-shadow duration-300">
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-bold text-lg text-gray-900"><%= combo.title %></h3>
                                    <% if (savings > 0) { %>
                                        <span class="bg-red-100 text-red-700 text-xs font-bold px-3 py-1 rounded-full animate-pulse">
                                            Save ₹<%= savings %>!
                                        </span>
                                    <% } %>
                                </div>
                                <p class="text-sm text-gray-500 mb-4">Bundle up and enjoy a massive discount on these items.</p>
                                
                                <!-- Individual Products Display -->
                                <div class="flex flex-wrap items-center gap-2 mb-6 bg-gray-50 p-3 rounded-lg border border-gray-100">
                                    <% combo.products.forEach((prod, index) => { %>
                                        <% const basePrice = prod.variants && prod.variants.length > 0 ? prod.variants[0].price : 0; %>
                                        <div class="flex items-center gap-3 bg-white p-2 rounded-md shadow-sm border border-gray-100 flex-1 min-w-[140px]">
                                            <div class="flex-shrink-0 w-12 h-12 bg-gray-100 rounded overflow-hidden">
                                                <img src="<%= prod.images && prod.images.length > 0 && prod.images[0].url ? prod.images[0].url : '/default-image.jpg' %>" alt="<%= prod.name %>" class="w-full h-full object-cover text-xs">
                                            </div>
                                            <div class="flex flex-col overflow-hidden">
                                                <span class="text-xs font-bold text-gray-800 truncate" title="<%= prod.name %>"><%= prod.name %></span>
                                                <span class="text-xs text-gray-400 line-through">₹<%= basePrice %></span>
                                            </div>
                                        </div>
                                        
                                        <!-- Plus Icon between products -->
                                        <% if (index < combo.products.length - 1) { %>
                                            <div class="text-gray-300 font-bold px-1"><i class="fas fa-plus"></i></div>
                                        <% } %>
                                    <% }) %>
                                </div>
                            </div>
                            
                            <form onsubmit="event.preventDefault(); addComboToCart(this);" class="mt-auto">
                                <input type="hidden" name="offerId" value="<%= combo._id %>">
                                <% combo.products.forEach(prod => { %>
                                    <input type="hidden" name="productIds[]" value="<%= prod._id %>">
                                <% }) %>
                                
                                <div class="flex flex-col sm:flex-row items-center gap-4 pt-4 border-t border-gray-100">
                                    <!-- Price Display Section -->
                                    <div class="flex flex-col text-center sm:text-left w-full sm:w-auto">
                                        <span class="text-xs text-gray-500 font-medium">Total Value: <span class="line-through text-gray-400">₹<%= totalOriginalPrice %></span></span>
                                        <span class="text-2xl font-black text-gray-900">₹<%= combo.discountValue %></span>
                                    </div>
                                    
                                    <!-- Yellow Add to Cart Button -->
                                    <button type="submit" class="w-full sm:w-auto flex-1 py-3 px-6 bg-yellow-400 text-black text-sm font-black uppercase tracking-wider rounded-lg hover:bg-yellow-500 transform hover:-translate-y-0.5 transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                                        <i class="fas fa-cart-plus"></i> Add Combo to Cart
                                    </button>
                                </div>
                            </form>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
        <!-- Results Counter -->
        <div class="flex justify-between items-center px-1">
            <span class="text-xs text-gray-500 font-medium">
                Showing <strong class="text-gray-900"><%= products ? products.length : 0 %></strong> of <strong class="text-gray-900"><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></strong> items
            </span>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <%- include('../partial/user/productCard', { product: product }) %>
                <% }) %>
            <% } else { %>
                <!-- Empty State with Clear Filters CTA -->
                <div class="col-span-full text-center py-20 bg-white rounded-xl border border-gray-200 p-8 space-y-3 shadow-2xs">
                    <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto text-gray-400 text-xl">
                        <i class="fas fa-search"></i>
                    </div>
                    <p class="text-sm font-bold text-gray-800">No products matched your criteria.</p>
                    <p class="text-xs text-gray-400">Try adjusting your price range, category, or clearing filters.</p>
                    <a href="/shop" class="inline-block mt-2 px-4 py-2 bg-black text-white text-xs font-bold rounded-lg hover:bg-gray-800 transition shadow-xs">
                        Clear All Filters
                    </a>
                </div>
            <% } %>
        </div>

        
        <%- include('../partial/shared/pagination', { 
            baseUrl: '/shop', 
            currentPage: typeof currentPage !== 'undefined' ? currentPage : 1, 
            totalPages: typeof totalPages !== 'undefined' ? totalPages : 1,
            query: typeof query !== 'undefined' ? query : {} 
        }) %>

    </section>
</div>

<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<!-- For swipe the banner -->
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script>
    // NEW FUNCTION TO HANDLE COMBO ADDITIONS
    async function addComboToCart(formElement) {
        try {
            const formData = new FormData(formElement);
            // Handling array inputs (multiple productIds)
            const productIds = formData.getAll('productIds[]');
            const offerId = formData.get('offerId');
            
            const payload = { offerId, productIds };

            // Notice we are sending to a distinct route or modifying the payload so backend handles bundles
            const response = await fetch('/cart/add-combo', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'                     
                },
                body: JSON.stringify(payload)
            });
            
            if (response.status === 401) {
                window.location.href = '/login?redirect=/shop';
                return;
            }
            const data = await response.json();
            if (response.ok && data.success) {
                if (typeof showCustomAlert === 'function') {
                    showCustomAlert("Combo successfully added to your cart!", "Cart Updated", "success");
                }
            } else {
                if (typeof showCustomAlert === 'function') {
                    showCustomAlert(data.message || "Could not add combo to cart.", "Notice", "warning");
                }
            }
        } catch (error) {
            console.error("Add combo error:", error);
            if (typeof showCustomAlert === 'function') {
                showCustomAlert("A network error occurred. Please try again.", "Connection Error", "error");
            }
        }
    }


// For 'Add to Cart' button
async function addToCart(formElement) {
    try {
        const formData = new FormData(formElement);
        const payload = Object.fromEntries(formData.entries());        
        const response = await fetch('/cart/add', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Accept': 'application/json'                     
            },
            body: JSON.stringify(payload)
        });      
        if (response.status === 401) {
            window.location.href = '/login?redirect=/shop';
            return;
        }     
        const data = await response.json();        
        if (response.ok && data.success) {
            const badge = document.getElementById('cart-badge');           
            if (badge) {
                let newCount;
                if (data.cart && data.cart.items) {
                    newCount = data.cart.items.length;
                } else {
                    let currentCount = parseInt(badge.innerText || '0', 10);
                    newCount = currentCount + 1;
                }
                badge.innerText = newCount;
                if (newCount > 0) {
                    badge.classList.remove('hidden');
                }
            }

            if (typeof showCustomAlert === 'function') {
                showCustomAlert("Item successfully added to your cart!", "Cart Updated", "success");
            }
            
        } else {
            if (typeof showCustomAlert === 'function') {
                showCustomAlert(data.message || "Could not add item to cart.", "Notice", "warning");
            }
        }
    } catch (error) {
        console.error("Add to cart error:", error);
        if (typeof showCustomAlert === 'function') {
            showCustomAlert("A network error occurred. Please try again.", "Connection Error", "error");
        }
    }
}

// For 'toggle'/ change the color of 'wishlist' heart symbol
async function toggleWishlist(productId, btnElement) {
        try {
            const icon = btnElement.querySelector('i');                         
            const response = await fetch('/wishlist/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
            });            
            if (response.status === 401) {
                window.location.href = '/login?redirect=/shop';
                return;
            }            
            const data = await response.json();            
            if (response.ok && data.success) {
                const badge = document.getElementById('wishlist-badge');
                let currentCount = parseInt(badge.innerText || '0', 10);
                if (data.action === 'added') {
                    icon.classList.remove('far', 'text-gray-400');  
                    icon.classList.add('fas', 'text-red-500');
                    currentCount += 1;                   
                } else {
                    icon.classList.remove('fas', 'text-red-500');
                    icon.classList.add('far', 'text-gray-400');

                    currentCount = Math.max(0, currentCount - 1);
                }
                badge.innerText = currentCount;
                if (currentCount > 0) {
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }

            } else {
                if (typeof showCustomAlert === 'function') {
                    showCustomAlert(data.message || "Could not update wishlist.", "Error", "error");
                }
            }
        } catch (error) {
            console.error("Wishlist sync error:", error);
            if (typeof showCustomAlert === 'function') {
                showCustomAlert("A network error occurred. Please try again.", "Connection Error", "error");
            }
        }
    }


      document.addEventListener('DOMContentLoaded', function () {
        const swiper = new Swiper('.myHeroSwiper', {                                  // 'Swiper'/ 'swiper.js' is 'third-party', 'js' 'library'
            loop: true,                                                               // Slides infinitely
            autoplay: {
                delay: 3500,                                                          // Changes slide every 3.5 seconds
                disableOnInteraction: false,                                          // Keeps autoplaying after user clicks
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            effect: 'fade',                                                            // Optional: changes the slide effect to a smooth fade
        });
    });
</script>