<div class="bg-[#1e1e1e] w-full flex-1 flex items-center justify-center p-4 py-20">
    
    <div class="bg-[#f5f5f5] p-10 rounded-sm shadow-xl w-full max-w-md">
        
        <h2 class="text-center text-[#a87a7a] text-xl font-semibold mb-8">Forgot Your Password?</h2>

        <form action="/forgot-password" method="POST" class="space-y-6">
            
            <div class="flex flex-col">
                <input type="email" id="email" name="email" placeholder="Enter email address" required
                    class="w-full px-4 py-3 bg-[#e4e4e4] text-center text-gray-700 placeholder-gray-500 border border-transparent rounded-md focus:outline-none focus:ring-2 focus:ring-[#1e8436] font-medium transition">
            </div>

            <button type="submit"
                class="w-full bg-[#1e8436] hover:bg-[#156327] text-white font-semibold py-3 rounded-full transition duration-200 shadow-sm cursor-pointer">
                Reset password
            </button>
        </form>

        <div class="text-center mt-6">
            <a href="/login" class="text-sm text-gray-500 hover:text-gray-800 font-medium hover:underline transition tracking-wide">Back to Login</a>
        </div>

    </div>

</div>