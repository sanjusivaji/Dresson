<%- contentFor('body') %>

<!-- Shared Alerts -->
<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>

<!-- Razorpay Checkout Script (Crucial for the modal to work!) -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h1 class="text-3xl font-black text-gray-800 mb-8 tracking-tight">Checkout</h1>

    <form id="checkoutForm" class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Column -->
        <div class="lg:col-span-8 space-y-10">
            
            <!-- Order Items -->
            <section>
                <h2 class="text-base font-extrabold text-gray-900 mb-4">Order Items</h2>
                <div class="space-y-4">
                    <% if (cart && cart.items && cart.items.length > 0) { %>
                        <% cart.items.forEach(item => { %>
                            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                                <div class="flex items-center space-x-4">
                                    <img src="<%= item.image || '/images/default-dress.jpg' %>" alt="<%= item.name %>" class="w-10 h-14 object-cover rounded-md border border-gray-200">
                                    <div>
                                        <h3 class="text-sm font-bold text-gray-800"><%= item.name %></h3>
                                        <p class="text-[10px] text-gray-500 font-medium mt-0.5">
                                            <%= item.variantName || 'Standard' %> &nbsp;|&nbsp; Qty: <%= item.quantity %>
                                        </p>
                                    </div>
                                </div>
                                <span class="text-sm font-black text-gray-900">₹ <%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-sm text-red-500 font-semibold">Your cart is empty.</p>
                    <% } %>
                </div>
            </section>

            <!-- Delivery Address -->
            <section>
                <h2 class="text-base font-extrabold text-gray-900 mb-4">Delivery Address</h2>
                <div class="space-y-3">
                    <% if (addresses && addresses.length > 0) { %>
                        <% addresses.forEach((address, index) => { %>
                            <label class="flex items-center justify-between p-3 border border-gray-200 rounded-md cursor-pointer hover:border-gray-300 transition has-[:checked]:border-[#6b66d6] has-[:checked]:bg-[#f8f7ff]">
                                <div class="flex items-center space-x-3">
                                    <input type="radio" name="selectedAddress" value="<%= address._id %>" class="w-3.5 h-3.5 text-[#6b66d6] focus:ring-[#6b66d6] border-gray-300 cursor-pointer" <%= address.isDefault || index === 0 ? 'checked' : '' %>>
                                    <div class="text-xs">
                                        <span class="font-bold text-gray-800 mr-2 uppercase"><%= address.type || 'HOME' %></span>
                                        <span class="text-gray-600"><%= address.addressLine %>, <%= address.city %>, <%= address.state %> - <%= address.pincode %></span>
                                    </div>
                                </div>
                                <a href="/profile/address/edit/<%= address._id %>" class="px-3 py-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-[10px] font-bold rounded-sm transition">Edit</a>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p class="text-xs text-red-500 font-semibold mb-2">No addresses found. Please add a delivery address to continue.</p>
                    <% } %>

                    <a href="/profile/address/add" class="inline-block mt-2 px-4 py-2 bg-[#a39a96] hover:bg-[#8b837f] text-white text-[11px] font-bold rounded-md shadow-sm transition cursor-pointer">
                        Add new Address
                    </a>
                </div>
            </section>

            <!-- Payment Method -->
            <section>
                <h2 class="text-base font-extrabold text-gray-900 mb-4">Payment Method</h2>
                <div class="space-y-3">
                    <label class="flex items-center p-3.5 border border-gray-200 rounded-md cursor-pointer transition has-[:checked]:border-blue-400 has-[:checked]:bg-blue-50/30">
                        <input type="radio" name="paymentMethod" value="razorpay" class="w-3.5 h-3.5 text-blue-500 focus:ring-blue-400 border-gray-300 cursor-pointer">
                        <span class="ml-3 text-xs font-bold text-gray-700">Razorpay</span>
                    </label>

                    <label class="flex items-center p-3.5 border border-gray-200 rounded-md cursor-pointer transition has-[:checked]:border-blue-400 has-[:checked]:bg-blue-50/30">
                        <input type="radio" name="paymentMethod" value="card" class="w-3.5 h-3.5 text-blue-500 focus:ring-blue-400 border-gray-300 cursor-pointer" checked>
                        <span class="ml-3 text-xs font-bold text-gray-700">Debit / Credit card</span>
                    </label>

                    <label class="flex items-center p-3.5 border border-gray-200 rounded-md cursor-pointer transition has-[:checked]:border-blue-400 has-[:checked]:bg-blue-50/30">
                        <input type="radio" name="paymentMethod" value="cod" class="w-3.5 h-3.5 text-blue-500 focus:ring-blue-400 border-gray-300 cursor-pointer">
                        <span class="ml-3 text-xs font-bold text-gray-700">Cash On Delivery</span>
                    </label>

                    <label class="flex items-center p-3.5 border border-gray-200 rounded-md cursor-pointer transition has-[:checked]:border-blue-400 has-[:checked]:bg-blue-50/30">
                        <input type="radio" name="paymentMethod" value="wallet" class="w-3.5 h-3.5 text-blue-500 focus:ring-blue-400 border-gray-300 cursor-pointer">
                        <span class="ml-3 text-xs font-bold text-gray-700">Wallet</span>
                    </label>
                </div>
            </section>
        </div>

        <!-- Right Column (Summary & Coupon) -->
        <div class="lg:col-span-4">
            <div class="sticky top-6 flex flex-col items-center w-full max-w-xs mx-auto lg:mx-0">               
                
                <!-- Coupons Section -->
                <div class="w-full mb-8 flex flex-col items-center space-y-3 relative">
                    <button type="button" id="viewCouponBtn" class="w-48 flex items-center justify-between px-3 py-1.5 border border-gray-300 rounded-md bg-white text-xs font-semibold text-gray-600 shadow-sm transition hover:bg-gray-50">
                        <span>View Coupons</span>
                        <i class="fas fa-chevron-down text-[10px] transition-transform duration-200" id="couponChevron"></i>
                    </button>

                    <div id="couponDropdown" class="hidden absolute top-8 z-20 w-64 bg-white border border-gray-200 rounded-lg shadow-xl overflow-hidden mt-2">
                        <div class="max-h-56 overflow-y-auto p-2 space-y-2">
                            <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
                                <% coupons.forEach(coupon => { %>
                                    
                                    <div class="p-3 border border-dashed border-[#fc6c6c] rounded-md bg-[#fdf5f5] hover:bg-red-50 transition cursor-pointer" onclick="selectCoupon('<%= coupon.couponCode %>')">
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="font-black text-xs text-red-600 uppercase tracking-wider"><%= coupon.couponCode %></span>
                                            <span class="text-[10px] font-extrabold text-gray-700">
                                                <%= coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %> OFF
                                            </span>
                                        </div>
                                        <p class="text-[11px] font-bold text-gray-800"><%= coupon.couponName %></p>
                                        <p class="text-[9px] font-semibold text-gray-500 mt-0.5">
                                            Min spend: ₹<%= coupon.minCartValue %> 
                                            <% if (coupon.maxDiscount) { %> | Max discount: ₹<%= coupon.maxDiscount %> <% } %>
                                        </p>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-4 text-center text-xs font-semibold text-gray-500">
                                    No active coupons available right now.
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Check if a coupon is active on page load from the backend -->
                    <% const isCouponApplied = typeof appliedCoupon !== 'undefined' && appliedCoupon; %>

                    <!-- Dynamic Coupon Input -->
                    <input type="text" id="couponCode" name="couponCode" 
                        placeholder="Coupon Code" 
                        value="<%= isCouponApplied ? appliedCoupon : '' %>"
                        class="w-48 px-3 py-2 border-0 rounded-md text-center text-xs font-bold text-gray-800 uppercase placeholder-gray-400 focus:ring-2 focus:ring-[#fc6c6c] outline-none transition <%= isCouponApplied ? 'bg-green-50 border-green-500 text-green-700' : 'bg-[#fdf5f5]' %>"
                        <%= isCouponApplied ? 'readonly' : '' %>>
                    
                    <!-- Dynamic Apply & Remove Buttons -->
                    <div class="flex gap-2">
                        <button type="button" id="applyCouponBtn" class="w-32 py-1.5 bg-[#9c9c9c] hover:bg-gray-500 text-white text-xs font-bold rounded-md shadow-sm transition <%= isCouponApplied ? 'hidden' : '' %>">
                            Apply
                        </button>
                        <button type="button" id="removeCouponBtn" class="w-32 py-1.5 bg-red-100 hover:bg-red-200 text-red-700 text-xs font-bold rounded-md shadow-sm transition <%= isCouponApplied ? '' : 'hidden' %>">
                            Remove
                        </button>
                    </div>

                    <p id="couponFeedback" class="w-full text-center text-[10px] font-bold mt-2 hidden"></p>
                </div>

                <!-- Order Summary Section -->
                <div class="w-full">
                    <h2 class="text-base font-extrabold text-gray-900 mb-4 text-center">Order Summary</h2>
                    
                    <div class="space-y-2 text-xs font-semibold text-gray-500 mb-6 px-4">
                        <div class="flex justify-between">
                            <span>Sub Total</span>
                            <span class="text-gray-800">₹ <%= totals.subTotal.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping</span>
                            <span id="summary-shipping" class="text-gray-800">₹ <%= totals.shipping.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Estimated Tax</span>
                            <span id="summary-tax" class="text-gray-800">₹ <%= totals.tax ? totals.tax.toLocaleString('en-IN') : '0' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Discount</span>
                            <span id="summary-discount" class="text-gray-800">- ₹ <%= totals.discount.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="flex justify-between pt-2 mt-2 border-t border-gray-200 text-sm font-black text-gray-900">
                            <span>Grand Total</span>
                            <span id="summary-grand-total">₹ <%= totals.grandTotal.toLocaleString('en-IN') %></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col items-center space-y-3">
                        <button type="button" id="confirmPaymentBtn" <%= (!addresses || addresses.length === 0) ? 'disabled' : '' %> class="w-48 py-2 bg-[#3da436] hover:bg-green-700 text-white text-xs font-bold rounded-md shadow-sm transition disabled:bg-gray-400 disabled:cursor-not-allowed">
                            Confirm Payment
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // For 'drop down' 'coupons'
        const viewCouponBtn = document.getElementById('viewCouponBtn');
        const couponDropdown = document.getElementById('couponDropdown');
        const couponChevron = document.getElementById('couponChevron');        
        viewCouponBtn.addEventListener('click', (e) => {                       
            e.stopPropagation(); 
            couponDropdown.classList.toggle('hidden');
            couponChevron.classList.toggle('rotate-180');
        });
        document.addEventListener('click', (e) => {
            if (!couponDropdown.contains(e.target) && !viewCouponBtn.contains(e.target)) {
                couponDropdown.classList.add('hidden');
                couponChevron.classList.remove('rotate-180');
            }
        });

        // For 'apply coupon' and 'remove coupon'
        const applyCouponBtn = document.getElementById('applyCouponBtn');
        const removeCouponBtn = document.getElementById('removeCouponBtn');
        const couponInput = document.getElementById('couponCode');
        const couponFeedback = document.getElementById('couponFeedback');


        function showFeedback(message, isError = true) {
            couponFeedback.innerText = message;
            couponFeedback.classList.remove('hidden', 'text-green-600', 'text-red-500');
            if (isError) {
                couponFeedback.classList.add('text-red-500');
            } else {
                couponFeedback.classList.add('text-green-600');
            }
        }

        // Apply Coupon Event
        applyCouponBtn.addEventListener('click', async () => {
            const code = couponInput.value.trim();
            couponFeedback.classList.add('hidden');       
            
            if (!code) {
                showFeedback("Please enter a coupon code.");
                return;
            }
            try {
                applyCouponBtn.innerText = 'Applying...';
                applyCouponBtn.disabled = true;
                
                const response = await fetch('/checkout/apply-coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ couponCode: code })
                });
                const data = await response.json();
                
                if (data.success) {
                    showFeedback(data.message, false);                                          
                    document.getElementById('summary-discount').innerText = `- ₹ ${data.newTotals.discount.toLocaleString('en-IN')}`;
                    document.getElementById('summary-tax').innerText = `₹ ${data.newTotals.tax.toLocaleString('en-IN')}`;
                    document.getElementById('summary-shipping').innerText = `₹ ${data.newTotals.shipping.toLocaleString('en-IN')}`;
                    document.getElementById('summary-grand-total').innerText = `₹ ${data.newTotals.grandTotal.toLocaleString('en-IN')}`;                    
                    couponInput.classList.add('border-green-500', 'bg-green-50', 'text-green-700');
                    couponInput.setAttribute('readonly', true);
                    applyCouponBtn.classList.add('hidden');
                    removeCouponBtn.classList.remove('hidden');
                } else {
                    showFeedback(data.message, true);
                }
            } finally {     
                applyCouponBtn.innerText = 'Apply';                                              
                applyCouponBtn.disabled = false;
            }
        });

        // For 'remove' coupon
        removeCouponBtn.addEventListener('click', async () => {
            try {
                removeCouponBtn.innerText = 'Removing...';
                removeCouponBtn.disabled = true;
                const response = await fetch('/checkout/remove-coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const data = await response.json();
                if (data.success) {
                    showFeedback("Coupon removed.", false);
                    document.getElementById('summary-discount').innerText = `- ₹ 0`;
                    document.getElementById('summary-tax').innerText = `₹ ${data.newTotals.tax.toLocaleString('en-IN')}`;
                    document.getElementById('summary-shipping').innerText = `₹ ${data.newTotals.shipping.toLocaleString('en-IN')}`;
                    document.getElementById('summary-grand-total').innerText = `₹ ${data.newTotals.grandTotal.toLocaleString('en-IN')}`;
                    couponInput.value = '';
                    couponInput.classList.remove('border-green-500', 'bg-green-50', 'text-green-700');
                    couponInput.removeAttribute('readonly');
                    removeCouponBtn.classList.add('hidden');
                    applyCouponBtn.classList.remove('hidden');
                } else {
                    showFeedback(data.message || "Failed to remove coupon.", true);
                }
            } catch (error) {
                showFeedback("An error occurred. Please try again.", true);
            } finally {
                removeCouponBtn.innerText = 'Remove';
                removeCouponBtn.disabled = false;
            }
        });
        
        // Razorpay logic
        const confirmBtn = document.getElementById('confirmPaymentBtn');
        const paymentRadios = document.querySelectorAll('input[name="paymentMethod"]');
        paymentRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === 'cod') {
                    confirmBtn.innerText = 'Place Order';
                } else {
                    confirmBtn.innerText = 'Confirm Payment';
                }
            });
        });
        confirmBtn.addEventListener('click', async function(e) {
            e.preventDefault();        
            const selectedAddressEl = document.querySelector('input[name="selectedAddress"]:checked');
            if (!selectedAddressEl) {
                alert("Please select a delivery address.");
                return;
            }
            const selectedAddress = selectedAddressEl.value;
            const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;

            // Prevent Double Clicks
            this.disabled = true;
            const originalText = this.innerText;
            this.innerText = 'Processing...';
            try {
                const response = await fetch('/checkout/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ selectedAddress, paymentMethod })
                });                
                const data = await response.json();
                if (!data.success) {
                    alert(data.message || "Failed to process order.");
                    this.disabled = false;
                    this.innerText = originalText;
                    return;
                }
                if (data.paymentMethod === 'razorpay') {
                    const options = {
                        "key": data.key, 
                        "amount": data.razorpayOrder.amount, 
                        "currency": "INR",
                        "name": "Dresson",
                        "description": "Order Payment",
                        "order_id": data.razorpayOrder.id,
                        "handler": async function (response) {
                            try {
                                const verifyRes = await fetch('/checkout/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_signature: response.razorpay_signature,
                                        orderId: data.orderId
                                    })
                                });
                                if (!verifyRes.ok) {
                                    throw new Error(`HTTP error! status: ${verifyRes.status}`);
                                }
                                const verifyData = await verifyRes.json();                            
                                if (verifyData.success) {
                                    window.location.href = `/order-success?id=${data.orderId}`;
                                } else {
                                    alert("Payment verification failed: " + verifyData.message);
                                    confirmBtn.disabled = false;
                                    confirmBtn.innerText = originalText;
                                }
                            } catch (err) {
                                console.error("Frontend Verification Error:", err);
                                alert("Error verifying payment! Please check the console for details.");
                                confirmBtn.disabled = false;
                                confirmBtn.innerText = originalText;
                            }
                        },
                        
                        "modal": {
                            "ondismiss": function(){
                                confirmBtn.disabled = false;
                                confirmBtn.innerText = originalText;
                            }
                        },
                        "theme": {
                            "color": "#fc6c6c" 
                        }
                    };                    
                    const rzp1 = new Razorpay(options);
                    rzp1.on('payment.failed', function (response){
                        alert("Payment Failed: " + response.error.description);
                        confirmBtn.disabled = false;
                        confirmBtn.innerText = originalText;
                    });
                    rzp1.open();
                } 
                else {
                    window.location.href = `/order-success?id=${data.orderId}`;
                }
            } catch (error) {
                console.error("Error processing checkout:", error);
                alert("Something went wrong processing your checkout.");
                this.disabled = false;
                this.innerText = originalText;
            }
        });
    });

    // 'Helper function' for 'select' the coupon
    function selectCoupon(code) {
        const isCouponActive = !document.getElementById('removeCouponBtn').classList.contains('hidden');
        const feedbackEl = document.getElementById('couponFeedback');      
        if (isCouponActive) {
            feedbackEl.innerText = "Please remove the currently applied coupon first.";
            feedbackEl.classList.remove('hidden', 'text-green-600');
            feedbackEl.classList.add('text-red-500');
            document.getElementById('couponDropdown').classList.add('hidden');
            document.getElementById('couponChevron').classList.remove('rotate-180');
            return; 
        }
        document.getElementById('couponCode').value = code;
        document.getElementById('couponDropdown').classList.add('hidden');
        document.getElementById('couponChevron').classList.remove('rotate-180');
        feedbackEl.classList.add('hidden');
    }
</script>