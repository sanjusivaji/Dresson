<%- contentFor('body') %>

<div class="w-full max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row gap-8">

     <%- include('../partial/user/userSidebar') %>
  
    <main class="w-full flex-1">        
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-black">Edit Address</h1>
            <a href="/profile/address" class="bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold py-2 px-4 rounded-md transition shadow-sm border border-gray-300">
                Back to Address
            </a>
        </div>
        <div class="bg-white rounded-xl max-w-2xl">            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 shadow-sm">
                    <p class="font-bold">Error</p>
                    <p><%= error %></p>
                </div>
            <% } %>
           
           <!-- Added ID to form for strict JS targeting -->
           <form id="editAddressForm" action="/profile/address/edit/<%= address._id %>" method="POST" class="space-y-6" novalidate>    
           <% if (typeof returnTo !== 'undefined' && returnTo) { %>
                <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <% } %>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">Full Name</label>
                <input type="text" name="fullName" id="fullName" 
                    value="<%= locals.formData && formData.fullName ? formData.fullName : address.fullName %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="fullNameError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                <!-- Maxlength added for phone -->
                <input type="text" name="phone" id="phone" maxlength="10"
                    value="<%= locals.formData && formData.phone ? formData.phone : address.phone %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="phoneError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">Street Address</label>
                <input type="text" name="streetAddress" id="streetAddress" 
                    value="<%= locals.formData && formData.streetAddress ? formData.streetAddress : address.addressLine %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="streetAddressError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">City</label>
                <input type="text" name="city" id="city" 
                    value="<%= locals.formData && formData.city ? formData.city : address.city %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="cityError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">State</label>
                <input type="text" name="state" id="state" 
                    value="<%= locals.formData && formData.state ? formData.state : address.state %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="stateError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>

            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">Pin Code</label>
                <!-- Maxlength added for pincode -->
                <input type="text" name="pinCode" id="pinCode" maxlength="6"
                    value="<%= locals.formData && formData.pinCode ? formData.pinCode : address.pincode %>" 
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition">
                <p id="pinCodeError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1">Country</label>
                <% const countries = ['Australia', 'Brazil', 'Canada', 'China', 'France', 'Germany', 'India', 'Italy', 'Japan', 'Mexico', 'Netherlands', 'New Zealand', 'Russia', 'Saudi Arabia', 'Singapore', 'South Africa', 'South Korea', 'Spain', 'Switzerland', 'United Arab Emirates', 'United Kingdom', 'United States']; %>
                <select name="country" id="country" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#8b3d3d] transition text-gray-700 cursor-pointer">
                    <option value="">Select Country</option>
                    <% countries.forEach(c => { %>
                        <% const isSelected = (locals.formData && formData.country === c) || (!locals.formData && address.country === c) || (!locals.formData && !address.country && c === 'India'); %>
                        <option value="<%= c %>" <%= isSelected ? 'selected' : '' %>><%= c %></option>
                    <% }); %>
                </select>
                <p id="countryError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
            </div>
            <div class="flex justify-start gap-4 pt-2">
                <% const currentType = locals.formData && formData.type ? formData.type : address.type; %>
                <label class="cursor-pointer">
                    <input type="radio" name="type" value="HOME" class="peer sr-only" <%= currentType === 'HOME' ? 'checked' : '' %>>
                    <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">HOME</div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="type" value="WORK" class="peer sr-only" <%= currentType === 'WORK' ? 'checked' : '' %>>
                    <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">WORK</div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="type" value="OTHER" class="peer sr-only" <%= currentType === 'OTHER' ? 'checked' : '' %>>
                    <div class="px-6 py-2 border border-gray-300 text-gray-600 font-bold text-xs uppercase rounded-sm peer-checked:bg-gray-900 peer-checked:text-white peer-checked:border-gray-900 transition">OTHERS</div>
                </label>
            </div>
            <div class="flex items-center gap-2 pt-2 pb-4">
                <% const isChecked = locals.formData ? formData.isDefault : address.isDefault; %>
                <input type="checkbox" name="isDefault" id="isDefault" class="w-4 h-4 text-red-900 focus:ring-red-900 border-gray-300 rounded cursor-pointer" <%= isChecked ? 'checked' : '' %>>
                <label for="isDefault" class="text-sm font-medium text-gray-700 cursor-pointer">Make this Default</label>
            </div>
            <div class="flex justify-center gap-4 pt-4">
                <button type="submit" class="bg-red-900 text-white hover:text-white hover:bg-red-950 font-bold py-3 px-8 rounded-full transition text-sm shadow-md cursor-pointer uppercase tracking-wider">
                    Update Address
                </button>
                <a href="/profile/address" class="bg-black text-white hover:text-white hover:bg-gray-800 font-bold py-3 px-8 rounded-full transition text-sm shadow-md cursor-pointer uppercase tracking-wider flex items-center">
                    Cancel
                </a>
            </div>
        </form>
        </div>
    </main>
</div>

<script>
function showError(elementId, message) {
    const errorDiv = document.getElementById(elementId);
    if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.remove('hidden');
    }
}

function hideError(elementId) {
    const errorDiv = document.getElementById(elementId);
    if (errorDiv) {
        errorDiv.classList.add('hidden');
    }
}
const textOnlyFields = ['fullName', 'city', 'state'];
textOnlyFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
        el.addEventListener('input', function() {
            this.value = this.value.replace(/[^a-zA-Z\s]/g, ''); // Instantly removes numbers/special chars
            hideError(id + 'Error');
        });
    }
});

// Block letters in Phone and Pincode
const numberOnlyFields = ['phone', 'pinCode'];
numberOnlyFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
        el.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, ''); // Instantly removes letters/special chars
            hideError(id + 'Error');
        });
    }
});

// Address allows alphanumeric, just clear error on type
document.getElementById('streetAddress').addEventListener('input', function() {
    hideError('streetAddressError');
});

// Country dropdown, clear error on change
document.getElementById('country').addEventListener('change', function() {
    hideError('countryError');
});


// For 'validation' when '<form>' submission
document.getElementById('editAddressForm').addEventListener('submit', function(e) {
    const errorElements = ['fullNameError', 'phoneError', 'streetAddressError', 'cityError', 'stateError', 'pinCodeError', 'countryError'];
    errorElements.forEach(id => hideError(id));
    let isValid = true;
    const fullName = document.getElementById('fullName').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const streetAddress = document.getElementById('streetAddress').value.trim();
    const city = document.getElementById('city').value.trim();
    const state = document.getElementById('state').value.trim();
    const pinCode = document.getElementById('pinCode').value.trim();
    const country = document.getElementById('country').value;
    const nameRegex = /^[a-zA-Z\s]{3,50}$/; 
    const phoneRegex = /^[0-9]{10}$/;       
    const pinRegex = /^[0-9]{6}$/;          
    const cityStateRegex = /^[a-zA-Z\s]+$/; 
    if (!fullName || !nameRegex.test(fullName)) {
        showError('fullNameError', 'Must be 3-50 characters and contain only letters.');
        isValid = false;
    }
    if (!phone || !phoneRegex.test(phone)) {
        showError('phoneError', 'Please enter a valid 10-digit phone number.');
        isValid = false;
    }
    if (!streetAddress || streetAddress.length < 5) {
        showError('streetAddressError', 'Street Address must be at least 5 characters long.');
        isValid = false;
    }
    if (!city || !cityStateRegex.test(city)) {
        showError('cityError', 'City must contain only letters.');
        isValid = false;
    }
    if (!state || !cityStateRegex.test(state)) {
        showError('stateError', 'State must contain only letters.');
        isValid = false;
    }
    if (!pinCode || !pinRegex.test(pinCode)) {
        showError('pinCodeError', 'Please enter a valid 6-digit Pincode.');
        isValid = false;
    }
    if (!country) {
        showError('countryError', 'Please select a country.');
        isValid = false;
    }

    if (!isValid) {
        e.preventDefault(); 
    }
});
</script>