<%- contentFor('body') %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col items-center">
    
    <!-- Success Heading -->
    <h1 class="text-3xl md:text-4xl font-semibold text-[#4cbe44] mb-10 text-center tracking-wide">
        Your Order Successfully Placed
    </h1>

    <!--  Thank You Banner image with 'clickable url'-->
    <% if (typeof thankYouBanner !== 'undefined' && thankYouBanner) { %>
        <div class="w-full max-w-4xl mx-auto my-6 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition">
            <% if (thankYouBanner.targetUrl) { %>
                <a href="<%= thankYouBanner.targetUrl %>" class="block w-full">
            <% } %>                
                <img src="<%= thankYouBanner.imageUrl %>" alt="<%= thankYouBanner.title %>" class="w-full h-auto object-cover">
            
            <% if (thankYouBanner.targetUrl) { %>
                </a>
            <% } %>
            
        </div>
    <% } %>

    <!-- Order Details & Actions Section -->
    <div class="w-full max-w-3xl flex flex-col md:flex-row justify-between items-center md:items-end px-4 md:px-12 space-y-6 md:space-y-0">
        
        <!-- Left Side: Order Info -->
        <div class="space-y-4 text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center space-y-1 md:space-y-0 md:space-x-8 text-sm font-semibold text-gray-800">
                <span class="text-gray-500 min-w-[120px]">Order number</span>
                <span class="font-bold"><%= orderNumber %></span>
            </div>
            
            <div class="flex flex-col md:flex-row md:items-center space-y-1 md:space-y-0 md:space-x-8 text-sm font-semibold text-gray-800">
                <span class="text-gray-500 min-w-[120px]">Estimated delivery</span>
                <span class="font-bold"><%= estimatedDelivery %></span>
            </div>
        </div>

        <!-- Right Side: Order Details Button -->
        <div>
            <!-- Links directly to the specific order details page -->
            <a href="/profile/orders/<%= dbOrderId %>" class="inline-block px-8 py-2.5 bg-[#a39a96] hover:bg-[#8b837f] text-white text-sm font-bold rounded-md shadow-sm transition">
                Order Details
            </a>
        </div>

    </div>

</main>