<aside class="w-full md:w-64 shrink-0 space-y-5">
    
    <div class="bg-white p-5 rounded-sm border border-gray-200 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Sort By</h3>
        <select class="w-full bg-gray-50 border border-gray-200 rounded-sm px-3 py-2 text-xs font-semibold text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 cursor-pointer">
            <option>Price (Low - High)</option>
            <option>Price (High - Low)</option>
            <option>Newest Arrivals</option>
            <option>Popularity</option>
        </select>
    </div>

    <div class="bg-white p-5 rounded-sm border border-gray-200 shadow-sm space-y-5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 border-b border-gray-100 pb-2">Filter By</h3>
        
        <div>
            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Categories</label>
            <select class="w-full bg-gray-50 border border-gray-200 rounded-sm px-2 py-1.5 text-xs text-gray-600 focus:outline-none cursor-pointer">
                <option>All Categories</option>
                <option>Shirts</option>
                <option>Dresses</option>
                <option>Trousers</option>
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Brands</label>
            <div class="space-y-2 text-xs font-medium text-gray-600">
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" name="brand" value="Raymond" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>Raymond</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" name="brand" value="BBA" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>BBA</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" name="brand" value="Pepe Jeans" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>Pepe Jeans</span>
                </label>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Select Size</label>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="w-9 h-9 border border-gray-300 text-xs font-bold rounded-sm flex items-center justify-center hover:border-gray-900 transition bg-white text-gray-800 focus:bg-gray-900 focus:text-white">S</button>
                <button type="button" class="w-9 h-9 border border-gray-300 text-xs font-bold rounded-sm flex items-center justify-center hover:border-gray-900 transition bg-white text-gray-800 focus:bg-gray-900 focus:text-white">M</button>
                <button type="button" class="w-9 h-9 border border-gray-300 text-xs font-bold rounded-sm flex items-center justify-center hover:border-gray-900 transition bg-white text-gray-800 focus:bg-gray-900 focus:text-white">L</button>
                <button type="button" class="w-9 h-9 border border-gray-300 text-xs font-bold rounded-sm flex items-center justify-center hover:border-gray-900 transition bg-white text-gray-800 focus:bg-gray-900 focus:text-white">XL</button>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Fabric</label>
            <div class="space-y-2 text-xs font-medium text-gray-600">
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>Cotton</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>Linen</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                    <input type="checkbox" class="w-3.5 h-3.5 rounded-sm border-gray-300 text-gray-900 accent-gray-900">
                    <span>Polyester</span>
                </label>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 mb-1 uppercase tracking-wide">Price Range</label>
            <input type="range" min="0" max="5000" step="100" class="w-full accent-gray-800 h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer">
            <div class="flex justify-between text-[10px] font-bold text-gray-400 mt-1">
                <span>₹0</span>
                <span>₹5000</span>
            </div>
        </div>

        <button type="button" class="w-full border border-gray-200 hover:border-gray-900 text-gray-700 text-xs font-bold py-2 rounded-sm transition bg-gray-50 hover:bg-white mt-2">
            Clear All Filters
        </button>

    </div>
</aside>
