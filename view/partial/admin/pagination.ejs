

<div class="flex items-center justify-center gap-2 text-xs font-semibold text-gray-500 pt-4">
    
    <% if (currentPage > 1) { %>
        <a href="<%= baseUrl %>?page=<%= currentPage - 1 %>" class="w-6 h-6 flex items-center justify-center rounded border hover:bg-gray-100">
            <i class="fa-solid fa-chevron-left text-[10px]"></i>
        </a>
    <% } %>

    <% for(let i = 1; i <= totalPages; i++) { %>
        <a href="<%= baseUrl %>?page=<%= i %>" 
           class="w-6 h-6 flex items-center justify-center rounded border <%= currentPage === i ? 'bg-gray-900 text-white' : 'hover:bg-gray-100' %>">
            <%= i %>
        </a>
    <% } %>

    <% if (currentPage < totalPages) { %>
        <a href="<%= baseUrl %>?page=<%= currentPage + 1 %>" class="w-6 h-6 flex items-center justify-center rounded border hover:bg-gray-100">
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
    <% } %>

</div>