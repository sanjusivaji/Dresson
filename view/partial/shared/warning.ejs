<!-- This 'warning' file is replace 'alert()', 'confirm()' like methods and it display 'warning' messages in different scenario ie it can display if 'type' is 'error' (red), 'success' (green), 'warning' (yellow) 'info' (blue). -->
<div id="customModalOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl transform transition-all text-center border border-gray-100">
        <div id="customModalIconContainer" class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-red-100 mb-4 shadow-inner">
            <i id="customModalIcon" class="fa-solid fa-triangle-exclamation text-red-600 text-2xl"></i>
        </div>
        <h3 id="customModalTitle" class="text-lg font-bold text-gray-900 mb-2">Notice</h3>
        <p id="customModalMessage" class="text-xs text-gray-600 mb-6 font-medium leading-relaxed">Message display here.</p> 
        <div class="flex justify-center items-center gap-3" id="customModalButtons">
            <button type="button" id="customModalCancelBtn" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2.5 px-6 rounded-full text-xs uppercase tracking-wider transition cursor-pointer hidden">
                Cancel
            </button>
            <button type="button" id="customModalConfirmBtn" class="bg-red-900 hover:bg-red-950 text-white font-bold py-2.5 px-6 rounded-full text-xs uppercase tracking-wider transition cursor-pointer shadow-md">
                OK
            </button>
        </div>
    </div>
</div>

<script>
// For 'display' 'warning' message
function showCustomAlert(message, title = 'Notice', type = 'info') {
    const overlay = document.getElementById('customModalOverlay');               // 'customModalOverlay' is the '<div>' container 
    document.getElementById('customModalTitle').textContent = title;
    document.getElementById('customModalMessage').textContent = message;    
    const iconContainer = document.getElementById('customModalIconContainer');
    const icon = document.getElementById('customModalIcon');
    const confirmBtn = document.getElementById('customModalConfirmBtn');        // For 'confirm button'
    confirmBtn.className = "text-white font-bold py-2.5 px-6 rounded-full text-xs uppercase tracking-wider transition cursor-pointer shadow-md";
    if (type === 'error') {
        iconContainer.className = "mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-red-100 mb-4 shadow-inner";
        icon.className = "fa-solid fa-circle-xmark text-red-600 text-2xl";     // 'className' is the 'built-in' 'DOM' method used for give 'class name' only 'if condition' true/
        confirmBtn.classList.add('bg-red-600', 'hover:bg-red-700');
    } else if (type === 'success') {
        iconContainer.className = "mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-green-100 mb-4 shadow-inner";
        icon.className = "fa-solid fa-circle-check text-green-600 text-2xl";
        confirmBtn.classList.add('bg-green-600', 'hover:bg-green-700');
    } else if (type === 'warning') {
        iconContainer.className = "mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-yellow-100 mb-4 shadow-inner";
        icon.className = "fa-solid fa-triangle-exclamation text-yellow-600 text-2xl";
        confirmBtn.classList.add('bg-amber-600', 'hover:bg-amber-700');
    } else {
        iconContainer.className = "mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-blue-100 mb-4 shadow-inner";
        icon.className = "fa-solid fa-circle-info text-blue-600 text-2xl";
        confirmBtn.classList.add('bg-gray-900', 'hover:bg-gray-800');
    }
    document.getElementById('customModalCancelBtn').classList.add('hidden');
    confirmBtn.textContent = 'OK';                                            // After make 'cancel' button 'invisible' here display 'OK'.
    confirmBtn.onclick = () => overlay.classList.add('hidden');               // Here 'onclick' is the 'html' element property normally attatched with a 'function'(here 'arrow' function)and it value is 'overlay.classList.add('hidden')'(ie make 'overlay' element 'invisible')
    overlay.classList.remove('hidden');                                       // Here 'above' operation is 'asynchronous' ie it works only when click 'confirm button' but here we make invisible/hidden 'overlay' instantly, ie 'overlay' already hidden.
}
// For display 'confirm' message
function showCustomConfirm(message, onConfirm, title = 'Are you sure?') {      // We call this 'function' from 'address.ejs' like files with 'path'
    const overlay = document.getElementById('customModalOverlay');
    document.getElementById('customModalTitle').textContent = title;           // We put 'Message goes here" like 'place holder' message in 'ejs', but it replaced by this 'title' message.
    document.getElementById('customModalMessage').textContent = message;       // We adds 'custom' message instead 'placeholder' message 'Message display here'
    const iconContainer = document.getElementById('customModalIconContainer'); // This is 'container' for 'icon'
    const icon = document.getElementById('customModalIcon');
    iconContainer.className = "mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-yellow-100 mb-4 shadow-inner";
    icon.className = "fa-solid fa-triangle-exclamation text-yellow-600 text-2xl";  // className=“ “ add new ‘class’ name but ‘remove’ ‘existing’ all classes but 'classList.add()' add new ‘class’ with ‘existing’ classes.
    const cancelBtn = document.getElementById('customModalCancelBtn');
    cancelBtn.classList.remove('hidden');
    cancelBtn.onclick = () => overlay.classList.add('hidden');
    const confirmBtn = document.getElementById('customModalConfirmBtn');
    confirmBtn.className = "bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-6 rounded-full text-xs uppercase tracking-wider transition cursor-pointer shadow-md";
    confirmBtn.textContent = 'Yes, Continue';                                  // Above code give 'structure' and this code give a 'text' to 'confirm button'
    confirmBtn.onclick = () => {
        overlay.classList.add('hidden');
        if (typeof onConfirm === 'function') onConfirm();                     // 'onConfirm' is the 'parameter' and its argument passes from 'address.ejs' like files              
    };
    overlay.classList.remove('hidden');
}
// For 'display' 'warning' or 'error' message come through 'url'
document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const warningMsg = urlParams.get('warning');
    const errorMsg = urlParams.get('error');
    if (warningMsg) {                                                      // For display 'warning message'
        const cleanText = decodeURIComponent(warningMsg);        
        if (typeof showCustomAlert === 'function') {                       
            showCustomAlert(cleanText, "Stock Limit Reached", "warning");
        } else {
            alert(" Notice: " + cleanText);
        }        
        cleanUrlBar(urlParams, 'warning');                                 // This 'custom' function created below for 'clean' the 'url'
    } 
    else if (errorMsg) {                                                    // For display 'error message'
        const cleanText = decodeURIComponent(errorMsg);        
        if (typeof showCustomAlert === 'function') {
            showCustomAlert(cleanText, "Action Blocked", "error");
        } else {
            alert(" Error: " + cleanText);
        }        
        cleanUrlBar(urlParams, 'error');
    }
});
// For 'cleaning' the 'url' parameters without reloading the page.
function cleanUrlBar(urlParams, paramToDelete) {                           // Here 'urlParams' is the 'query params'(ie it contains data only after '?' because of 'new URLSearchParams(window.location.search)'') and 'paramToDelete' is 'warning' 'key' and its 'value' and below we 'delete' 'warning' key
    urlParams.delete(paramToDelete);                                       // For 'delete' the 'warning' key.
    const newQuery = urlParams.toString();
    const newUrl = window.location.pathname + (newQuery ? '?' + newQuery : '') + window.location.hash;
    window.history.replaceState({ path: newUrl }, '', newUrl);
}
</script>