<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sales Report - Dresson</title>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; margin: 0; padding: 20px; font-size: 12px; }
        .header { margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        h1 { font-size: 20px; color: #111; margin: 0; }
        .meta { color: #666; font-size: 10px; margin-top: 5px; }
        
        /* Summary Box Layout */
        .summary-box { 
            margin-top: 20px; 
            margin-bottom: 20px;
            background: #f8f9fa; 
            padding: 15px; 
            border-radius: 5px; 
            width: 300px; 
        }
        .summary-row { 
            margin-bottom: 6px; 
            font-size: 12px;
        }
        .summary-label { 
            font-weight: bold; 
            color: #555; 
            display: inline-block;
            width: 140px; 
        }
        .summary-value {
            font-weight: bold;
            color: #111;
        }

        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; }
        th { background-color: #f8f9fa; font-weight: bold; color: #444; font-size: 10px; text-transform: uppercase; }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h1>Dresson Sales Report</h1>
            <div class="meta">Generated on: <%= new Date().toLocaleDateString('en-IN') %></div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <% if (locals.stats) { %>
    <div class="summary-box">
        <div class="summary-row"><span class="summary-label">Total Revenue:</span> <span class="summary-value">₹<%= locals.stats.totalSales.toLocaleString('en-IN') %></span></div>
        <div class="summary-row"><span class="summary-label">Total Orders:</span> <span class="summary-value"><%= locals.stats.totalOrders %></span></div>
        <div class="summary-row"><span class="summary-label">Total Products Sold:</span> <span class="summary-value"><%= locals.stats.totalProductsSold %></span></div>
        <div class="summary-row"><span class="summary-label">Total Discounts:</span> <span class="summary-value">₹<%= locals.stats.totalDiscounts.toLocaleString('en-IN') %></span></div>
    </div>
    <% } %>

    <!-- Orders Table -->
    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Discount</th>
                <th>Total (INR)</th>
            </tr>
        </thead>
        <tbody>
            <% if (locals.orders && orders.length > 0) { %>
                <% orders.forEach(order => { %>
                    <tr>
                        <td><%= order.orderId %></td>
                        <td><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
                        <td><%= order.shippingAddress?.fullName || 'N/A' %></td>
                        <td><%= order.paymentMethod %></td>
                        <td><%= order.deliveryStatus %></td>
                        <td>₹<%= order.discountAmount || 0 %></td>
                        <td>₹<%= order.totalAmount.toLocaleString('en-IN') %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" style="text-align: center; color: #777;">No orders found for this report range.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>