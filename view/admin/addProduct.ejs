<div class="mb-6">
    <a href="/admin/products" class="text-xs font-semibold text-gray-400 hover:text-gray-600 transition flex items-center space-x-2">
        <i class="fas fa-arrow-left"></i>
        <span>Back to Products List</span>
    </a>
</div>

<div class="mb-8">
    <h1 class="text-3xl font-bold text-black tracking-tight">Add New Product</h1>
    <p class="text-xs text-gray-400 mt-1">Configure your product identity, gallery media assets, variants matrix, and categories.</p>
</div>

<%- include('../partial/shared/alertSuccess') %>
<%- include('../partial/shared/alertError') %>
<%- include('../partial/shared/warning') %>

<!-- Serialized Database Categories for Client-Side Filtering -->
<input type="hidden" id="rawServerCategories" value='<%= typeof categories !== "undefined" ? JSON.stringify(categories) : "[]" %>'>

<form action="/admin/products/add" method="POST" enctype="multipart/form-data" id="productForm" class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 max-w-4xl mb-12">
    
    <!-- INVISIBLE ANCESTOR LINEAGE TRACKER: Automatically submits all 4 hierarchy level IDs! -->
    <div id="ancestorsContainer" class="hidden"></div>

    <!-- SECTION 1: Product Identity & Categories -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="space-y-6">
            <div class="flex flex-col">
                <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Name</label>
                <input type="text" id="baseName" name="productName" required placeholder="e.g., Premium Comfort Polo Tee" 
                       value="<%= locals.formData && formData.productName ? formData.productName : '' %>"
                       class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-50/30 shadow-sm transition font-medium">
            </div>

            <div class="flex flex-col">
                <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Brand</label>
                <input type="text" id="brandName" name="brand" required placeholder="e.g., Levi's, Zara, Dresson Original" 
                       value="<%= locals.formData && formData.brand ? formData.brand : '' %>"
                       class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition font-medium">
            </div>
        </div>

        <div class="space-y-6">
            <div class="flex flex-col">
                <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Parent Category (Gender Target)</label>
                <select id="parentCategory" name="parentCategory" required onchange="handleParentCategoryChange()" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition cursor-pointer font-medium text-gray-800">
                    <option value="" disabled selected>Select Gender Target Room</option>
                    <option value="Men" <%= locals.formData && formData.parentCategory === 'Men' ? 'selected' : '' %>>Men</option>
                    <option value="Women" <%= locals.formData && formData.parentCategory === 'Women' ? 'selected' : '' %>>Women</option>
                    <option value="Kids" <%= locals.formData && formData.parentCategory === 'Kids' ? 'selected' : '' %>>Kids</option>
                </select>
            </div>

            <div class="flex flex-col">
                <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Sub-Category Assignment Tree</label>
                <!-- ADDED: onchange="handleSubCategoryChange()" to track all 4 hierarchy levels! -->
                <select id="subCategory" name="subCategory" required disabled onchange="handleSubCategoryChange()" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-100 shadow-sm transition cursor-not-allowed font-medium text-gray-800">
                    <option value="" disabled selected>Please select a gender target first</option>
                </select>
            </div>
        </div>

        <div class="md:col-span-2 flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Rich Description</label>
            <textarea name="description" required rows="3" placeholder="Detail fabric metrics, cut attributes, care instructions..." 
                      class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-50/30 shadow-sm transition resize-none font-medium"><%= locals.formData && formData.description ? formData.description : '' %></textarea>
        </div>
        
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Discount Offer (% Off)</label>
            <div class="relative">
                <input type="number" id="discountPercent" name="discount" min="0" max="99" placeholder="0" 
                       value="<%= locals.formData && formData.discount ? formData.discount : '0' %>"
                       class="w-full border border-gray-300 rounded-lg pl-4 pr-16 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition font-semibold text-gray-900">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-red-600 font-black text-xs tracking-wider">% OFF</span>
            </div>
            <span class="text-[10px] text-gray-400 mt-1">Enter a number from 0 to 99. This will display on the storefront product card badge.</span>
        </div>
    </div>

    <!--  Modern Cropper.js Image Gallery (Min. 3 Required) -->
    <div class="border border-gray-200 rounded-xl p-6 bg-gray-50/30 mb-8">
        <div class="mb-4">
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Product Media Gallery (Min. 3 Images Required)</h3>
            <p class="text-[11px] text-gray-400 mt-0.5">Upload high-resolution dress photos. Click any preview card to crop and resize before submitting.</p>
        </div>

        <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center bg-white hover:border-gray-400 transition cursor-pointer group" onclick="document.getElementById('rawFileInput').click()">
            <div class="w-12 h-12 rounded-full bg-red-50 mx-auto flex items-center justify-center text-[#e78d8d] group-hover:scale-110 transition-transform duration-200 mb-3">
                <i class="fas fa-cloud-upload-alt text-xl"></i>
            </div>
            <p class="text-xs font-bold text-gray-700">Click to browse or drag & drop apparel photos</p>
            <p class="text-[10px] text-gray-400 mt-1">Supports PNG, JPG, WEBP (Recommended aspect ratio 3:4)</p>
            <input type="file" id="rawFileInput" accept="image/*" multiple class="hidden" onchange="handleFileSelect(event)">
            <input type="file" name="productImages" id="finalFormFileInput" multiple class="hidden">
        </div>

        <div id="imageCountError" class="hidden mt-4 p-3 bg-red-50 border border-red-200 rounded-lg text-xs font-bold text-red-600 flex items-center gap-2">
            <i class="fas fa-exclamation-circle text-sm"></i>
            <span>You must upload and confirm at least 3 images for the catalog.</span>
        </div>

        <div id="imagePreviewGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 empty:hidden"></div>
    </div>

    <!-- SECTION 3: Upgraded Variants & Apparel Attributes Workspace -->
    <div class="border border-gray-200 rounded-xl p-6 bg-gray-50/30 mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
            <div>
                <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Variants & Apparel Attributes Workspace</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Use industry-standard presets for storefront filtering consistency, or construct custom rules.</p>
            </div>
            
            <div class="flex items-center space-x-2">
                <button type="button" onclick="addNewOptionRow('Size')" class="px-3 py-1.5 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition shadow-xs flex items-center space-x-1.5 cursor-pointer">
                    <i class="fas fa-plus text-gray-400"></i>
                    <span>Add Standard Row</span>
                </button>
                <button type="button" onclick="openCustomVariantModal()" class="px-3 py-1.5 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center space-x-1.5 cursor-pointer">
                    <i class="fas fa-magic"></i>
                    <span>Create Custom Variant</span>
                </button>
            </div>
        </div>

        <div class="bg-white p-3 rounded-lg border border-gray-200 mb-6 shadow-2xs flex flex-wrap items-center gap-2">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mr-1 flex items-center gap-1">
                <i class="fas fa-bolt text-amber-500"></i> Quick Presets:
            </span>
            <button type="button" onclick="addNewOptionRow('Size')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Size</button>
            <button type="button" onclick="addNewOptionRow('Color')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Color</button>
            <button type="button" onclick="addNewOptionRow('Fit Type')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Fit Type</button>
            <button type="button" onclick="addNewOptionRow('Sleeve Length')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Sleeve Length</button>
            <button type="button" onclick="addNewOptionRow('Fabric / Material')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Fabric</button>
            <button type="button" onclick="addNewOptionRow('Neckline / Collar')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Neckline</button>
            <button type="button" onclick="addNewOptionRow('Pattern / Print')" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-md transition border border-gray-200 cursor-pointer">+ Pattern</button>
        </div>

        <div id="optionsContainer" class="space-y-4">
            <div class="grid grid-cols-12 gap-4 items-center bg-white p-4 rounded-lg border border-gray-200 shadow-xs option-row">
                <div class="col-span-3 font-semibold text-xs text-gray-500 uppercase tracking-wider">
                    <select onchange="updateRowPlaceholders(this)" class="w-full border border-gray-300 rounded-lg px-2.5 py-2 text-xs font-bold text-gray-800 bg-white focus:outline-none focus:border-gray-500 option-type cursor-pointer">
                        <option value="Size" selected>Size</option>
                        <option value="Color">Color</option>
                        <option value="Fit Type">Fit Type</option>
                        <option value="Sleeve Length">Sleeve Length</option>
                        <option value="Fabric / Material">Fabric / Material</option>
                        <option value="Neckline / Collar">Neckline / Collar</option>
                        <option value="Pattern / Print">Pattern / Print</option>
                        <option value="Occasion">Occasion</option>
                    </select>
                </div>
                <div class="col-span-8">
                    <input type="text" oninput="generateCombinationsMatrix()" placeholder="e.g., S, M, L, XL, XXL (separate entries with commas)" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-xs focus:outline-none focus:border-gray-500 option-values font-medium">
                </div>
                <div class="col-span-1 text-center">
                    <button type="button" onclick="removeOptionRow(this)" class="text-red-400 hover:text-red-600 transition text-sm cursor-pointer" title="Delete Option Row"><i class="fas fa-trash-alt"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic Multi-Variant Matrix Card -->
    <div class="border border-gray-200 rounded-xl bg-white overflow-hidden shadow-sm hidden" id="combinationsCard">
        <div class="bg-gray-50/80 px-6 py-4 border-b border-gray-200">
            <h3 class="text-xs font-bold text-black uppercase tracking-wider">Dynamic Multi-Variant Pricing & Stock Allocation Matrix</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="matrixTable">
                <thead class="text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50/30 border-b border-gray-200">
                    <tr>
                        <th class="py-3 px-6">Combination Properties</th>
                        <th class="py-3 px-6 w-44">SKU Inventory Code</th>
                        <th class="py-3 px-6 w-36 text-right">Price Value (₹)</th>
                        <th class="py-3 px-6 w-32 text-center">Available Stock</th>
                    </tr>
                </thead>
                <tbody class="text-xs text-gray-700 divide-y divide-gray-100 font-medium" id="matrixTableBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Form Submit Actions -->
    <div class="mt-8 pt-6 border-t border-gray-100 flex justify-end space-x-3">
        <a href="/admin/products" class="px-5 py-2.5 border border-gray-300 text-gray-700 text-xs font-semibold rounded-lg hover:bg-gray-50 transition shadow-sm">Cancel changes</a>
        <button type="submit" class="px-6 py-2.5 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-md transition cursor-pointer uppercase tracking-wider">Publish Live Catalog Unit</button>
    </div>

</form>

<!-- MODAL 1: Custom Variant Creator -->
<div id="customVariantModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200 backdrop-blur-xs">
    <div class="bg-white rounded-xl shadow-xl border border-gray-200 w-full max-w-sm mx-4 overflow-hidden transform scale-95 transition-transform duration-200" id="cvModalContent">
        <div class="bg-gray-50 px-5 py-4 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider flex items-center space-x-2">
                <i class="fas fa-wand-magic-sparkles text-[#e78d8d]"></i>
                <span>Custom Variant Rule</span>
            </h3>
            <button type="button" onclick="closeCustomVariantModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 space-y-4">
            <div class="bg-amber-50 border border-amber-100 text-[11px] text-amber-800 rounded-lg p-3 leading-relaxed font-medium">
                <strong>Guide:</strong> Create options that aren't size or color, like <strong>"Water Resistance"</strong> or <strong>"Sleeve Type"</strong>.
            </div>
            <div class="flex flex-col">
                <label class="text-[11px] font-bold text-gray-700 uppercase tracking-wide mb-1.5">Variant Parameter Identifier Label</label>
                <input type="text" id="customVariantInputName" placeholder="e.g., Sleeve, Pocket, Fit Type" class="border border-gray-300 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-gray-500 font-medium">
            </div>
        </div>
        <div class="bg-gray-50 px-5 py-3 border-t border-gray-100 flex justify-end space-x-2">
            <button type="button" onclick="closeCustomVariantModal()" class="px-3 py-1.5 border border-gray-300 bg-white text-gray-700 text-xs font-semibold rounded-lg hover:bg-gray-50">Cancel</button>
            <button type="button" onclick="submitCustomVariantRow()" class="px-4 py-1.5 bg-[#6b66d6] text-white text-xs font-bold rounded-lg shadow-xs cursor-pointer">Inject Option Row</button>
        </div>
    </div>
</div>

<script src="/js/shared/imageCropper.js"></script>

<script>
    let databaseCategories = [];
    try {
        const rawTextData = document.getElementById('rawServerCategories').value;
        databaseCategories = JSON.parse(rawTextData || "[]");
    } catch (error) {
        console.error("Critical failure parsing category datasets:", error);
    }

    document.addEventListener("DOMContentLoaded", () => {
        if (document.getElementById('parentCategory').value) {
            handleParentCategoryChange();
        }
    });

    function handleParentCategoryChange() {
        const activeGender = document.getElementById('parentCategory').value;
        const subSelect = document.getElementById('subCategory');    
        subSelect.innerHTML = '<option value="" disabled selected>Choose Subcategory option</option>';

        const filteredMatches = databaseCategories.filter(cat => {
            const isMatchingGender = cat.gender === activeGender;
            const isNotRoot = cat.parentCategory !== null && cat.parentCategory !== 'none' && cat.parentCategory !== undefined;
            return isMatchingGender && isNotRoot;
        });

        if (filteredMatches.length > 0) {
            subSelect.disabled = false;
            subSelect.classList.remove('bg-gray-100', 'cursor-not-allowed');
            subSelect.classList.add('bg-white', 'cursor-pointer');
            filteredMatches.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat._id;                 
                if (cat.breadcrumb) {
                    opt.innerText = cat.breadcrumb + ` (Level ${cat.depth || 2})`;
                } else if (cat.lineage && Array.isArray(cat.lineage)) {
                    opt.innerText = cat.lineage.join(" → ") + ` (Level ${cat.depth || 2})`;
                } else {
                    let parentName = "Subcategory";
                    if (cat.parentCategory && typeof cat.parentCategory === 'object' && cat.parentCategory.categoryName) {
                        parentName = cat.parentCategory.categoryName;
                    } else if (typeof cat.parentCategory === 'string') {
                        const foundParent = databaseCategories.find(p => p._id.toString() === cat.parentCategory.toString());
                        if (foundParent) parentName = foundParent.categoryName;
                    }
                    opt.innerText = `${parentName} → ${cat.categoryName}`;
                }
                subSelect.appendChild(opt);
            });
        } else {
            subSelect.disabled = true;
            subSelect.classList.add('bg-gray-100', 'cursor-not-allowed');
            subSelect.classList.remove('bg-white', 'cursor-pointer');
            subSelect.innerHTML = `<option value="" disabled selected>No sub-categories exist for ${activeGender}</option>`;
        }
        
        // Reset ancestors when gender changes
        document.getElementById('ancestorsContainer').innerHTML = '';
    }
    function handleSubCategoryChange() {
        const selectedId = document.getElementById('subCategory').value;
        const container = document.getElementById('ancestorsContainer');
        container.innerHTML = ''; // Clear previous tree

        if (!selectedId) return;

        let currentCat = databaseCategories.find(c => c._id.toString() === selectedId.toString());
        const ancestors = [];
        while (currentCat) {
            ancestors.push(currentCat._id);
            if (currentCat.parentCategory && currentCat.parentCategory !== 'none') {
                const parentId = typeof currentCat.parentCategory === 'object' ? currentCat.parentCategory._id : currentCat.parentCategory;
                currentCat = databaseCategories.find(c => c._id.toString() === parentId.toString());
            } else {
                currentCat = null;
            }
        }
        ancestors.forEach(id => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'categoryAncestors[]';
            input.value = id;
            container.appendChild(input);
        });
        
        console.log(" Indexed 4-Level Lineage Captured:", ancestors);
    }
    function addNewOptionRow(presetType = 'Size') {
        const container = document.getElementById('optionsContainer');
        const row = document.createElement('div');
        row.className = "grid grid-cols-12 gap-4 items-center bg-white p-4 rounded-lg border border-gray-200 shadow-xs option-row animate-fade-in";
        
        const standardAttributes = [
            "Size", "Color", "Fit Type", "Sleeve Length", 
            "Fabric / Material", "Neckline / Collar", "Pattern / Print", "Occasion"
        ];

        let optionsHtml = standardAttributes.map(attr => {
            const isSelected = attr === presetType ? 'selected' : '';
            return `<option value="${attr}" ${isSelected}>${attr}</option>`;
        }).join('');

        row.innerHTML = `
            <div class="col-span-3">
                <select onchange="updateRowPlaceholders(this)" class="w-full border border-gray-300 rounded-lg px-2.5 py-2 text-xs font-bold text-gray-800 bg-white focus:outline-none focus:border-gray-500 option-type cursor-pointer">
                    ${optionsHtml}
                </select>
            </div>
            <div class="col-span-8">
                <input type="text" oninput="generateCombinationsMatrix()" placeholder="" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-xs focus:outline-none focus:border-gray-500 option-values font-medium">
            </div>
            <div class="col-span-1 text-center"><button type="button" onclick="removeOptionRow(this)" class="text-red-400 hover:text-red-600 transition text-sm cursor-pointer" title="Delete Option Row"><i class="fas fa-trash-alt"></i></button></div>
        `;
        
        container.appendChild(row);
        const newSelect = row.querySelector('.option-type');
        updateRowPlaceholders(newSelect);
    }

    function openCustomVariantModal() { toggleModalVisibility('customVariantModal', 'cvModalContent', true); }
    function closeCustomVariantModal() { toggleModalVisibility('customVariantModal', 'cvModalContent', false); }

    function submitCustomVariantRow() {
        const inputName = document.getElementById('customVariantInputName').value.trim();
        if(!inputName) {
            if (typeof showCustomAlert === 'function') {
                return showCustomAlert("Please clarify a variant identifier parameter tag.", "Missing Input", "error");
            } else {
                return alert("Please clarify a variant identifier parameter tag.");
            }
        }
        
        const cleanKeyLabel = inputName.charAt(0).toUpperCase() + inputName.slice(1);
        const container = document.getElementById('optionsContainer');
        const row = document.createElement('div');
        
        row.className = "grid grid-cols-12 gap-4 items-center bg-white p-4 rounded-lg border border-gray-200 shadow-xs option-row animate-fade-in";
        row.innerHTML = '<div class="col-span-3 font-bold text-xs text-gray-800 tracking-wide uppercase px-2"><span>' + cleanKeyLabel + '</span><input type="hidden" class="option-type" value="' + cleanKeyLabel + '"></div><div class="col-span-8"><input type="text" oninput="generateCombinationsMatrix()" placeholder="Enter discrete variables for ' + cleanKeyLabel + ' (separate with commas)" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-xs focus:outline-none focus:border-gray-500 option-values font-medium"></div><div class="col-span-1 text-center"><button type="button" onclick="removeOptionRow(this)" class="text-red-400 hover:text-red-600 text-sm cursor-pointer" title="Delete Option Row"><i class="fas fa-trash-alt"></i></button></div>';
        
        container.appendChild(row);
        closeCustomVariantModal();
        document.getElementById('customVariantInputName').value = '';
    }

    function removeOptionRow(btn) {
        btn.closest('.option-row').remove();
        generateCombinationsMatrix();
    }

    function updateRowPlaceholders(select) {
        const input = select.closest('.option-row').querySelector('.option-values');
        const type = select.value;

        const placeholderMap = {
            'Size': "e.g., S, M, L, XL, XXL or 30, 32, 34 (separate with commas)",
            'Color': "e.g., Navy Blue, Olive Green, Maroon, Classic Black (separate with commas)",
            'Fit Type': "e.g., Slim Fit, Oversized, Regular Fit, Relaxed, Tailored (separate with commas)",
            'Sleeve Length': "e.g., Full Sleeve, Half Sleeve, Sleeveless, 3/4 Sleeve (separate with commas)",
            'Fabric / Material': "e.g., 100% Cotton, Pure Linen, Denim, Poly-Blend, Silk (separate with commas)",
            'Neckline / Collar': "e.g., Crew Neck, V-Neck, Polo Collar, Mandarin Collar, Hooded (separate with commas)",
            'Pattern / Print': "e.g., Solid, Striped, Checked, Floral Print, Graphic Print (separate with commas)",
            'Occasion': "e.g., Casual Wear, Formal, Party Wear, Athletic / Sports (separate with commas)"
        };
        input.placeholder = placeholderMap[type] || `Enter discrete variables for ${type} (separate with commas)`;
        generateCombinationsMatrix();
    }

    function generateCombinationsMatrix() {
        const rows = document.getElementsByClassName('option-row');
        const baseName = document.getElementById('baseName').value.trim() || "PROD";
        const brandName = document.getElementById('brandName').value.trim() || "DRSN";
        let arraysToCombine = [];
        
        for (let row of rows) {
            const rawValue = row.querySelector('.option-values').value;
            const cleanValues = rawValue.split(',').map(v => v.trim()).filter(v => v !== '');
            if(cleanValues.length > 0) arraysToCombine.push(cleanValues);
        }

        const matrixCard = document.getElementById('combinationsCard');
        const tableBody = document.getElementById('matrixTableBody');
        tableBody.innerHTML = '';

        if(arraysToCombine.length === 0 || rows.length !== arraysToCombine.length) {
            return matrixCard.classList.add('hidden');
        }

        let combinations = arraysToCombine.reduce((a, b) => a.flatMap(d => b.map(e => [d, e].flat())));
        if (!Array.isArray(combinations[0])) combinations = combinations.map(item => [item]);

        matrixCard.classList.remove('hidden');

        combinations.forEach((combo, index) => {
            const comboString = combo.join(' / ');
            const generatedSkuSafe = brandName.substring(0,3).toUpperCase() + '-' + baseName.substring(0,3).toUpperCase() + '-' + combo.join('-').replace(/\s+/g, '').toUpperCase();
            
            const tr = document.createElement('tr');
            tr.className = "hover:bg-gray-50/50 transition";
            tr.innerHTML = '<td class="py-4 px-6 font-bold text-gray-900"><span>' + comboString + '</span><input type="hidden" name="variants[' + index + '][name]" value="' + comboString + '"></td><td class="py-4 px-6"><input type="text" name="variants[' + index + '][sku]" value="' + generatedSkuSafe + '" class="w-full border border-gray-200 rounded px-2.5 py-1.5 font-mono text-[11px] uppercase bg-gray-50/30 focus:outline-none focus:border-gray-500"></td><td class="py-4 px-6 text-right"><div class="relative inline-block w-full"><span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 font-bold">₹</span><input type="number" name="variants[' + index + '][price]" required min="0" placeholder="0" class="w-full border border-gray-200 rounded pl-6 pr-2.5 py-1.5 text-right font-semibold text-gray-900 bg-gray-50/30 focus:outline-none focus:border-gray-500"></div></td><td class="py-4 px-6 text-center"><input type="number" name="variants[' + index + '][stock]" required min="0" placeholder="0" value="0" class="w-full border border-gray-200 rounded px-2 py-1.5 text-center font-medium bg-gray-50/30 focus:outline-none focus:border-gray-500"></td>';
            
            tableBody.appendChild(tr);
        });
    }

    function toggleModalVisibility(modalId, contentId, shouldShow) {
        const modal = document.getElementById(modalId);
        const content = document.getElementById(contentId);
        if(shouldShow) {
            modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); content.classList.remove('scale-95'); }, 10);
        } else {
            modal.classList.add('opacity-0'); content.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 200);
        }
    }

    document.getElementById('baseName').addEventListener('input', generateCombinationsMatrix);
    document.getElementById('brandName').addEventListener('input', generateCombinationsMatrix);

    //  IMAGE GALLERY MANAGEMENT
    const processedFilesArray = []; 
    const dataTransfer = new DataTransfer(); 

    function handleFileSelect(event) {
        const files = Array.from(event.target.files);
        if (!files.length) return;

        files.forEach(file => {
            if (file.type.startsWith('image/')) {
                processedFilesArray.push(file);
            }
        });

        updateFormFileInput();
        renderPreviews();
        event.target.value = ''; 
    }

    function updateFormFileInput() {
        dataTransfer.items.clear();
        processedFilesArray.forEach(file => dataTransfer.items.add(file));
        document.getElementById('finalFormFileInput').files = dataTransfer.files;
        
        if (processedFilesArray.length >= 3) {
            document.getElementById('imageCountError').classList.add('hidden');
        }
    }

    function renderPreviews() {
        const grid = document.getElementById('imagePreviewGrid');
        grid.innerHTML = '';
        processedFilesArray.forEach((file, index) => {
            const url = URL.createObjectURL(file);
            const card = document.createElement('div');
            card.className = "relative group bg-gray-100 rounded-xl overflow-hidden border border-gray-200 aspect-3/4 flex items-center justify-center shadow-xs";
            card.innerHTML = `
                <img src="${url}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2">
                    <button type="button" onclick="openCropper(${index})" class="p-2 bg-white text-gray-800 rounded-lg shadow hover:bg-gray-100 text-xs font-bold cursor-pointer" title="Crop/Resize">
                        <i class="fas fa-crop-alt"></i>
                    </button>
                    <button type="button" onclick="removeImage(${index})" class="p-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-700 text-xs font-bold cursor-pointer" title="Remove">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                <span class="absolute bottom-2 left-2 bg-black/60 text-white text-[9px] font-bold px-2 py-0.5 rounded backdrop-blur-xs">#${index + 1}</span>
            `;
            grid.appendChild(card);
        });
    }

    function removeImage(index) {
        processedFilesArray.splice(index, 1);
        updateFormFileInput();
        renderPreviews();
    }

    function openCropper(index) {
        const originalFile = processedFilesArray[index];    
        window.ImageCropper.openCropper({
            file: originalFile,
            aspectRatio: NaN,
            onCrop: (blob, newUrl) => {
                const croppedFile = new File([blob], originalFile.name, {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                });
                processedFilesArray[index] = croppedFile;
                updateFormFileInput();
                renderPreviews();
            }
        });
    }

    // FORM SUBMISSION INTERCEPTOR
    document.getElementById('productForm').addEventListener('submit', function(event) {
        if (processedFilesArray.length < 3) {
            event.preventDefault();
            const errorBox = document.getElementById('imageCountError');
            errorBox.classList.remove('hidden');
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });            
            if (typeof showCustomAlert === 'function') {
                showCustomAlert("A minimum of 3 cropped gallery images is required to publish this product.", "Gallery Error", "error");
            }
        }
    });
</script>