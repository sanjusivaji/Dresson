<%- contentFor('body') %>

<main class="flex-1 p-8 bg-[#fafafa] min-h-screen">
    
    <%- include('../partial/shared/alertSuccess') %>
    <%- include('../partial/shared/alertError') %>
    <%- include('../partial/shared/warning') %>

    <!-- Serialized Database Categories -->
    <input type="hidden" id="rawServerCategories" value='<%= typeof categories !== "undefined" ? JSON.stringify(categories) : "[]" %>'>

    <!-- Main Centered Container -->
    <div class="max-w-5xl mx-auto mt-4">
        
        <!-- TOP HEADER -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-black tracking-tight mb-2">Add New Product</h1>
                <p class="text-xs text-gray-500 leading-relaxed">Configure your product identity, gallery media assets, variants matrix, and categories.</p>
            </div>
            
            <!-- Back Button Inside a Box -->
            <a href="/admin/products" class="px-5 py-2.5 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition flex items-center space-x-2 text-xs font-bold text-gray-700 uppercase tracking-wider">
                <i class="fas fa-arrow-left text-gray-400"></i>
                <span>Back to Products</span>
            </a>
        </div>

        <!-- THE FORM -->
        <form action="/admin/products/add" method="POST" enctype="multipart/form-data" id="productForm" class="space-y-8 pb-12">
            
            <!-- INVISIBLE ANCESTOR LINEAGE TRACKER -->
            <div id="ancestorsContainer" class="hidden"></div>

            <!-- Product Identity Card -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    
                    <!-- LEFT COLUMN: Product Basics & Tax -->
                    <div class="space-y-6">
                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Name</label>
                            <input type="text" id="baseName" name="productName" placeholder="e.g., Premium Comfort Polo Tee" 
                                   value="<%= locals.formData && formData.productName ? formData.productName : '' %>"
                                   class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-50/30 shadow-sm transition font-medium">
                            <p id="baseNameError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                        </div>

                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Brand</label>
                            <input type="text" id="brandName" name="brand" placeholder="e.g., Levi's, Zara, Dresson Original" 
                                   value="<%= locals.formData && formData.brand ? formData.brand : '' %>"
                                   class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition font-medium">
                            <p id="brandNameError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                        </div>

                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Tax Rate (%)</label>
                            <select id="taxRate" name="taxRate" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition cursor-pointer font-medium text-gray-800">
                                <option value="0" <%= locals.formData && formData.taxRate == '0' ? 'selected' : '' %>>0% (Tax Exempt)</option>
                                <option value="5" <%= locals.formData && formData.taxRate == '5' ? 'selected' : '' %>>5% (Apparel below ₹1000)</option>
                                <option value="12" <%= locals.formData && formData.taxRate == '12' ? 'selected' : '' %>>12% (Apparel above ₹1000)</option>
                                <option value="18" <%= locals.formData && formData.taxRate == '18' ? 'selected' : '' %>>18% (Standard GST)</option>
                            </select>
                            <p id="taxRateError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                            <span class="text-[10px] text-gray-400 mt-1">Select the applicable GST slab for this apparel.</span>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: Category Mapping -->
                    <div class="space-y-6">
                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Parent Category (Gender Target)</label>
                            <select id="parentCategory" name="parentCategory" onchange="handleParentCategoryChange()" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition cursor-pointer font-medium text-gray-800">
                                <option value="" disabled selected>Select Gender Target Room</option>
                                <option value="Men" <%= locals.formData && formData.parentCategory === 'Men' ? 'selected' : '' %>>Men</option>
                                <option value="Women" <%= locals.formData && formData.parentCategory === 'Women' ? 'selected' : '' %>>Women</option>
                                <option value="Kids" <%= locals.formData && formData.parentCategory === 'Kids' ? 'selected' : '' %>>Kids</option>
                            </select>
                            <p id="parentCategoryError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                        </div>

                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Sub-Category Assignment Tree</label>
                            <select id="subCategory" name="subCategory" disabled onchange="handleSubCategoryChange()" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-100 shadow-sm transition cursor-not-allowed font-medium text-gray-800">
                                <option value="" disabled selected>Please select a gender target first</option>
                            </select>
                            <p id="subCategoryError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                        </div>
                    </div>

                    <!-- FULL WIDTH: Rich Description -->
                    <div class="md:col-span-2 flex flex-col pt-2">
                        <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Product Rich Description</label>
                        <textarea id="description" name="description" rows="3" placeholder="Detail fabric metrics, cut attributes, care instructions..." 
                                  class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-gray-50/30 shadow-sm transition resize-none font-medium"><%= locals.formData && formData.description ? formData.description : '' %></textarea>
                        <p id="descriptionError" class="inline-error text-red-500 text-[10px] font-bold mt-1 hidden"></p>
                    </div>
                </div>
            </div>

            <!-- Gallery Card -->
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-8 py-6 border-b border-gray-100 border-dashed">
                    <div class="flex justify-between items-center">
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Product Media Gallery</h3>
                        <span class="text-[10px] bg-gray-100 text-gray-500 px-2 py-1 rounded font-bold tracking-widest">MIN 3 REQUIRED</span>
                    </div>
                    <p class="text-[11px] text-gray-400 mt-1">Upload high-resolution dress photos. Click any preview card to crop and resize before submitting.</p>
                </div>

                <div class="p-8">
                    <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center bg-gray-50/50 hover:bg-gray-50 hover:border-gray-400 transition cursor-pointer group" onclick="document.getElementById('rawFileInput').click()">
                        <div class="w-12 h-12 rounded-full bg-[#fce8e8] mx-auto flex items-center justify-center text-[#e78d8d] group-hover:scale-110 transition-transform duration-200 mb-3 shadow-inner">
                            <i class="fas fa-cloud-upload-alt text-xl"></i>
                        </div>
                        <p class="text-xs font-bold text-gray-700">Click to browse or drag & drop apparel photos</p>
                        <p class="text-[10px] text-gray-400 mt-1">Supports PNG, JPG, WEBP (Recommended aspect ratio 3:4)</p>
                        <input type="file" id="rawFileInput" accept="image/*" multiple class="hidden" onchange="handleFileSelect(event)">
                        <input type="file" name="productImages" id="finalFormFileInput" multiple class="hidden">
                    </div>

                    <div id="imageCountError" class="hidden mt-4 p-3 bg-red-50 border border-red-200 rounded-lg text-xs font-bold text-red-600 flex items-center gap-2">
                        <i class="fas fa-exclamation-circle text-sm"></i>
                        <span>You must upload and confirm at least 3 images for the catalog.</span>
                    </div>

                    <div id="imagePreviewGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 empty:hidden"></div>
                </div>
            </div>

            <!-- Workspace Card -->
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-8 py-6 border-b border-gray-100 border-dashed flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Variants & Attributes Workspace</h3>
                        <p class="text-[11px] text-gray-400 mt-1">Use predefined quick defaults for clean data, or construct custom rules.</p>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                        <button type="button" onclick="addNewOptionRow('Size')" class="px-3 py-1.5 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition shadow-xs flex items-center space-x-1.5 cursor-pointer">
                            <i class="fas fa-plus text-gray-400"></i>
                            <span>Add Standard Row</span>
                        </button>
                        <button type="button" onclick="openCustomVariantModal()" class="px-3 py-1.5 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center space-x-1.5 cursor-pointer">
                            <i class="fas fa-magic"></i>
                            <span>Create Custom Variant</span>
                        </button>
                    </div>
                </div>

                <div class="p-8 pt-6">
                    <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 mb-6 flex flex-wrap items-center gap-2">
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mr-1 flex items-center gap-1">
                            <i class="fas fa-bolt text-amber-500"></i> Row Shortcuts:
                        </span>
                        <button type="button" onclick="addNewOptionRow('Size')" class="px-2.5 py-1 bg-white hover:bg-gray-100 text-gray-700 text-[11px] font-semibold rounded transition border border-gray-200 cursor-pointer shadow-xs">+ Size</button>
                        <button type="button" onclick="addNewOptionRow('Color')" class="px-2.5 py-1 bg-white hover:bg-gray-100 text-gray-700 text-[11px] font-semibold rounded transition border border-gray-200 cursor-pointer shadow-xs">+ Color</button>
                        <button type="button" onclick="addNewOptionRow('Fit Type')" class="px-2.5 py-1 bg-white hover:bg-gray-100 text-gray-700 text-[11px] font-semibold rounded transition border border-gray-200 cursor-pointer shadow-xs">+ Fit Type</button>
                        <button type="button" onclick="addNewOptionRow('Fabric / Material')" class="px-2.5 py-1 bg-white hover:bg-gray-100 text-gray-700 text-[11px] font-semibold rounded transition border border-gray-200 cursor-pointer shadow-xs">+ Fabric</button>
                    </div>
                    <div id="optionsContainer" class="space-y-4"></div>
                </div>
            </div>

            <!-- Matrix Card -->
            <div id="matrixGlobalError" class="inline-error hidden px-6 py-4 rounded-xl bg-red-50 text-red-600 text-xs font-bold border border-red-200 flex items-center shadow-sm">
                <i class="fas fa-exclamation-circle mr-2 text-lg"></i> You must configure at least one valid variant combination.
            </div>

            <div class="border border-gray-200 rounded-xl bg-white overflow-hidden shadow-sm hidden" id="combinationsCard">
                <div class="bg-gray-50 px-8 py-5 border-b border-gray-200">
                    <h3 class="text-xs font-bold text-black uppercase tracking-wider">Dynamic Multi-Variant Pricing & Stock Allocation</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" id="matrixTable">
                        <thead class="text-[10px] font-bold text-gray-500 uppercase tracking-wider bg-white border-b border-gray-200">
                            <tr>
                                <th class="py-4 px-8">Combination Properties</th>
                                <th class="py-4 px-6 w-48">SKU Code</th>
                                <th class="py-4 px-6 w-40 text-right">Price (₹)</th>
                                <th class="py-4 px-8 w-32 text-center">Stock</th>
                            </tr>
                        </thead>
                        <tbody class="text-xs text-gray-700 divide-y divide-gray-100 font-medium" id="matrixTableBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="pt-6 border-t border-gray-200 flex justify-end space-x-4">
                <a href="/admin/products" class="px-6 py-3 bg-white border border-gray-300 text-gray-700 text-xs font-bold rounded-lg hover:bg-gray-50 transition shadow-sm uppercase tracking-wider">Cancel changes</a>
                <button type="submit" class="px-8 py-3 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-md transition cursor-pointer uppercase tracking-wider">Publish Live Catalog Unit</button>
            </div>

        </form>
    </div>
</main>

<!-- Custom Variant Modal -->
<div id="customVariantModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-100 w-full max-w-sm mx-4 overflow-hidden transform scale-95 transition-transform duration-200" id="cvModalContent">
        <div class="bg-gray-50/80 px-6 py-5 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider flex items-center space-x-2">
                <div class="w-6 h-6 rounded-full bg-purple-100 text-[#6b66d6] flex items-center justify-center text-xs">
                    <i class="fas fa-wand-magic-sparkles"></i>
                </div>
                <span>Custom Variant</span>
            </h3>
            <button type="button" onclick="closeCustomVariantModal()" class="text-gray-400 hover:text-gray-900 transition"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6 space-y-5">
            <div class="bg-blue-50/50 border border-blue-100 text-[11px] text-blue-800 rounded-lg p-3.5 leading-relaxed font-medium">
                <strong>Guide:</strong> Create options that aren't standard, like <strong>"Water Resistance"</strong> or <strong>"Sleeve Type"</strong>.
            </div>
            <div class="flex flex-col">
                <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2">Parameter Identifier Label</label>
                <input type="text" id="customVariantInputName" placeholder="e.g., Pocket Style, Fit Drop" class="border border-gray-300 rounded-lg px-4 py-3 text-xs focus:outline-none focus:border-[#6b66d6] focus:ring-1 focus:ring-[#6b66d6] font-medium bg-gray-50/50">
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100 flex justify-end space-x-3">
            <button type="button" onclick="closeCustomVariantModal()" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 text-xs font-bold rounded-lg hover:bg-gray-50 transition shadow-sm">Cancel</button>
            <button type="button" onclick="submitCustomVariantRow()" class="px-5 py-2.5 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-sm transition cursor-pointer">Inject Row</button>
        </div>
    </div>
</div>

<script src="/js/shared/imageCropper.js"></script>

<script>
    let databaseCategories = [];
    try {
        const rawTextData = document.getElementById('rawServerCategories').value;
        databaseCategories = JSON.parse(rawTextData || "[]");
    } catch (error) { console.error("Critical failure parsing category datasets:", error); }
    
    const defaultPresets = {                                                                       
        'Size': ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'Free Size'],
        'Color': ['Black', 'White', 'Navy Blue', 'Red', 'Olive Green', 'Grey', 'Maroon', 'Multi'],
        'Fit Type': ['Slim Fit', 'Regular Fit', 'Oversized', 'Relaxed Fit', 'Tailored'],
        'Sleeve Length': ['Full Sleeve', 'Half Sleeve', 'Sleeveless', '3/4 Sleeve'],
        'Fabric / Material': ['100% Cotton', 'Pure Linen', 'Denim', 'Polyester Blend', 'Silk'],
        'Neckline / Collar': ['Crew Neck', 'V-Neck', 'Polo Collar', 'Mandarin Collar', 'Hooded'],
        'Pattern / Print': ['Solid', 'Striped', 'Checked', 'Floral Print', 'Graphic Print']
    };
    
    document.addEventListener("DOMContentLoaded", () => {
        if (document.getElementById('parentCategory').value) handleParentCategoryChange();
        addNewOptionRow('Size');
    });

    function handleParentCategoryChange() {
        const activeGender = document.getElementById('parentCategory').value;
        const subSelect = document.getElementById('subCategory');    
        subSelect.innerHTML = '<option value="" disabled selected>Choose Subcategory option</option>';

        const filteredMatches = databaseCategories.filter(cat => {
            return cat.gender === activeGender && (cat.parentCategory !== null && cat.parentCategory !== 'none' && cat.parentCategory !== undefined);
        });
        
        if (filteredMatches.length > 0) {
            subSelect.disabled = false;
            subSelect.classList.remove('bg-gray-100', 'cursor-not-allowed');
            subSelect.classList.add('bg-white', 'cursor-pointer');
            filteredMatches.forEach(cat => {
                const opt = document.createElement('option'); opt.value = cat._id;                 
                if (cat.breadcrumb) opt.innerText = cat.breadcrumb + ` (Level ${cat.depth || 2})`;
                else if (cat.lineage && Array.isArray(cat.lineage)) opt.innerText = cat.lineage.join(" → ") + ` (Level ${cat.depth || 2})`;
                else {
                    let parentName = "Subcategory";
                    if (cat.parentCategory && typeof cat.parentCategory === 'object' && cat.parentCategory.categoryName) parentName = cat.parentCategory.categoryName;
                    else if (typeof cat.parentCategory === 'string') {
                        const foundParent = databaseCategories.find(p => p._id.toString() === cat.parentCategory.toString());
                        if (foundParent) parentName = foundParent.categoryName;
                    }
                    opt.innerText = `${parentName} → ${cat.categoryName}`;
                }
                subSelect.appendChild(opt);
            });
        } else {
            subSelect.disabled = true;
            subSelect.classList.add('bg-gray-100', 'cursor-not-allowed');
            subSelect.classList.remove('bg-white', 'cursor-pointer');
            subSelect.innerHTML = `<option value="" disabled selected>No sub-categories exist for ${activeGender}</option>`;
        }
        document.getElementById('ancestorsContainer').innerHTML = '';
    }

    function handleSubCategoryChange() {
        const selectedId = document.getElementById('subCategory').value;
        const container = document.getElementById('ancestorsContainer'); container.innerHTML = ''; 
        if (!selectedId) return;

        let currentCat = databaseCategories.find(c => c._id.toString() === selectedId.toString());
        const ancestors = [];
        while (currentCat) {
            ancestors.push(currentCat._id);
            if (currentCat.parentCategory && currentCat.parentCategory !== 'none') {
                const parentId = typeof currentCat.parentCategory === 'object' ? currentCat.parentCategory._id : currentCat.parentCategory;
                currentCat = databaseCategories.find(c => c._id.toString() === parentId.toString());
            } else currentCat = null;
        }
        ancestors.forEach(id => {
            const input = document.createElement('input'); input.type = 'hidden'; input.name = 'categoryAncestors[]'; input.value = id;
            container.appendChild(input);
        });
    }

    function addNewOptionRow(presetType = 'Size') {
        const container = document.getElementById('optionsContainer');
        const row = document.createElement('div');
        row.className = "grid grid-cols-12 gap-4 items-start bg-white p-5 rounded-lg border border-gray-200 shadow-xs option-row animate-fade-in";
        const standardAttributes = Object.keys(defaultPresets); standardAttributes.push("Occasion", "Custom Attribute");

        let optionsHtml = standardAttributes.map(attr => `<option value="${attr}" ${attr === presetType ? 'selected' : ''}>${attr}</option>`).join('');

        row.innerHTML = `
            <div class="col-span-3">
                <select onchange="updateRowPlaceholders(this)" class="w-full border border-gray-300 rounded-lg px-2.5 py-2 text-xs font-bold text-gray-800 bg-gray-50 focus:outline-none focus:border-gray-500 option-type cursor-pointer">
                    ${optionsHtml}
                </select>
            </div>
            <div class="col-span-8">
                <input type="text" oninput="generateCombinationsMatrix()" placeholder="" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-xs focus:outline-none focus:border-gray-500 option-values font-medium">
                <div class="preset-container mt-2.5 flex flex-wrap gap-1.5 empty:hidden"></div>
            </div>
            <div class="col-span-1 text-right mt-1">
                <button type="button" onclick="removeOptionRow(this)" class="w-8 h-8 inline-flex items-center justify-center rounded-md bg-red-50 text-red-500 hover:bg-red-100 hover:text-red-700 transition cursor-pointer"><i class="fas fa-trash-alt text-xs"></i></button>
            </div>
        `;
        container.appendChild(row); updateRowPlaceholders(row.querySelector('.option-type'));
    }
    
    function appendPresetToInput(btn, value) {
        const inputField = btn.closest('.col-span-8').querySelector('.option-values');
        let currentValues = inputField.value.split(',').map(s => s.trim()).filter(Boolean);
        if (!currentValues.includes(value)) {
            currentValues.push(value); inputField.value = currentValues.join(', ') + ', '; 
            generateCombinationsMatrix();
        }
        inputField.focus();
    }

    function updateRowPlaceholders(select) {
        const parentCol = select.closest('.option-row').querySelector('.col-span-8');
        const input = parentCol.querySelector('.option-values'); const presetContainer = parentCol.querySelector('.preset-container');
        const type = select.value;
        if (defaultPresets[type]) {
            const chipsHtml = defaultPresets[type].map(val => `<button type="button" onclick="appendPresetToInput(this, '${val}')" class="px-2.5 py-1 bg-white border border-gray-200 text-[10px] rounded hover:bg-[#6b66d6] hover:text-white hover:border-[#6b66d6] text-gray-600 font-bold transition-colors cursor-pointer shadow-xs">${val}</button>`).join('');
            presetContainer.innerHTML = chipsHtml;
        } else presetContainer.innerHTML = '';
        const placeholderMap = { 'Size': "Type sizes or click presets...", 'Color': "Type colors or click presets...", 'Fit Type': "Type fits or click presets..." };        
        input.placeholder = placeholderMap[type] || `Enter discrete variables for ${type} (separate with commas)`;
        generateCombinationsMatrix();
    }

    function openCustomVariantModal() { toggleModalVisibility('customVariantModal', 'cvModalContent', true); }
    function closeCustomVariantModal() { toggleModalVisibility('customVariantModal', 'cvModalContent', false); }
    
    function submitCustomVariantRow() {
        const inputName = document.getElementById('customVariantInputName').value.trim();
        if(!inputName) return alert("Please clarify a variant identifier parameter tag.");
        const cleanKeyLabel = inputName.charAt(0).toUpperCase() + inputName.slice(1);
        const container = document.getElementById('optionsContainer'); const row = document.createElement('div');        
        row.className = "grid grid-cols-12 gap-4 items-start bg-white p-5 rounded-lg border border-gray-200 shadow-xs option-row animate-fade-in";
        row.innerHTML = `
            <div class="col-span-3 font-bold text-xs text-gray-800 tracking-wide uppercase px-2 mt-2">
                <span>${cleanKeyLabel}</span><input type="hidden" class="option-type" value="${cleanKeyLabel}">
            </div>
            <div class="col-span-8">
                <input type="text" oninput="generateCombinationsMatrix()" placeholder="Enter discrete variables for ${cleanKeyLabel}" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-xs focus:outline-none focus:border-gray-500 option-values font-medium mt-1">
            </div>
            <div class="col-span-1 text-right mt-1">
                <button type="button" onclick="removeOptionRow(this)" class="w-8 h-8 inline-flex items-center justify-center rounded-md bg-red-50 text-red-500 hover:bg-red-100 transition cursor-pointer"><i class="fas fa-trash-alt text-xs"></i></button>
            </div>`;
        container.appendChild(row); closeCustomVariantModal(); document.getElementById('customVariantInputName').value = '';
    }

    function removeOptionRow(btn) { btn.closest('.option-row').remove(); generateCombinationsMatrix(); }

    function generateCombinationsMatrix() {
        const rows = document.getElementsByClassName('option-row');
        const baseName = document.getElementById('baseName').value.trim() || "PROD";
        const brandName = document.getElementById('brandName').value.trim() || "DRSN";        
        let optionKeys = []; let arraysToCombine = [];        
        for (let row of rows) {
            const type = row.querySelector('.option-type').value; const rawValue = row.querySelector('.option-values').value;
            const cleanValues = [...new Set(rawValue.split(',').map(v => v.trim()).filter(v => v !== ''))];            
            if(cleanValues.length > 0) { optionKeys.push(type); arraysToCombine.push(cleanValues); }
        }
        const matrixCard = document.getElementById('combinationsCard'); const tableBody = document.getElementById('matrixTableBody');
        tableBody.innerHTML = '';
        if(arraysToCombine.length === 0 || rows.length !== arraysToCombine.length) return matrixCard.classList.add('hidden');
        let combinations = arraysToCombine.reduce((a, b) => a.flatMap(d => b.map(e => [d, e].flat())));
        if (!Array.isArray(combinations[0])) combinations = combinations.map(item => [item]);
        matrixCard.classList.remove('hidden');
        combinations.forEach((combo, index) => {
            const comboString = combo.join(' / '); const uniqueHash = Math.random().toString(36).substring(2, 6).toUpperCase();
            const generatedSkuSafe = `${brandName.substring(0, 3).toUpperCase()}-${baseName.substring(0, 3).toUpperCase()}-${combo.join('-').replace(/\s+/g, '').toUpperCase()}-${uniqueHash}`;
            let sizeValue = 'Standard'; let colorValue = 'Standard';            
            combo.forEach((val, i) => { if (optionKeys[i] === 'Size') sizeValue = val; if (optionKeys[i] === 'Color') colorValue = val; });
            const tr = document.createElement('tr'); tr.className = "hover:bg-gray-50/50 transition";
            tr.innerHTML = `
                <td class="py-4 px-8 font-bold text-gray-900">
                    <span class="text-xs">${comboString}</span>
                    <input type="hidden" name="variants[${index}][name]" value="${comboString}">
                    <input type="hidden" name="variants[${index}][size]" value="${sizeValue}">
                    <input type="hidden" name="variants[${index}][color]" value="${colorValue}">
                </td>
                <td class="py-4 px-6">
                    <input type="text" name="variants[${index}][sku]" value="${generatedSkuSafe}" class="matrix-variant-sku w-full border border-gray-200 rounded-md px-3 py-2 font-mono text-[11px] uppercase bg-gray-50 focus:outline-none focus:border-gray-500 transition-colors">
                </td>
                <td class="py-4 px-6 text-right">
                    <div class="relative inline-block w-full">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold">₹</span>
                        <input type="number" name="variants[${index}][price]" min="0" placeholder="0" class="matrix-variant-price w-full border border-gray-200 rounded-md pl-7 pr-3 py-2 text-right font-semibold text-gray-900 bg-gray-50 focus:outline-none focus:border-gray-500 transition-colors">
                    </div>
                </td>
                <td class="py-4 px-8 text-center">
                    <input type="number" name="variants[${index}][stock]" min="0" placeholder="0" value="0" class="matrix-variant-stock w-full border border-gray-200 rounded-md px-3 py-2 text-center font-bold bg-gray-50 focus:outline-none focus:border-gray-500 transition-colors">
                </td>
            `;        
            tableBody.appendChild(tr);
        });
    }

    function toggleModalVisibility(modalId, contentId, shouldShow) {
        const modal = document.getElementById(modalId); const content = document.getElementById(contentId);
        if(shouldShow) {
            modal.classList.remove('hidden'); setTimeout(() => { modal.classList.remove('opacity-0'); content.classList.remove('scale-95'); }, 10);
        } else {
            modal.classList.add('opacity-0'); content.classList.add('scale-95'); setTimeout(() => { modal.classList.add('hidden'); }, 200);
        }
    }

    document.getElementById('baseName').addEventListener('input', generateCombinationsMatrix);
    document.getElementById('brandName').addEventListener('input', generateCombinationsMatrix);

    const processedFilesArray = []; const dataTransfer = new DataTransfer(); 

    function handleFileSelect(event) {
        const files = Array.from(event.target.files);
        if (!files.length) return;
        files.forEach(file => { if (file.type.startsWith('image/')) processedFilesArray.push(file); });
        updateFormFileInput(); renderPreviews(); event.target.value = ''; 
    }

    function updateFormFileInput() {
        dataTransfer.items.clear(); processedFilesArray.forEach(file => dataTransfer.items.add(file));
        document.getElementById('finalFormFileInput').files = dataTransfer.files;
        if (processedFilesArray.length >= 3) document.getElementById('imageCountError').classList.add('hidden');
    }

    function renderPreviews() {
        const grid = document.getElementById('imagePreviewGrid'); grid.innerHTML = '';
        processedFilesArray.forEach((file, index) => {
            const url = URL.createObjectURL(file); const card = document.createElement('div');
            card.className = "relative group bg-gray-100 rounded-xl overflow-hidden border border-gray-200 aspect-3/4 flex items-center justify-center shadow-xs";
            card.innerHTML = `
                <img src="${url}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2 backdrop-blur-xs">
                    <button type="button" onclick="openCropper(${index})" class="w-9 h-9 flex items-center justify-center bg-white text-gray-800 rounded-lg shadow hover:bg-gray-100 text-xs font-bold cursor-pointer transition-transform hover:scale-105"><i class="fas fa-crop-alt"></i></button>
                    <button type="button" onclick="removeImage(${index})" class="w-9 h-9 flex items-center justify-center bg-red-600 text-white rounded-lg shadow hover:bg-red-700 text-xs font-bold cursor-pointer transition-transform hover:scale-105"><i class="fas fa-trash"></i></button>
                </div>
                <span class="absolute bottom-2 left-2 bg-black/70 text-white text-[9px] font-bold px-2 py-0.5 rounded shadow">#${index + 1}</span>
            `;
            grid.appendChild(card);
        });
    }

    function removeImage(index) { processedFilesArray.splice(index, 1); updateFormFileInput(); renderPreviews(); }

    function openCropper(index) {
        const originalFile = processedFilesArray[index];    
        window.ImageCropper.openCropper({
            file: originalFile, aspectRatio: NaN,
            onCrop: (blob, newUrl) => {
                processedFilesArray[index] = new File([blob], originalFile.name, { type: 'image/jpeg', lastModified: Date.now() });
                updateFormFileInput(); renderPreviews();
            }
        });
    }

    document.getElementById('productForm').addEventListener('submit', function(event) {
        let isValid = true;
        document.querySelectorAll('.inline-error').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.border-red-500').forEach(el => el.classList.remove('border-red-500', 'bg-red-50'));
        
        function fireError(elementId, errorText) {
            const inputField = document.getElementById(elementId); const errorElement = document.getElementById(elementId + 'Error');
            if (inputField && errorElement) {
                inputField.classList.add('border-red-500'); errorElement.innerText = errorText;
                errorElement.classList.remove('hidden'); isValid = false;
            }
        }

        if (!document.getElementById('baseName').value.trim()) fireError('baseName', 'Product name is mandatory.');
        if (!document.getElementById('brandName').value.trim()) fireError('brandName', 'Brand name is mandatory.');
        if (!document.getElementById('parentCategory').value) fireError('parentCategory', 'Please select a Target Gender.');
        if (!document.getElementById('subCategory').value) fireError('subCategory', 'Please assign a Sub-Category.');
        if (!document.getElementById('description').value.trim()) fireError('description', 'Rich description is mandatory.');
        
        if (typeof processedFilesArray !== 'undefined' && processedFilesArray.length < 3) {
            const errorBox = document.getElementById('imageCountError');
            if (errorBox) errorBox.classList.remove('hidden');
            isValid = false;
        }

        const matrixBody = document.getElementById('matrixTableBody');
        const rows = matrixBody ? matrixBody.querySelectorAll('tr') : [];
        const matrixGlobalErr = document.getElementById('matrixGlobalError');        
        
        if (rows.length === 0) {
            if (matrixGlobalErr) {
                matrixGlobalErr.innerHTML = '<i class="fas fa-exclamation-circle mr-2 text-lg"></i> Validation Error: At least one variant must be created.';
                matrixGlobalErr.classList.remove('hidden');
            }
            isValid = false;
        } else {
            rows.forEach(tr => {
                const priceInput = tr.querySelector('.matrix-variant-price');
                const stockInput = tr.querySelector('.matrix-variant-stock');
                const skuInput = tr.querySelector('.matrix-variant-sku');

                if (!skuInput || !skuInput.value.trim()) { if (skuInput) skuInput.classList.add('border-red-500', 'bg-red-50'); isValid = false; }
                if (!priceInput || priceInput.value === '' || parseFloat(priceInput.value) < 0) { if (priceInput) priceInput.classList.add('border-red-500', 'bg-red-50'); isValid = false; }
                if (!stockInput || stockInput.value === '' || parseInt(stockInput.value) < 0) { if (stockInput) stockInput.classList.add('border-red-500', 'bg-red-50'); isValid = false; }
            });

            if (!isValid && matrixGlobalErr) {
                matrixGlobalErr.innerHTML = '<i class="fas fa-exclamation-circle mr-2 text-lg"></i> Validation Error: Please fill in valid SKUs, prices, and stock.';
                matrixGlobalErr.classList.remove('hidden');
            }
        }

        if (!isValid) {
            event.preventDefault(); 
            const firstError = document.querySelector('.border-red-500, .inline-error:not(.hidden)');
            if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });
</script>