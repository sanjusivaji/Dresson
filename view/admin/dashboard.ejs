<%- contentFor('body') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- The wrapping container matching the white aesthetic of the design -->
<div class="w-full bg-white min-h-screen p-6 md:p-10 font-sans">
    
    <!-- 4 Stats Cards -->
    <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="border border-gray-200 rounded-2xl p-6 text-center shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h3 class="text-[11px] text-gray-400 font-bold mb-2">Total Sales</h3>
            <p class="text-2xl font-black text-black">₹<%= stats.totalSales.toLocaleString('en-IN') %></p>
        </div>
        <div class="border border-gray-200 rounded-2xl p-6 text-center shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h3 class="text-[11px] text-gray-400 font-bold mb-2">Total Orders</h3>
            <p class="text-2xl font-black text-black"><%= stats.totalOrders %></p>
        </div>
        <div class="border border-gray-200 rounded-2xl p-6 text-center shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h3 class="text-[11px] text-gray-400 font-bold mb-2">Active Orders</h3>
            <p class="text-2xl font-black text-black"><%= stats.activeOrders %></p>
        </div>
        <div class="border border-gray-200 rounded-2xl p-6 text-center shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h3 class="text-[11px] text-gray-400 font-bold mb-2">New Users</h3>
            <p class="text-2xl font-black text-black"><%= stats.newUsers %></p>
        </div>
    </div>

    <!-- Filter Dropdown (Placed just above Sales Performance) -->
    <div class="flex justify-end mb-3">
        <select onchange="window.location.href='?filter=' + this.value" class="border border-gray-300 text-gray-700 text-xs font-bold px-4 py-2 rounded-lg focus:outline-none cursor-pointer shadow-sm bg-white">
            <option value="daily" <%= currentFilter === 'daily' ? 'selected' : '' %>>Daily</option>
            <option value="7days" <%= currentFilter === '7days' ? 'selected' : '' %>>Last 7 Days</option>
            <option value="monthly" <%= currentFilter === 'monthly' ? 'selected' : '' %>>Monthly</option>
            <option value="yearly" <%= currentFilter === 'yearly' ? 'selected' : '' %>>Yearly</option>
        </select>
    </div>

    <!-- Sales Performance Line Chart -->
    <div class="border border-gray-200 rounded-2xl p-6 mb-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h2 class="text-sm font-bold text-black">Sales Performance</h2>
                <p class="text-[10px] text-gray-400 mt-0.5 font-medium">
                    <% if(currentFilter === 'daily') { %>Today's Data<% } else if(currentFilter === '7days') { %>Last 7 Days<% } else if(currentFilter === 'monthly') { %>This Month<% } else { %>Historical Data<% } %>
                </p>
            </div>
            <span class="text-sm font-black text-black">₹<%= totalChartRevenue.toLocaleString('en-IN') %></span>
        </div>
        <div class="h-72 relative w-full">
            <canvas id="salesPerformanceChart"></canvas>
        </div>
    </div>

    <!-- Top Selling Brands & Categories (Side-by-Side) -->
    <div class="grid grid-cols-2 gap-6 mb-6">
        <!-- Brands -->
        <div class="border border-gray-200 rounded-2xl p-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h2 class="text-sm font-bold text-black mb-6">Top Selling Brands</h2>
            <div class="space-y-4">
                <% brands.forEach(brand => { %>
                    <div class="flex items-center gap-4">
                        <span class="w-1/4 text-xs font-medium text-gray-600 truncate"><%= brand.name %></span>
                        <div class="w-3/4">
                            <div class="bg-[#8b85ff] h-3.5 rounded-full" style="width: <%= brand.percentage %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Categories -->
        <div class="border border-gray-200 rounded-2xl p-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
            <h2 class="text-sm font-bold text-black mb-6">Top Selling Categories</h2>
            <div class="space-y-4">
                <% categories.forEach(cat => { %>
                    <div class="flex items-center gap-4">
                        <span class="w-1/4 text-xs font-medium text-gray-600 truncate"><%= cat.name %></span>
                        <div class="w-3/4">
                            <div class="bg-[#8b85ff] h-3.5 rounded-full" style="width: <%= cat.percentage %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- Bottom Product Table -->
    <div class="border border-gray-200 rounded-2xl overflow-hidden mb-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="border-b border-gray-200">
                    <tr>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Product Image</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Product Name</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Category</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Price</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Quantity</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Total Revenue</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800">Stock remaining</th>
                        <th class="py-4 px-6 text-[11px] font-bold text-gray-800 whitespace-nowrap">Last Sold Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(prod => { %>
                            <tr class="hover:bg-gray-50/50 transition">
                                <td class="py-3 px-6">
                                    <img src="<%= prod.image %>" alt="Product" class="w-9 h-12 object-cover rounded shadow-sm border border-gray-200">
                                </td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600"><%= prod.name %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600"><%= prod.category %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600">₹<%= prod.price.toLocaleString('en-IN') %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600"><%= prod.sold %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600">₹<%= prod.revenue.toLocaleString('en-IN') %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-600"><%= prod.stock %></td>
                                <td class="py-3 px-6 text-[11px] font-medium text-gray-400 whitespace-nowrap">
                                    <%= String(new Date(prod.date).getDate()).padStart(2, '0') %>-<%= String(new Date(prod.date).getMonth() + 1).padStart(2, '0') %>-<%= new Date(prod.date).getFullYear() %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="8" class="text-center py-8 text-xs text-gray-500 font-medium">No product data available yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    const ctx = document.getElementById('salesPerformanceChart').getContext('2d');
    
    // Safely inject dynamic data from the backend
    const dynamicLabels = <%- JSON.stringify(chartLabels || []) %>;
    const dynamicData = <%- JSON.stringify(chartData || []) %>;
    
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: dynamicLabels.length > 0 ? dynamicLabels : ['No Data'],
            datasets: [{
                label: 'Revenue Trend',
                data: dynamicData.length > 0 ? dynamicData : [0],
                borderColor: '#8b85ff', // Violet line matching your Figma styling
                backgroundColor: 'rgba(139, 133, 255, 0.15)', // Soft violet fill underneath
                borderWidth: 3,
                tension: 0.4, // Creates the smooth, sweeping curves
                fill: true, // Enables the shaded area
                pointBackgroundColor: '#8b85ff',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4, // Makes the dots visible
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#f3f4f6', drawBorder: false },
                    ticks: {
                        color: '#9ca3af',
                        font: { size: 10, family: 'sans-serif' },
                        callback: function(value) { return '₹' + value.toLocaleString('en-IN'); }
                    },
                    border: { display: false }
                },
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: { 
                        color: '#9ca3af', 
                        font: { size: 10, family: 'sans-serif' }
                    },
                    border: { display: false }
                }
            } 
        }
    });
</script>