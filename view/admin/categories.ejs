
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-black tracking-tight">Categories</h1>
        <p class="text-xs text-gray-400 mt-1">Manage your clothing hierarchy across Men, Women, and Kids collections.</p>
    </div>
    
    <!-- For 'Search' and 'Add Categories' button -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">        
        <form action="/admin/categories" method="GET" class="w-full sm:w-auto m-0">            
            <!-- Outer container for 'Search Box' and 'Clear Button' -->
            <div class="flex items-center gap-2">
                <div class="relative w-full sm:w-64">
                    <input type="text" name="search" 
                        name="search" 
                        placeholder="Search..." 
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                        class="w-full pl-4 pr-10 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-[#6b66d6] focus:ring-1 focus:ring-[#6b66d6] bg-gray-50/50 shadow-sm transition font-medium text-gray-800"
                    >
                    <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#6b66d6] cursor-pointer flex items-center justify-center p-1 transition-colors">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <!-- For 'Clear Button'(ie 'X')-->
                <% if (typeof searchQuery !== 'undefined' && searchQuery.trim() !== '') { %>
                    <a href="/admin/categories" 
                    class="flex items-center justify-center w-9 h-9 text-gray-400 hover:text-red-500 bg-white hover:bg-red-50 border border-gray-200 hover:border-red-200 rounded-lg transition-colors shadow-sm" 
                    title="Clear Search">
                        <i class="fas fa-times text-sm"></i>
                    </a>
                <% } %>                
            </div>
        </form>

        <a href="/admin/category/add" class="px-5 py-2.5 bg-[#6b66d6] hover:bg-[#5752b5] text-white text-xs font-bold rounded-lg shadow-md transition flex items-center justify-center space-x-2 w-full sm:w-auto whitespace-nowrap cursor-pointer">
            <i class="fas fa-plus"></i>
            <span>Add Categories</span>
        </a>
    </div>
</div>

<%- include('../partial/shared/alertError') %>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-gray-400 text-[11px] uppercase tracking-wider font-bold">
                <th class="py-3.5 px-6">Category Name </th>
                <th class="py-3.5 px-6">Gender</th>
                <th class="py-3.5 px-6">Description</th>
                <th class="py-3.5 px-6">Status</th>
                <th class="py-3.5 px-6 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                    <tr class="hover:bg-gray-50/50 transition">
                        
                        <!-- BREADCRUMB TRAIL WITH LEVEL BADGES -->
                        <td class="py-4 px-6 font-mono">
                            <% if (cat.lineage && cat.lineage.length > 1) { %>
                                <!-- Nested Sub-Category Breadcrumb Trail -->
                                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                                    <% cat.lineage.forEach((item, index) => { %>
                                        <% if (index === cat.lineage.length - 1) { %>
                                            <!-- Current Target Category (Bold & Highlighted in Purple) -->
                                            <span class="font-bold text-gray-900 bg-purple-50 text-[#6b66d6] border border-purple-200 px-2.5 py-1 rounded-md shadow-2xs">
                                                <%= item %> <span class="text-[10px] text-purple-400 font-normal ml-0.5">(Level <%= index + 1 %>)</span>
                                            </span>
                                        <% } else { %>
                                            <!-- Parent / Ancestor Categories (Gray Badges) -->
                                            <span class="text-gray-600 font-medium bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md">
                                                <%= item %> 
                                                <% if (index === 0) { %>
                                                    <span class="text-[9px] text-gray-400 uppercase tracking-wider ml-0.5">(Root)</span>
                                                <% } else { %>
                                                    <span class="text-[9px] text-gray-400 ml-0.5">(Lvl <%= index + 1 %>)</span>
                                                <% } %>
                                            </span>
                                            <!-- Right Arrow Separator -->
                                            <i class="fas fa-chevron-right text-[9px] text-gray-300"></i>
                                        <% } %>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <!-- Root Category Display (Level 1) -->
                                <span class="font-bold text-sm text-gray-900 bg-gray-100 border border-gray-300 px-3 py-1 rounded-md inline-flex items-center gap-1.5">
                                    <%= cat.categoryName || cat.displayName %> 
                                    <span class="text-[10px] text-gray-500 font-normal uppercase tracking-wider bg-white px-1.5 py-0.5 rounded border border-gray-200">(Root / Level 1)</span>
                                </span>
                            <% } %>
                        </td>

                        <!-- GENDER COLUMN -->
                        <td class="py-4 px-6 text-xs font-semibold text-gray-600">
                            <span class="px-2.5 py-1 rounded-md bg-gray-100 border border-gray-200">
                                <%= cat.gender %>
                            </span>
                        </td>

                        <!-- DESCRIPTION COLUMN -->
                        <td class="py-4 px-6 text-xs text-gray-500 max-w-xs truncate">
                            <%= cat.description || 'No description provided.' %>
                        </td>

                        <!-- STATUS COLUMN (Read-Only Badge) -->
                        <td class="py-4 px-6 text-xs">
                            <% if (cat.isListed) { %>
                                <span class="text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full font-bold">Listed</span>
                            <% } else { %>
                                <span class="text-red-700 bg-red-50 border border-red-200 px-2.5 py-1 rounded-full font-bold">Unlisted</span>
                            <% } %>
                        </td>
                        
                        <!-- ACTION BUTTONS COLUMN -->
                        <td class="py-4 px-6 text-right">
                            <div class="flex items-center justify-end space-x-2">
                                
                                <!-- Toggle button -->
                              <form action="/admin/category/toggle/<%= cat._id %>?page=<%= currentPage %>" method="POST" class="m-0 p-0">
                                    <button type="submit" 
                                            class="px-2.5 py-2 rounded-lg text-xs font-bold transition cursor-pointer flex items-center space-x-1
                                            <%= cat.isListed ? 'bg-orange-100 text-orange-600 hover:bg-orange-200' : 'bg-green-100 text-green-600 hover:bg-green-200' %>"
                                            title="<%= cat.isListed ? 'Unlist Category' : 'List Category' %>">
                                        <i class="fas <%= cat.isListed ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                                        <span><%= cat.isListed ? 'Unlist' : 'List' %></span>
                                    </button>
                                </form>

                                <!-- Edit Button -->
                                <a href="/admin/category/edit/<%= cat._id %>" class="p-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg text-xs font-bold transition" title="Edit Category">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- Custom Delete Button -->
                                <button type="button" 
                                        onclick="triggerCategoryDelete('<%= cat._id %>', '<%= cat.categoryName %>')" 
                                        class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-lg text-xs font-bold transition cursor-pointer"
                                        title="Delete Category">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>

                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="py-8 text-center text-gray-400 text-sm font-medium">
                        No categories found. Click "Add New Category" to get started!
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../partial/shared/warning') %>
<form id="deleteForm" method="POST" action="" class="hidden"></form>
<%- include('../partial/admin/pagination', { baseUrl: '/admin/categories', currentPage: currentPage, totalPages: totalPages }) %>

<script>
    function triggerCategoryDelete(categoryId, categoryName) {
        const message = `Are you sure you want to delete "${categoryName}"? This action cannot be undone and may affect sub-categories nested beneath it.`;
        
        showCustomConfirm(
            message, 
            function() {
                // Execute when user clicks "Yes, Continue" inside the custom modal
                const form = document.getElementById('deleteForm');
                form.action = `/admin/category/delete/${categoryId}`;
                form.submit();
            }, 
            "Delete Category?"
        );
    }
</script>

<!-- Automatically pop up the custom UI modal if a backend warning occurred -->
<% const activeWarning = (typeof error !== 'undefined' && error) ? error : ((typeof errorMessage !== 'undefined' && errorMessage) ? errorMessage : null); %>
<% if (activeWarning) { %>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Triggers your custom popup overlay automatically on reload!
            if (typeof showCustomAlert === "function") {
                showCustomAlert("<%= activeWarning %>", "Action Blocked", "error");
            }
        });
    </script>
<% } %>