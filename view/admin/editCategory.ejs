<div class="flex justify-between items-center mb-8 max-w-xl">
    <div>
        <h1 class="text-3xl font-bold text-black tracking-tight">Edit Category</h1>
        <p class="text-xs text-gray-400 mt-1">Modify structural configuration properties, target scope alignments, and listing details.</p>
    </div>
    <a href="/admin/categories" class="px-4 py-2 border border-gray-300 bg-white text-gray-700 text-xs font-bold rounded-md hover:bg-gray-50 transition shadow-sm">
        Back To Category
    </a>
</div>

<!-- Integrated Custom Error Partial for backend validation errors -->
<%- include('../partial/shared/alertError') %>

<!-- Integrated Universal Warning & Confirm Modal -->
<%- include('../partial/shared/warning') %>

<!-- Form uses 'novalidate' to trigger custom UI modals instead of browser bubbles -->
<form action="/admin/category/edit/<%= category._id %>" method="POST" id="editCategoryForm" novalidate class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 max-w-xl">
    <div class="space-y-6">
        
        <!-- Base Category Scope (Gender) -->
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Base Category Scope (Gender)</label>
            <select name="gender" id="genderSelect" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition font-medium text-gray-800 cursor-pointer">
                <option value="Men" <%= category.gender === 'Men' ? 'selected' : '' %>>Men</option>
                <option value="Women" <%= category.gender === 'Women' ? 'selected' : '' %>>Women</option>
                <option value="Kids" <%= category.gender === 'Kids' ? 'selected' : '' %>>Kids</option>
            </select>
        </div>

        <!-- Infinite-Depth Parent Category Assignment (With Anti-Loop Protection) -->
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Parent Category Assignment</label>
            <select name="parentCategory" id="parentCategorySelect" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 bg-white shadow-sm transition font-medium text-gray-800 cursor-pointer">
                <option value="none" <%= !category.parentCategory ? 'selected' : '' %>>None (Set as a Root Category - e.g., Topwear, Bottomwear)</option>
                <% if (typeof mainCategories !== 'undefined' && mainCategories.length > 0) { %>
                    <% mainCategories.forEach(cat => { %>
                        <!-- CRITICAL SAFETY LOCK: Prevent category from selecting ITSELF as parent! -->
                        <% if (cat._id.toString() !== category._id.toString()) { %>
                            <option value="<%= cat._id %>" 
                                    data-gender="<%= cat.gender %>"
                                    data-depth="<%= cat.depth || 1 %>"
                                    <%= (category.parentCategory && category.parentCategory.toString() === cat._id.toString()) ? 'selected' : '' %>
                                    class="hidden font-mono">
                                <%= cat.displayName || cat.categoryName %> (Level <%= cat.depth || 1 %>)
                            </option>
                        <% } %>
                    <% }) %>
                <% } %>
            </select>
            <span class="text-[11px] text-gray-400 mt-1.5">Select any folder in your tree to nest this category under—there are no depth limits! Note: The current category is hidden from this list to prevent circular database loops.</span>
        </div>

        <!-- Category Name -->
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Category Name</label>
            <input type="text" name="categoryName" id="categoryNameInput" value="<%= category.categoryName %>" 
                   class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 shadow-sm transition font-medium">
        </div>

        <!-- Slug (Auto-Compiled & Read-Only) -->
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Slug</label>
            <input type="text" name="slug" id="slugInput" value="<%= category.slug %>" readonly
                   class="border border-gray-200 bg-gray-100 rounded-lg px-4 py-2.5 text-sm font-mono text-gray-500 focus:outline-none cursor-not-allowed select-none shadow-inner">
            <span class="text-[10px] text-gray-400 mt-1">System-managed structural tracking link optimized for routing patterns.</span>
        </div>

        <!-- Category Description -->
        <div class="flex flex-col">
            <label class="text-xs font-bold text-black mb-2 uppercase tracking-wider">Category Description</label>
            <textarea name="description" id="categoryDescription" rows="3" 
                      class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 shadow-sm transition resize-none font-medium"><%= category.description %></textarea>
        </div>

        <!-- Visibility Status Display -->
        <div class="flex items-center space-x-3 pt-2">
            <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded-md <%= category.isListed ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                <%= category.isListed ? 'Active / Listed' : 'Hidden / Unlisted' %>
            </span>
            <span class="text-[11px] text-gray-400">To adjust this visibility configuration state, use the quick toggle trigger buttons inside the master grid table.</span>
        </div>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-100 flex items-center space-x-3">
        <button type="submit" class="px-6 py-2.5 bg-[#8b3c3c] hover:bg-[#723131] text-white text-xs font-bold rounded-md shadow-md transition cursor-pointer">
            Update Category
        </button>
        <a href="/admin/categories" class="px-6 py-2.5 bg-black hover:bg-gray-900 text-white text-xs font-bold rounded-md text-center shadow-md transition">
            Cancel
        </a>
    </div>
</form>

<script>
    const genderSelect = document.getElementById('genderSelect');
    const parentCategorySelect = document.getElementById('parentCategorySelect');
    const parentOptions = parentCategorySelect.querySelectorAll('option');
    const categoryNameInput = document.getElementById('categoryNameInput');
    const slugInput = document.getElementById('slugInput');

    // 1. Dynamic Parent-Category Dropdown Filter (Matches Selected Gender)
    function filterParentOptions(selectedGender) {
        parentOptions.forEach(option => {
            if (option.value === "none") return;
            
            if (option.getAttribute('data-gender') === selectedGender) {
                option.classList.remove('hidden');
            } else {
                option.classList.add('hidden');
            }
        });
    }

    // Run immediately on page mount to filter appropriate options for the loaded category
    filterParentOptions(genderSelect.value);

    // Track user adjustments to the gender dropdown
    genderSelect.addEventListener('change', function() {
        parentCategorySelect.value = "none"; // Reset parent to None when switching genders
        filterParentOptions(this.value);
    });

    // 2. Realtime URL Slug Compiling Synchronizer Engine
    categoryNameInput.addEventListener('input', function() {
        const compiledSlug = this.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-') // Replaces spaces and symbols with single hyphens
            .replace(/(^-|-$)+/g, '');   // Removes leading or trailing hyphens
        slugInput.value = compiledSlug;
    });

    // 3. Custom Client-Side Form Validation using your Universal Modal!
    document.getElementById('editCategoryForm').addEventListener('submit', function(e) {
        const name = categoryNameInput.value.trim();
        const desc = document.getElementById('categoryDescription').value.trim();

        if (name.length < 2) {
            e.preventDefault();
            return showCustomAlert("Category Name must be at least 2 characters long.", "Invalid Input", "error");
        }

        if (desc.length < 10) {
            e.preventDefault();
            return showCustomAlert("Please provide a description of at least 10 characters.", "Invalid Input", "error");
        }
    });
</script>

<!-- Automatically pop up the custom UI modal if a backend warning occurred -->
<% const activeWarning = (typeof error !== 'undefined' && error) ? error : ((typeof errorMessage !== 'undefined' && errorMessage) ? errorMessage : null); %>
<% if (activeWarning) { %>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof showCustomAlert === "function") {
                showCustomAlert("<%= activeWarning %>", "Update Blocked", "error");
            }
        });
    </script>
<% } %>