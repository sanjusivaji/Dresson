<%- contentFor('body') %>

<main class="flex-1 bg-gray-50 p-8 flex justify-center items-start min-h-screen relative">
    
    <!-- Main Card Container -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 w-full max-w-2xl p-8 relative">
        
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">
                Return Request : <span class="text-gray-500"><%= returnId %></span>
            </h1>
            <a href="/admin/returns" class="px-5 py-2 text-xs font-bold text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 transition">
                Back To Return
            </a>
        </div>

        <!-- Metadata Section -->
        <div class="space-y-4 mb-8 text-[13px]">
            <div class="grid grid-cols-3">
                <span class="text-gray-600 font-medium">User Name</span>
                <span class="col-span-2 text-gray-900 font-semibold">: &nbsp; <%= order.shippingAddress.fullName %></span>
            </div>
            <div class="grid grid-cols-3">
                <span class="text-gray-600 font-medium">Requested Date</span>
                <span class="col-span-2 text-gray-900 font-semibold">: &nbsp; <%= requestedDate %></span>
            </div>
            <div class="grid grid-cols-3">
                <span class="text-gray-600 font-medium">Reason</span>
                <span class="col-span-2 text-gray-900 font-semibold">: &nbsp; <%= order.returnRequest.reason || 'Not specified' %></span>
            </div>
        </div>

        <!-- Product Details Section -->
        <div class="mb-10 space-y-6">
            <% order.items.forEach(item => { %>
                <% 
                    const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                    const productName = item.product.productName || item.product.name || 'Dresson Product';
                %>
                <div class="flex items-start space-x-6">
                    <img src="<%= item.product.images[0]?.url || '/images/default-product.jpg' %>" alt="Product" class="w-20 h-24 object-cover rounded border border-gray-100 shadow-sm">
                    <div class="text-[13px] space-y-1.5 text-gray-600 font-medium mt-1">
                        <h3 class="text-sm font-bold text-gray-900 mb-2"><%= productName %></h3>
                        <% if (variantParts.length > 0) { %>
                            <% variantParts.forEach(part => { %>
                                <p><%= part %></p>
                            <% }) %>
                        <% } %>
                        <p class="font-bold text-gray-900 mt-2">₹<%= item.price %></p>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Action Form -->
        <form id="process-return-form" action="/admin/returns/<%= order._id %>/process" method="POST">
            
            <!-- Hidden input to store which button was clicked -->
            <input type="hidden" name="action" id="form-action-input" value="">

            <div class="mb-8">
                <label for="adminMessage" class="block text-[13px] font-semibold text-gray-700 mb-2">
                    Message(mandatory)
                </label>
                <textarea 
                    name="adminMessage" 
                    id="adminMessage" 
                    rows="4" 
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-[#8a7aee] resize-none text-sm"
                ></textarea>
            </div>

            <div class="flex gap-4">
                <!-- Approve Button (Changed to type="button") -->
                <button 
                    type="button" 
                    onclick="handleProcess(event, 'Approve')"
                    class="px-6 py-2.5 bg-[#2ecc71] hover:bg-[#27ae60] text-white text-[13px] font-bold rounded shadow-sm transition"
                >
                    Approve Return
                </button>
                
                <!-- Reject Button (Changed to type="button") -->
                <button 
                    type="button" 
                    onclick="handleProcess(event, 'Reject')"
                    class="px-6 py-2.5 bg-[#e74c3c] hover:bg-[#c0392b] text-white text-[13px] font-bold rounded shadow-sm transition"
                >
                    Reject Return
                </button>
            </div>
            
        </form>

    </div>
</main>

<!-- Include your custom warning modal partial at the bottom -->
<%- include('../partial/shared/warning') %>

<script>
    function handleProcess(event, actionType) {
        event.preventDefault();
        
        const form = document.getElementById('process-return-form');
        const hiddenInput = document.getElementById('form-action-input');
        const messageInput = document.getElementById('adminMessage'); // Grab the textarea
        
        // 1. Check if the textarea is empty
        if (!messageInput.value.trim()) {
            // Replace native validation with YOUR custom alert!
            showCustomAlert('Please provide a mandatory message before processing the return.', 'Required Field', 'warning');
            return; // Stop here so it doesn't process the return yet
        }

        // 2. Customize the warning message based on the button clicked
        const modalTitle = `${actionType} Return?`;
        const modalMessage = actionType === 'Approve' 
            ? 'Are you sure you want to APPROVE this return? The refund process will be initiated.'
            : 'Are you sure you want to REJECT this return? The customer will be notified.';

        // 3. Show your custom confirm modal
        showCustomConfirm(
            modalMessage, 
            function() {
                // If the admin clicks "Yes, Continue" in your modal:
                hiddenInput.value = actionType; // Set the hidden input to "Approve" or "Reject"
                form.submit(); // Actually submit the form
            }, 
            modalTitle
        );
    }
</script>