<%- contentFor('body') %>

<main class="flex-1 bg-gray-50 p-8 flex justify-center items-start min-h-screen relative">
    
    <!-- Main Card Container -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 w-full max-w-2xl p-8 relative">
        
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">
                Return Request : <span class="text-gray-500"><%= returnId %></span>
            </h1>
            <a href="/admin/returns" class="px-5 py-2 text-xs font-bold text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 transition">
                Back To Return
            </a>
        </div>

        <!-- Metadata Section -->
        <div class="space-y-4 mb-8 text-[13px]">
            <div class="grid grid-cols-3">
                <span class="text-gray-600 font-medium">User Name</span>
                <span class="col-span-2 text-gray-900 font-semibold">: &nbsp; <%= order.shippingAddress.fullName %></span>
            </div>
            <div class="grid grid-cols-3">
                <span class="text-gray-600 font-medium">Requested Date</span>
                <span class="col-span-2 text-gray-900 font-semibold">: &nbsp; <%= requestedDate %></span>
            </div>
            
        </div>

        <!-- Product Details Section -->
        <div class="mb-10 space-y-6">
            <% order.items.forEach(item => { %>
                <!-- Hides items that are not being returned, so the screen only shows relevant return items -->
                <% 
                    if (['Return Pending', 'Returned', 'Return Rejected'].includes(item.itemStatus) || (order.returnRequest && order.returnRequest.isRequested)) {
                        const variantParts = item.variantName ? item.variantName.split(' / ') : [];
                        const productName = item.product.productName || item.product.name || 'Dresson Product';
                %>
                <div class="flex items-start space-x-6 border-b border-gray-100 pb-6 last:border-0">
                    <img src="<%= item.product.images && item.product.images[0] ? item.product.images[0].url : '/images/default-product.jpg' %>" alt="Product" class="w-20 h-24 object-cover rounded border border-gray-100 shadow-sm">
                    <div class="text-[13px] space-y-1.5 text-gray-600 font-medium mt-1 w-full">
                        <div class="flex justify-between items-start">
                            <h3 class="text-sm font-bold text-gray-900 mb-1"><%= productName %></h3>
                            
                            <!-- Current Item Status Badge -->
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider whitespace-nowrap
                                <%= item.itemStatus === 'Returned' ? 'bg-purple-100 text-purple-700' : 
                                    item.itemStatus === 'Return Pending' ? 'bg-yellow-100 text-yellow-700 animate-pulse' : 
                                    item.itemStatus === 'Return Rejected' ? 'bg-orange-100 text-orange-800' :
                                    'bg-gray-100 text-gray-700' %>">
                                <%= item.itemStatus %>
                            </span>
                        </div>

                        <% if (variantParts.length > 0) { %>
                            <p class="text-gray-500"><%= variantParts.join(' / ') %></p>
                        <% } %>
                        <p class="font-bold text-gray-900 mt-2">₹<%= item.price %></p>

                        <!-- Item-Specific Return Info Box -->
                        <div class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded-md space-y-2">
                            <div class="grid grid-cols-12 gap-2">
                                <span class="col-span-3 text-gray-500 font-semibold text-xs uppercase tracking-wide">Reason</span>
                                <span class="col-span-9 text-gray-800"><%= item.returnReason || 'Not specified' %></span>
                            </div>
                            
                            <% if (item.adminMessage) { %>
                                <div class="grid grid-cols-12 gap-2 border-t border-gray-200 pt-2 mt-2">
                                    <span class="col-span-3 text-gray-500 font-semibold text-xs uppercase tracking-wide">Admin Note</span>
                                    <span class="col-span-9 text-gray-800 italic">"<%= item.adminMessage %>"</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>
            <% }) %>
        </div>

        <!-- Action Form -->
        <form id="process-return-form" action="/admin/returns/<%= order._id %>/process" method="POST">
            
            <!-- Hidden input to store which button was clicked -->
            <input type="hidden" name="action" id="form-action-input" value="">

            <div class="mb-8">
                <label for="adminMessage" class="block text-[13px] font-semibold text-gray-700 mb-2">
                    Message (mandatory)
                </label>
                <textarea 
                    name="adminMessage" 
                    id="adminMessage" 
                    rows="4" 
                    required
                    placeholder="Enter the reason for approval or rejection..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-[#8a7aee] resize-none text-sm"
                ></textarea>
            </div>

            <div class="flex gap-4">
                <!-- Approve Button -->
                <button 
                    type="button" 
                    onclick="handleProcess(event, 'Approve')"
                    class="px-6 py-2.5 bg-[#2ecc71] hover:bg-[#27ae60] text-white text-[13px] font-bold rounded shadow-sm transition"
                >
                    Approve Return
                </button>
                
                <!-- Reject Button -->
                <button 
                    type="button" 
                    onclick="handleProcess(event, 'Reject')"
                    class="px-6 py-2.5 bg-[#e74c3c] hover:bg-[#c0392b] text-white text-[13px] font-bold rounded shadow-sm transition"
                >
                    Reject Return
                </button>
            </div>
            
        </form>

    </div>
</main>

<!-- Include your custom warning modal partial at the bottom -->
<%- include('../partial/shared/warning') %>

<script>
    // Handles the approval or rejection of a return request
    function handleProcess(event, actionType) {
        event.preventDefault();                                                                        // Stops the form from submitting immediately
        const form = document.getElementById('process-return-form');                                   // Gets the form element
        const hiddenInput = document.getElementById('form-action-input');                              // Gets the hidden input to store the action
        const messageInput = document.getElementById('adminMessage');                                  // Gets the admin's note text box
        if (!messageInput.value.trim()) {
            showCustomAlert('Please provide a mandatory message before processing the return.', 'Required Field', 'warning'); // Shows an alert if message is empty
            return;                                                                                    // Stops the function if no message is provided
        }
        const modalTitle = `${actionType} Return?`;                                                    // Creates the title for the popup
        const modalMessage = actionType === 'Approve' ? 'Are you sure you want to APPROVE this return? The refund process will be initiated.' : 'Are you sure you want to REJECT this return? The customer will be notified.'; // Sets popup message based on action
        showCustomConfirm(modalMessage, function() { hiddenInput.value = actionType; form.submit(); }, modalTitle); // Shows confirmation popup and submits form if user agrees
    }
</script>