<%- contentFor('body') %>

<div class="w-full max-w-5xl bg-white p-8 md:p-10 rounded-xl shadow-md font-sans">
    
    <!-- Header -->
    <div class="flex justify-between items-start mb-10 pb-6 border-b border-gray-100">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
                Order Details #<%= order.orderId %>
            </h1>
            <p class="text-sm text-gray-500 font-medium mt-2">
                <%= formattedDate %> <span class="capitalize ml-2 px-3 py-1 bg-gray-100 rounded-full text-gray-700 text-xs"><%= order.deliveryStatus %></span>
            </p>
        </div>
        <a href="/admin/orders" class="px-5 py-2.5 text-xs font-bold text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition">
            <i class="fas fa-arrow-left mr-2 text-gray-400"></i> Back To Order
        </a>
    </div>

    <!-- Order Info Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-y-8 gap-x-8 mb-12 text-sm bg-gray-50 p-6 rounded-lg border border-gray-100">
        <div>
            <p class="text-gray-400 font-semibold mb-1">Order ID</p>
            <p class="font-bold text-gray-800">#<%= order.orderId %></p>
        </div>
        <div>
            <p class="text-gray-400 font-semibold mb-1">Customer</p>
            <p class="font-bold text-gray-800"><%= order.shippingAddress.fullName %></p>
        </div>
        <div>
            <p class="text-gray-400 font-semibold mb-1">Payment Method</p>
            <p class="font-bold text-gray-800"><%= order.paymentMethod %></p>
        </div>
        <div>
            <p class="text-gray-400 font-semibold mb-1">Delivery Address</p>
            <p class="font-bold text-gray-800"><%= order.shippingAddress.addressLine %></p>
        </div>
        <div>
            <p class="text-gray-400 font-semibold mb-1">City / State</p>
            <p class="font-bold text-gray-800"><%= order.shippingAddress.city %> / <%= order.shippingAddress.state %></p>
        </div>
        <div>
            <p class="text-gray-400 font-semibold mb-1">Post</p>
            <p class="font-bold text-gray-800"><%= order.shippingAddress.pincode %></p>
        </div>
    </div>

    <!-- Product Table -->
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-16 shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Product</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Category</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">Quantity</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Price</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">Item Status</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <!-- Calculates the total money before shipping and discounts by multiplying item price by amount -->
                    <% 
                        let calculatedSubtotal = 0;
                        order.items.forEach(item => { 
                            calculatedSubtotal += (item.price * item.quantity);
                    %>
                        <tr class="bg-white hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-4">
                                    <img src="<%= item.product?.images?.[0]?.url || item.product?.images?.[0] || '/images/default-product.jpg' %>" alt="Product" class="w-12 h-16 object-cover rounded shadow-sm border border-gray-100">
                                    <div>
                                        <p class="text-sm font-bold text-gray-800"><%= item.product?.name || 'Product' %></p>
                                        <p class="text-xs text-gray-500"><%= item.variantName || item.variantSku %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-5 pr-4 align-middle font-medium text-gray-700">
                                <%= (item.product && item.product.subCategory && item.product.subCategory.categoryName) 
                                    ? item.product.subCategory.categoryName 
                                    : 'Uncategorized' %>
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold text-gray-700 text-center bg-gray-50/50">
                                <%= item.quantity %>
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold text-gray-700">
                                ₹<%= item.price %>
                            </td>
                            <!-- Added Item Status Badge -->
                            <td class="px-6 py-4 text-center">
                                <% 
                                    let badgeColor = 'bg-gray-100 text-gray-700';
                                    if (item.itemStatus === 'Cancelled') badgeColor = 'bg-red-100 text-red-700';
                                    else if (item.itemStatus === 'Return Pending') badgeColor = 'bg-amber-100 text-amber-700';
                                    else if (item.itemStatus === 'Returned') badgeColor = 'bg-purple-100 text-purple-700';
                                    else if (item.itemStatus === 'Active') badgeColor = 'bg-green-100 text-green-700';
                                %>
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= badgeColor %>">
                                    <%= item.itemStatus || 'Active' %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm font-bold text-gray-900 bg-gray-50/50 text-right">
                                ₹<%= item.price * item.quantity %>
                            </td>
                        </tr>
                    <% }) %>

                    <!-- Summary Financial Breakdown Rows -->
                    <tr class="bg-white border-t border-gray-200">
                        <td colspan="5" class="px-6 py-3 text-right font-medium text-gray-500 text-sm">Shipping:</td>
                        <td class="px-6 py-3 text-sm font-bold text-gray-700 text-right">
                            <%- calculatedSubtotal >= 1500 ? '<span class="text-green-600">Free</span>' : '₹150' %>
                        </td>
                    </tr>
                    <% if (order.discountAmount > 0) { %>
                    <tr class="bg-white">
                        <td colspan="5" class="px-6 py-3 text-right font-medium text-gray-500 text-sm">Coupon Discount:</td>
                        <td class="px-6 py-3 text-sm font-bold text-red-500 text-right">-₹<%= Math.round(order.discountAmount) %></td>
                    </tr>
                    <% } %>
                    <tr class="bg-gray-50/80 border-t border-gray-200">
                        <td colspan="5" class="px-6 py-4 text-right font-bold text-gray-800 text-base">Grand Total:</td>
                        <td class="px-6 py-4 text-lg font-black text-gray-900 text-right">₹<%= Math.round(order.totalAmount) %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Status Timeline & Actions -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8 mt-10 p-6 bg-gray-50 rounded-lg border border-gray-100">

        <!-- Timeline -->
        <div class="ml-4 mt-2">
            <ol class="relative border-l-2 border-green-200">                  
                <!-- Loops through the possible order steps to show a green dot if the order has reached that stage, or grey if not -->
                <% const statuses = ['Pending', 'Processing', 'Shipped', 'Out of Delivery', 'Delivered']; %>
                <% const currentStatusIndex = statuses.indexOf(order.deliveryStatus); %>
                <% statuses.forEach((status, index) => { %>
                    <li class="mb-6 ml-8 last:mb-0">
                        <% if (index <= currentStatusIndex) { %>
                            <div class="absolute w-3 h-3 rounded-full mt-1.5 -left-[7px] ring-4 ring-gray-50 bg-green-500"></div>
                        <% } else { %>
                            <div class="absolute w-3 h-3 rounded-full mt-1.5 -left-[7px] ring-4 ring-gray-50 bg-gray-300"></div>
                        <% } %>
                        
                        <div>
                            <h4 class="text-sm font-bold text-gray-800"><%= status %></h4>
                            <% if (index <= currentStatusIndex) { %>
                                <p class="text-[11px] font-medium text-gray-400 mt-0.5"><%= formattedDate %> &nbsp; 9 am</p>
                            <% } %>
                        </div>
                    </li>
                <% }) %>
            </ol>
        </div>

        <!-- Action Buttons (Right Side) -->
        <div class="flex flex-col items-end gap-4 shrink-0 w-full md:w-auto">
            <form action="/admin/orders/<%= order._id %>/status" method="POST" class="flex flex-col sm:flex-row gap-3 items-center w-full">
                <select name="status" class="px-4 py-2.5 w-full sm:w-auto border border-gray-300 text-sm font-semibold text-gray-700 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-400 shadow-sm">
                    <option value="Pending" <%= order.deliveryStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Processing" <%= order.deliveryStatus === 'Processing' ? 'selected' : '' %>>Processing</option>
                    <option value="Shipped" <%= order.deliveryStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="Out of Delivery" <%= order.deliveryStatus === 'Out of Delivery' ? 'selected' : '' %>>Out of Delivery</option>
                    <option value="Delivered" <%= order.deliveryStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                </select>

                <button type="submit" class="px-6 py-2.5 w-full sm:w-auto bg-[#a35e6c] hover:bg-[#8b4e5a] text-white text-xs font-bold rounded-lg shadow-sm transition">
                    Save Changes
                </button>
            </form>

            <button class="px-6 py-2 w-full sm:w-auto bg-black hover:bg-gray-800 text-white text-xs font-bold rounded-lg shadow-md transition">
                Cancel Order
            </button>
        </div>
    </div>
</div>