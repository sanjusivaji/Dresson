<%- contentFor('body') %>

<!-- Increased max-w-xl to max-w-2xl to accommodate the new 2-column grid -->
<div class="px-6 py-8 w-full max-w-2xl mx-auto bg-white min-h-screen">
    <!-- Header -->
    <div class="flex justify-between items-start mb-8 border-b border-gray-100 pb-5">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight">Edit Coupon</h1>
            <p class="text-xs text-gray-500 font-medium mt-1">Update the rules for this promotional code</p>
        </div>
        <a href="/admin/coupons" class="border border-gray-300 bg-white hover:bg-gray-50 text-gray-800 text-xs font-bold py-2 px-4 rounded-md transition shadow-sm flex items-center space-x-2">
            <i class="fas fa-arrow-left text-[10px]"></i>
            <span>Back</span>
        </a>
    </div>

    <% if (error) { %>
        <div class="bg-red-50 text-red-600 text-xs font-bold p-3 rounded-md mb-6 border border-red-100 flex items-center space-x-2">
            <i class="fas fa-exclamation-circle"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <form id="editCouponForm" action="/admin/coupons/edit/<%= formData._id %>" method="POST">
        
        <!-- Grid Container for Form Fields -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
            
            <!-- Row 1: Names and Codes -->
            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Coupon Name</label>
                <input type="text" id="couponName" name="couponName" value="<%= formData.couponName %>" placeholder="e.g. Summer Sale" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition">
                <p id="error-couponName" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>
            
            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Coupon Code</label>
                <input type="text" id="couponCode" name="couponCode" value="<%= formData.couponCode %>" placeholder="e.g. SUMMER20" style="text-transform:uppercase" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition font-mono font-bold tracking-wider text-red-600">
                <p id="error-couponCode" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Row 2: Discount Details -->
            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Discount Type</label>
                <select id="discountType" name="discountType" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full bg-white transition cursor-pointer">
                    <option value="percentage" <%= formData.discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                    <option value="flat" <%= formData.discountType === 'flat' ? 'selected' : '' %>>Flat Amount (₹)</option>
                </select>
            </div>

            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Discount Value</label>
                <input type="number" id="discountValue" name="discountValue" value="<%= formData.discountValue %>" min="1" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition">
                <p id="error-discountValue" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Row 3: Validity Dates -->
            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Valid From</label>
                <input type="date" id="validFrom" name="validFrom" value="<%= formData.validFrom %>" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition cursor-text">
                <p id="error-validFrom" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Valid Till</label>
                <input type="date" id="validTill" name="validTill" value="<%= formData.validTill %>" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition cursor-text">
                <p id="error-validTill" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Row 4: Constraints -->
            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Minimum Cart Amount (₹)</label>
                <input type="number" id="minCartValue" name="minCartValue" value="<%= formData.minCartValue %>" min="0" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition">
                <p id="error-minCartValue" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <div class="flex flex-col">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Maximum Discount (₹)</label>
                <input type="number" id="maxDiscount" name="maxDiscount" value="<%= formData.maxDiscount || '' %>" min="0" placeholder="Leave blank for no limit" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition">
                <p id="error-maxDiscount" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Row 5: Usage Limit (Spans both columns) -->
            <div class="flex flex-col md:col-span-2 p-4 bg-gray-50 border border-gray-100 rounded-lg mt-2">
                <label class="text-[11px] font-extrabold text-gray-800 mb-1.5">Max Uses Per User</label>
                <input type="number" id="usageLimitPerUser" name="usageLimitPerUser" value="<%= formData.usageLimitPerUser || 1 %>" min="1" class="border border-gray-300 rounded-md px-3 py-2 text-xs focus:ring-1 focus:ring-gray-900 outline-none w-full transition bg-white">
                <p id="error-usageLimitPerUser" class="text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                <span class="text-[10px] font-semibold text-gray-500 mt-1.5"><i class="fas fa-info-circle mr-1"></i>How many times can a single customer use this exact promo code?</span>
            </div>

        </div>

        <!-- Footer Actions with Toggle -->
        <div class="pt-6 mt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between space-y-4 sm:space-y-0">
            <div class="flex items-center space-x-3 bg-gray-50 px-4 py-2 rounded-md border border-gray-200">
                <span class="text-xs font-bold text-gray-800">Coupon Status</span>
                <!-- Custom Toggle Switch -->
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="isActive" class="sr-only peer" <%= formData.isActive ? 'checked' : '' %>>
                    <div class="w-9 h-5 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-500"></div>
                </label>
            </div>

            <div class="flex space-x-3 w-full sm:w-auto">
                <a href="/admin/coupons" class="w-full sm:w-auto text-center px-6 py-2.5 bg-gray-100 text-gray-800 border border-gray-300 text-xs font-bold rounded-md hover:bg-gray-200 transition">Cancel</a>
                <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-[#b3404a] text-white text-xs font-bold rounded-md hover:bg-red-800 transition shadow-md hover:shadow-lg">
                    <i class="fas fa-save mr-1.5"></i> Update Coupon
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('editCouponForm');

        form.addEventListener('submit', (e) => {
            let isValid = true;

            // Helper function to show errors
            const showError = (inputId, message) => {
                const errorEl = document.getElementById(`error-${inputId}`);
                const inputEl = document.getElementById(inputId);
                
                errorEl.innerText = message;
                errorEl.classList.remove('hidden');
                
                // Highlight the input border in red
                inputEl.classList.remove('border-gray-300', 'focus:ring-gray-900');
                inputEl.classList.add('border-red-500', 'focus:ring-red-500');
                
                isValid = false;
            };

            // Helper function to reset all errors before checking again
            const resetErrors = () => {
                document.querySelectorAll('p[id^="error-"]').forEach(el => el.classList.add('hidden'));
                document.querySelectorAll('input, select').forEach(el => {
                    el.classList.remove('border-red-500', 'focus:ring-red-500');
                    el.classList.add('border-gray-300', 'focus:ring-gray-900');
                });
            };

            resetErrors();

            //  Coupon Name Validation
            const name = document.getElementById('couponName').value.trim();
            if (!name) showError('couponName', 'Coupon name is required.');

            // Coupon Code Validation (No spaces allowed)
            const code = document.getElementById('couponCode').value.trim();
            if (!code) {
                showError('couponCode', 'Coupon code is required.');
            } else if (/\s/.test(code)) {
                showError('couponCode', 'Coupon code cannot contain spaces.');
            }

            //  Discount Value & Type Logic
            const type = document.getElementById('discountType').value;
            const discount = parseFloat(document.getElementById('discountValue').value);
            
            if (isNaN(discount) || discount <= 0) {
                showError('discountValue', 'Enter a valid discount greater than 0.');
            } else if (type === 'percentage' && discount > 100) {
                showError('discountValue', 'Percentage cannot exceed 100%.');
            }

            //  Date Validations (End date must be after Start date)
            const fromDateStr = document.getElementById('validFrom').value;
            const tillDateStr = document.getElementById('validTill').value;
            
            if (!fromDateStr) showError('validFrom', 'Start date is required.');
            if (!tillDateStr) showError('validTill', 'End date is required.');
            
            if (fromDateStr && tillDateStr) {
                const fromDate = new Date(fromDateStr);
                const tillDate = new Date(tillDateStr);
                
                // Reset time to midnight for accurate day-to-day comparison
                fromDate.setHours(0, 0, 0, 0);
                tillDate.setHours(0, 0, 0, 0);

                if (tillDate <= fromDate) {
                    showError('validTill', 'End date must be strictly after the start date.');
                }
            }

            //  Cart Constraints
            const minCart = parseFloat(document.getElementById('minCartValue').value);
            if (isNaN(minCart) || minCart < 0) {
                showError('minCartValue', 'Minimum cart value cannot be negative.');
            }

            const maxDiscStr = document.getElementById('maxDiscount').value;
            if (maxDiscStr !== '') {
                const maxDisc = parseFloat(maxDiscStr);
                if (maxDisc <= 0) showError('maxDiscount', 'Max discount must be greater than 0.');
            }

            // 6. Usage Limit
            const limit = parseInt(document.getElementById('usageLimitPerUser').value);
            if (isNaN(limit) || limit < 1) {
                showError('usageLimitPerUser', 'Usage limit must be at least 1.');
            }

            // Prevent submission if any validation failed
            if (!isValid) {
                e.preventDefault();
            }
        });
    });
</script>